<Application x:Class="QuanLyHangHoa.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:QuanLyHangHoa.Converters"
             StartupUri="Views/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- DESIGN SYSTEM TOKENS (Indigo/White Modern) -->
            <Color x:Key="PrimaryIndigo">#4F46E5</Color>
            <Color x:Key="PrimaryIndigoLight">#EEF2FF</Color>
            <Color x:Key="BodyBg">#F8FAFC</Color>
            <Color x:Key="SidebarBg">#FFFFFF</Color>
            <Color x:Key="SidebarActive">#F1F5F9</Color>
            <Color x:Key="AppBorder">#E2E8F0</Color>
            <Color x:Key="TextPrimary">#0F172A</Color>
            <Color x:Key="TextSecondary">#64748B</Color>

            <SolidColorBrush x:Key="PrimaryIndigoBrush" Color="{StaticResource PrimaryIndigo}" />
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource PrimaryIndigoLight}" />
            <SolidColorBrush x:Key="BodyBgBrush" Color="{StaticResource BodyBg}" />
            <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}" />
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActive}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />

            <!-- CONVERTERS -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

            <!-- DATA GRID STYLES -->
            <!-- Base Element Style - Based on the BUILT-IN MaterialDesignDataGridTextColumnStyle -->
            <Style x:Key="MaterialDesignDataGridTextColumnElementStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- Center Aligned Element Style -->
            <Style x:Key="MaterialDesignDataGridTextColumnCenterElementStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <!-- Right Aligned Element Style (for Currency/Numbers) -->
            <Style x:Key="MaterialDesignDataGridTextColumnRightElementStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="TextAlignment" Value="Right"/>
            </Style>

            <!-- Editing Element Style - Missing resource fix -->
            <Style x:Key="MaterialDesignDataGridTextColumnEditingElementStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignDataGridTextBoxExtensions}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- GLOBAL THEME OVERRIDES -->
            <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="UniformCornerRadius" Value="12"/>
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            </Style>

            <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="RowHeight" Value="48"/>
                <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="12 8 12 8"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AppBorderBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
