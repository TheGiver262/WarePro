<UserControl x:Class="QuanLyHangHoa.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- tiêu đề -->
        <Border Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Update" Width="32" Height="32"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource AppTertiaryBrush}"/>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="CẬP NHẬT WAREPRO" Style="{StaticResource TypographyH1}"/>
                    <TextBlock Text="Kiểm tra và cài bản vá hoặc tính năng mới"
                               Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- thông tin bản cập nhật -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="32"
                             MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Phiên bản hiện tại" Style="{StaticResource TypographyCaption}" Margin="0,0,24,8"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Text="Phiên bản mới" Style="{StaticResource TypographyCaption}" Margin="0,0,24,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvailableVersion}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Text="Dung lượng" Style="{StaticResource TypographyCaption}" Margin="0,0,24,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DownloadSizeText}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Text="Trạng thái" Style="{StaticResource TypographyCaption}" Margin="0,0,24,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold"/>
                </Grid>

                <Border Height="1" Background="{StaticResource AppBorderBrush}" Margin="0,0,0,20"/>

                <TextBlock Text="Nội dung bản cập nhật" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" MaxHeight="180"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ErrorAction}" TextWrapping="Wrap"
                           Foreground="{StaticResource AppTertiaryBrush}" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding CheckForUpdatesCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="180" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="KIỂM TRA CẬP NHẬT" Style="{StaticResource TypographyButtonText}"/>
                    </Button>
                    <Button Command="{Binding DownloadAndInstallCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="180" Height="36">
                        <TextBlock Text="TẢI VÀ CÀI ĐẶT" Style="{StaticResource TypographyButtonText}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
