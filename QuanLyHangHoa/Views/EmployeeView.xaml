<UserControl x:Class="QuanLyHangHoa.Views.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800" Background="White">
    
    <UserControl.DataContext>
        <vm:EmployeeViewModel />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ĐIỀU HÀNH NHÂN SỰ &amp; QUẢN TRỊ TÀI KHOẢN APP" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#C0392B"/>
        
        <!-- Khu nhập thông tin -->
        <Border Grid.Row="0" Margin="0,0,0,20" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15" Background="#FDEDEC">
            <WrapPanel>
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="250" Margin="10" 
                         materialDesign:HintAssist.Hint="Tên Lót Và Tên Chữ (User Full Name)"
                         Text="{Binding CurrentInputEmployee.FullName}"/>
                         
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="150" Margin="10" 
                         materialDesign:HintAssist.Hint="Chức Vụ Chuyên Môn"
                         Text="{Binding CurrentInputEmployee.Position}"/>
                         
                <!-- Chọn Sinh nhật, UI DateTimePicker cực ngon của Material Design -->
                <DatePicker Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="150" Margin="10"
                            materialDesign:HintAssist.Hint="Ngày Tháng Năm Sinh"
                            SelectedDate="{Binding CurrentInputEmployee.DateOfBirth}" />

                <Separator Style="{StaticResource MaterialDesignDarkSeparator}" Margin="10,5" Width="800"/>

                <!-- Phần Nhập Username / Quyền để đăng nhập bảo mật -->
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="200" Margin="10" 
                         materialDesign:HintAssist.Hint="Username đăng nhập hệ thống"
                         Text="{Binding CurrentInputEmployee.Username}"/>
                         
                <!-- Demo WPF binding mật khẩu nhanh chóng -->
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="200" Margin="10" 
                         materialDesign:HintAssist.Hint="Mật khẩu (Khởi tạo)"
                         Text="{Binding CurrentInputEmployee.PasswordHash}"/>

                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" Width="150" Margin="10"
                          materialDesign:HintAssist.Hint="Phân Cấp Quyền"
                          Text="{Binding CurrentInputEmployee.Role}">
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Staff"/>
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- Thanh nút công cụ Control Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,20">
            <!-- Nút Save bao trọn gói Add hoặc Update -->
            <Button Content="PHÊ DUYỆT BỔ NHIỆM" Command="{Binding SaveEmployeeCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#C0392B" BorderBrush="#C0392B" Width="200" Margin="0,0,10,0"/>
            <Button Content="LÀM TRỐNG LỆNH" Command="{Binding ClearInputCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="150" Margin="0,0,10,0"/>
            
            <Button Content="IMPORT EMPLOYEE" Command="{Binding ImportDataCommand}" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="#607D8B" BorderBrush="#607D8B" Width="180" Margin="0,0,10,0"/>

            <!-- Nút sa thải, đỏ như máu -->
            <Button Content="KHÓA TÀI KHOẢN KẺ NÀY" Command="{Binding DeleteEmployeeCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Background="#F9EBEA" BorderBrush="Red" Foreground="Red" Width="200"/>
        </StackPanel>

        <!-- Bảng Danh sách toàn văn -->
        <DataGrid Grid.Row="2" Margin="10,0,10,0" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="UserID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Danh Tính Thật" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Tuổi Đời" Binding="{Binding DateOfBirth, StringFormat='dd/MM/yyyy'}" />
                <DataGridTextColumn Header="Vị Trí Cấp Bậc" Binding="{Binding Position}" />
                <DataGridTextColumn Header="Bí Danh Truy Cập" Binding="{Binding Username}" FontWeight="Bold" Foreground="Blue"/>
                <DataGridTextColumn Header="Quyền Lực" Binding="{Binding Role}" Foreground="Purple" FontWeight="ExtraBold" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
