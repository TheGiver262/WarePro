<UserControl x:Class="QuanLyHangHoa.Views.StockReversalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="History" Width="28" Height="28" Foreground="{StaticResource PrimaryIndigoBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="ĐẢO CHỨNG TỪ KHO" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <materialDesign:Card Grid.Row="1" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="24" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             materialDesign:HintAssist.Hint="Mã chứng từ (DocumentId) cần đảo" Margin="0,0,20,0"
                             Text="{Binding DocumentIdText, UpdateSourceTrigger=PropertyChanged}" FontSize="15"/>

                    <TextBox Grid.Column="1" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             materialDesign:HintAssist.Hint="Lý do đảo chứng từ" Margin="0,0,20,0"
                             Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" FontSize="15"/>

                    <Button Grid.Column="2" Content="ĐẢO CHỨNG TỪ" Command="{Binding ReverseDocumentCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#EF4444" BorderBrush="#EF4444"
                            Height="48" Padding="24,0" materialDesign:ButtonAssist.CornerRadius="12" VerticalAlignment="Bottom"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="24" Background="#FFF5F5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C53030" VerticalAlignment="Center"/>
                        <TextBlock Text="LƯU Ý QUAN TRỌNG" FontWeight="Bold" FontSize="16" Foreground="#C53030" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Chức năng này sẽ tạo các bản ghi điều chỉnh (Adjustment) đảo chiều toàn bộ giao dịch của chứng từ đã chọn và cập nhật ngay lập tức vào tồn kho thực tế." 
                               Foreground="#742A2A" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="14" LineHeight="22"/>
                    
                    <Border Background="#FED7D7" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="• Chỉ hỗ trợ đảo chứng từ của một kho duy nhất." Foreground="#742A2A" Margin="0,0,0,8"/>
                            <TextBlock Text="• Hãy tra cứu kỹ Mã chứng từ trong mục 'Truy vấn Kho' trước khi thực hiện." Foreground="#742A2A"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="3" Margin="0,24,0,0" UniformCornerRadius="8" Padding="12" Background="{StaticResource PrimaryHueLightBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource PrimaryIndigoBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryIndigoBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
