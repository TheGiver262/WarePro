<UserControl x:Class="QuanLyHangHoa.Views.StockReversalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <materialDesign:Card Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="ĐẢO CHỨNG TỪ KHO" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Alert" Foreground="{StaticResource AppErrorBrush}" VerticalAlignment="Center" Margin="{StaticResource Margin.Right.sm}"/>
                        <TextBlock Text="Cần thận trọng" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppErrorBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Action Card -->
            <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                              materialDesign:HintAssist.Hint="Mã chứng từ (DocumentId) cần đảo" Margin="{StaticResource Margin.Right.md}"
                              Text="{Binding DocumentIdText, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                              materialDesign:HintAssist.Hint="Lý do đảo chứng từ" Margin="{StaticResource Margin.Right.md}"
                              Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="2" Content="ĐẢO CHỨNG TỪ" Command="{Binding ReverseDocumentCommand}" 
                            Style="{StaticResource AppPrimaryButton}" Background="{StaticResource AppErrorBrush}" BorderBrush="{StaticResource AppErrorBrush}"
                            Height="48" Padding="24,0" VerticalAlignment="Bottom"/>
                </Grid>
            </materialDesign:Card>

            <!-- Notice Card -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.md}">
                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="{StaticResource AppErrorBrush}" VerticalAlignment="Center" Width="24" Height="24"/>
                        <TextBlock Text="LƯU Ý QUAN TRỌNG" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppErrorBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Chức năng này sẽ tạo các bản ghi điều chỉnh (Adjustment) đảo chiều toàn bộ giao dịch của chứng từ đã chọn và cập nhật ngay lập tức vào tồn kho thực tế." 
                               Style="{StaticResource TypographyBody}" Foreground="{StaticResource AppPrimaryBrush}" TextWrapping="Wrap" Margin="{StaticResource Margin.Bottom.md}"/>
                    
                    <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="{StaticResource Spacing.md}" CornerRadius="{StaticResource Radius.md}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.sm}">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center" Margin="{StaticResource Margin.Right.sm}"/>
                                <TextBlock Text="Chỉ hỗ trợ đảo chứng từ của một kho duy nhất." Style="{StaticResource TypographyBody}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center" Margin="{StaticResource Margin.Right.sm}"/>
                                <TextBlock Text="Hãy tra cứu kỹ Mã chứng từ trong mục 'Truy vấn Kho' trước khi thực hiện." Style="{StaticResource TypographyBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- Status Banner -->
            <materialDesign:Card Grid.Row="3" Margin="{StaticResource Margin.Top.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}" Background="{StaticResource AppBackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppTertiaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
