<UserControl x:Class="QuanLyHangHoa.Views.StockReversalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dao chung tu kho" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="DocumentId ledger can dao" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DocumentIdText, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Ly do" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Dao chung tu" Command="{Binding ReverseDocumentCommand}" Background="#EF4444" Foreground="White" Padding="18,10" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="8" Padding="18">
            <StackPanel>
                <TextBlock Text="Tac dong" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Chuc nang nay tao adjustment dao chieu toan bo ledger cua DocumentId va post ngay vao ton kho." Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Chi ho tro document mot kho. Hay tra DocumentId tren man Audit Kho truoc khi dao." Foreground="#FCA5A5" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
