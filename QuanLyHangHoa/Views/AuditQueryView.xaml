<UserControl x:Class="QuanLyHangHoa.Views.AuditQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Toolbar -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,24" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="History" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                    <TextBlock Text="{Binding ReportTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Audit Logs DataGrid (70%) -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,20,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Padding="20,16" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                            <TextBlock Text="NHẬT KÝ HỆ THỐNG" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                               Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="100"/>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding OccurredAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
                            <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="*"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="80"/>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductId}" Width="100"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat='N0'}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Chứng từ" Binding="{Binding DocumentId}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Query Filters (30%) -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="24" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <materialDesign:PackIcon Kind="FilterVariant" Foreground="{StaticResource PrimaryIndigoBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="BỘ LỌC TRUY VẤN" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Lọc theo sản phẩm" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding AvailableProducts}"
                              SelectedItem="{Binding SelectedProduct}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                              materialDesign:HintAssist.Hint="Chọn sản phẩm"
                              Margin="0,0,0,16" FontSize="14"/>
                    
                    <Button Content="XEM LỊCH SỬ SP" Command="{Binding LoadProductLedgerCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PrimaryIndigoBrush}" BorderBrush="{StaticResource PrimaryIndigoBrush}" materialDesign:ButtonAssist.CornerRadius="8" Height="40" Margin="0,0,0,24"/>

                    <Separator Margin="0,0,0,24" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="Lọc theo mã chứng từ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Nhập DocumentId" 
                             Text="{Binding DocumentIdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" FontSize="14"/>

                    <Button Content="XEM TIMELINE" Command="{Binding LoadDocumentTimelineCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#10B981" BorderBrush="#10B981" materialDesign:ButtonAssist.CornerRadius="8" Height="40"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Grid>
</UserControl>

