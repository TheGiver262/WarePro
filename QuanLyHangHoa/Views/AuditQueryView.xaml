<UserControl x:Class="QuanLyHangHoa.Views.AuditQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <!-- Row 0: Header Section -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Search & Filter Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Main Content Card -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="History" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="NHẬT KÝ HỆ THỐNG" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="Truy vấn lịch sử biến động kho và nhật ký giao dịch" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Style="{StaticResource TypographyCaption}" Opacity="0.6" FontStyle="Italic"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Bar (Unified Standard) -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Background="{StaticResource SurfaceMutedBrush}" Margin="0,0,0,24" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.5"/>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 materialDesign:HintAssist.Hint="Tìm kiếm theo mã chứng từ..." FontSize="14" Background="Transparent"
                                 Margin="12,0" Text="{Binding DocumentIdText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadDocumentTimelineCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                    <Button Grid.Column="1" Content="TRUY VẤN" Command="{Binding LoadDocumentTimelineCommand}" Style="{StaticResource AppPrimaryButton}" Height="40" Padding="24,0"/>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Main Content Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Audit Logs DataGrid -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,24,0" Style="{StaticResource AppCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Padding="16,12" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}" Width="18" Height="18"/>
                                <TextBlock Text="DANH SÁCH NHẬT KÝ" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  RowHeight="54" BorderThickness="0" Background="Transparent"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource AppBorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="LOẠI" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="THỜI GIAN" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OccurredAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="HÀNH ĐỘNG" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Action}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="NGƯỜI DÙNG" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UserId}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Header="SỐ LƯỢNG" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Quantity, StringFormat='N0'}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource AppTertiaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Header="CHỨNG TỪ" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DocumentId}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource AppPrimaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- Query Filters Sidebar -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Background="{StaticResource SurfaceMutedBrush}" Padding="24" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <materialDesign:PackIcon Kind="FilterVariant" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="BỘ LỌC CHI TIẾT" Style="{StaticResource TypographyLabel}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="SẢN PHẨM" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableProducts}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  materialDesign:HintAssist.Hint="Chọn sản phẩm"
                                  Margin="0,0,0,16" Height="42"/>
                        
                        <Button Content="TRUY VẤN LỊCH SỬ SP" Command="{Binding LoadProductLedgerCommand}" 
                                Style="{StaticResource AppPrimaryButton}" Margin="0,0,0,24" Height="42"/>

                        <Separator Margin="0,0,0,24" Background="{StaticResource AppBorderBrush}"/>

                        <TextBlock Text="MÃ CHỨNG TỪ" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" materialDesign:HintAssist.Hint="Nhập DocumentId" 
                                 Text="{Binding DocumentIdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Height="42"/>

                        <Button Content="XEM DÒNG THỜI GIAN" Command="{Binding LoadDocumentTimelineCommand}" 
                                Style="{StaticResource AppSecondaryButton}" Height="42"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>


