<UserControl x:Class="QuanLyHangHoa.Views.AuditQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}" MaxWidth="1600" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!-- Row 0: Header Section -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Search & Filter Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Main Content Card -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="History" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="TRUY VẤN NHẬT KÝ" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="Truy vấn lịch sử biến động kho và nhật ký giao dịch" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Style="{StaticResource TypographyCaption}" Opacity="0.6" FontStyle="Italic"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Bar (Unified Standard) -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Margin="{StaticResource Margin.Bottom.md}" Padding="16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="20" Height="40" Padding="16,0" Width="360">
                        <Grid>
                            <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Search" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding DocumentIdText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Tìm kiếm theo mã chứng từ..."
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     Style="{StaticResource InputText}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoadDocumentTimelineCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Button Command="{Binding LoadDocumentTimelineCommand}" Style="{StaticResource ProMaxIconButtonStyle}" Width="40" Height="40" Margin="12,0,0,0" ToolTip="Truy vấn">
                        <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- Row 2: Main Content Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Audit Logs DataGrid -->
                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.lg}" Style="{StaticResource AppCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  RowHeight="54" BorderThickness="0" Background="Transparent"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource AppBorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="100" SortMemberPath="Kind">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                            <TextBlock Text="LOẠI" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="150" SortMemberPath="OccurredAt">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                            <TextBlock Text="THỜI GIAN" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OccurredAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" SortMemberPath="Action">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                            <TextBlock Text="HÀNH ĐỘNG" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Action}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" SortMemberPath="UserId">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                            <TextBlock Text="NGƯỜI DÙNG" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UserId}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Width="100" SortMemberPath="Quantity">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                            <TextBlock Text="SỐ LƯỢNG" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Quantity, StringFormat='N0'}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource AppTertiaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Width="180" SortMemberPath="DocumentId">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                            <TextBlock Text="CHỨNG TỪ" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DocumentId}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource AppPrimaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- Query Filters Sidebar -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.lg}">
                            <materialDesign:PackIcon Kind="FilterVariant" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center" Width="20" Height="20"/>
                            <TextBlock Text="BỘ LỌC CHI TIẾT" Style="{StaticResource TypographyLabel}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="SẢN PHẨM" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" Margin="{StaticResource Margin.Bottom.sm}"/>
                        <ComboBox ItemsSource="{Binding AvailableProducts}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  materialDesign:HintAssist.Hint="Chọn sản phẩm"
                                  Margin="{StaticResource Margin.Bottom.md}" Height="40"/>
                        
                        <Button Command="{Binding LoadProductLedgerCommand}" 
                                Style="{StaticResource PrimaryButton}" Margin="{StaticResource Margin.Bottom.lg}" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="TRUY VẤN LỊCH SỬ SP" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="{StaticResource Margin.Bottom.lg}" Background="{StaticResource AppBorderBrush}"/>

                        <TextBlock Text="MÃ CHỨNG TỪ" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" Margin="{StaticResource Margin.Bottom.sm}"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" materialDesign:HintAssist.Hint="Nhập DocumentId" 
                                 Text="{Binding DocumentIdText, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource Margin.Bottom.md}" Height="40" VerticalContentAlignment="Center"/>

                        <Button Command="{Binding LoadDocumentTimelineCommand}" 
                                Style="{StaticResource SecondaryButton}" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TimelineClockOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="XEM DÒNG THỜI GIAN" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
