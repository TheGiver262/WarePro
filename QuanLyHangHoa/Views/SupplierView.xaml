<UserControl x:Class="QuanLyHangHoa.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search -->
                <RowDefinition Height="*"/>    <!-- Table -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="TruckOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyH2}"/>
                        <TextBlock Text="Quản lý thông tin nhà cung cấp" Style="{StaticResource TypographyCaption}"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenAddSupplierDialogCommand}" Style="{StaticResource AppPrimaryButton}" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="THÊM MỚI" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}" Margin="{StaticResource Margin.Bottom.md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>       <!-- Mã NCC -->
                        <ColumnDefinition Width="*"/>         <!-- Tên NCC -->
                        <ColumnDefinition Width="150"/>       <!-- Số điện thoại -->
                        <ColumnDefinition Width="200"/>       <!-- Email -->
                        <ColumnDefinition Width="160"/>       <!-- Trạng thái -->
                        <ColumnDefinition Width="Auto"/>      <!-- Nút hành động -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Code -->
                    <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="MÃ NHÀ CUNG CẤP" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <TextBox materialDesign:HintAssist.Hint="Mã..." 
                                 Height="32" VerticalContentAlignment="Center"
                                 Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Search Name -->
                    <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="TÊN NHÀ CUNG CẤP" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <TextBox materialDesign:HintAssist.Hint="Nhập tên nhà cung cấp..." 
                                 Height="32" VerticalContentAlignment="Center"
                                 Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Search Phone -->
                    <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="SỐ ĐIỆN THOẠI" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <TextBox materialDesign:HintAssist.Hint="Tìm theo SĐT..." 
                                 Height="32" VerticalContentAlignment="Center"
                                 Text="{Binding SearchPhone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Email Search -->
                    <StackPanel Grid.Column="3" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="EMAIL" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <TextBox materialDesign:HintAssist.Hint="Tìm theo email..." 
                                 Height="32" VerticalContentAlignment="Center"
                                 Text="{Binding SearchEmail, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="4" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <ComboBox Height="32" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SearchStatus, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource AppSecondaryButton}" 
                                Command="{Binding RefreshCommand}"
                                ToolTip="Làm mới bộ lọc"
                                Width="32" Height="32" Padding="0" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource AppPrimaryButton}" 
                                Command="{Binding ExportToExcelCommand}"
                                Height="32" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Data Table -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                               AlternationCount="10000" EnableRowVirtualization="False"
                               AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                               RowHeight="52">
                        <DataGrid.Columns>
                            <!-- Supplier Code Column -->
                            <DataGridTemplateColumn Width="115" SortMemberPath="SupplierCode">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="MÃ NCC" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SupplierCode}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" Foreground="{StaticResource AppPrimaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Display Name Column -->
                            <DataGridTemplateColumn Width="*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TÊN NHÀ CUNG CẤP" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="12,0" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Phone Column -->
                            <DataGridTemplateColumn Width="150" SortMemberPath="Phone">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="ĐIỆN THOẠI" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Phone}" VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Email Column -->
                            <DataGridTemplateColumn Width="190" SortMemberPath="Email">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="EMAIL" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Email}" VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Status Column -->
                            <!-- Status Column -->
                            <DataGridTemplateColumn Width="130" SortMemberPath="IsActive"
                                                    CellTemplate="{StaticResource BooleanStatusBadgeTemplate}">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TRẠNG THÁI" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                            </DataGridTemplateColumn>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="120" Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" ToolTip="Chỉnh sửa"
                                                    Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" ToolTip="Xoá nhà cung cấp"
                                                    Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Hiện có {0} nhà cung cấp trong hệ thống">
                                    <Binding Path="Suppliers.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
