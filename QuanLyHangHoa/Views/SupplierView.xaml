<UserControl x:Class="QuanLyHangHoa.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.DataContext>
        <vm:SupplierViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header / Toolbar -->
            <materialDesign:Card Grid.Row="0" Margin="{StaticResource Margin.Bottom.lg}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.sm}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TruckDelivery" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyH2}" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.sm}" Foreground="{StaticResource AppPrimaryBrush}"/>
                        
                        <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" Margin="{StaticResource Margin.Left.lg}" Width="350" Height="40" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="{StaticResource Padding.sm}" Foreground="{StaticResource AppSecondaryBrush}"/>
                                <TextBox Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" 
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                         materialDesign:HintAssist.Hint="Tìm kiếm nhà cung cấp..." 
                                         FontSize="14" Background="Transparent"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="THÊM MỚI" Command="{Binding ClearInputCommand}" 
                                Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Right.sm}"/>
                        <Button Content="NHẬP EXCEL" Command="{Binding ImportDataCommand}" 
                                Style="{StaticResource AppSecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Data Table -->
                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.lg}" Style="{StaticResource AppCard}" Padding="0">
                    <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                               AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                               BorderThickness="0" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ" Binding="{Binding Id}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                            <DataGridTextColumn Header="MÃ NCC" Binding="{Binding SupplierCode}" Width="Auto" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="NHÀ CUNG CẤP" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{StaticResource Spacing.sm}">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Phone}" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="Auto"/>
                            <DataGridTextColumn Header="ĐỊA CHỈ" Binding="{Binding Address}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- Edit Form -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.lg}">
                            <materialDesign:PackIcon Kind="Edit" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CHI TIẾT ĐỐI TÁC" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppPrimaryBrush}" Margin="{StaticResource Margin.Left.sm}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Mã nhà cung cấp" Margin="{StaticResource Margin.Bottom.md}" 
                                         Text="{Binding EditCode}"/>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Tên nhà cung cấp" Margin="{StaticResource Margin.Bottom.md}" 
                                         Text="{Binding EditName}"/>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Số điện thoại" Margin="{StaticResource Margin.Bottom.md}" 
                                         Text="{Binding EditPhone}"/>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Email liên hệ" Margin="{StaticResource Margin.Bottom.md}" 
                                         Text="{Binding EditEmail}"/>
                                
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Địa chỉ chi tiết" Height="100" 
                                         TextWrapping="Wrap" VerticalAlignment="Top" AcceptsReturn="True" 
                                         Text="{Binding EditAddress}" Margin="{StaticResource Margin.Bottom.md}" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="{StaticResource Margin.Top.lg}">
                            <Button Content="LƯU THAY ĐỔI" Command="{Binding SaveEditCommand}" 
                                    Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Bottom.sm}"/>
                            <Button Content="XOÁ ĐỐI TÁC" Command="{Binding DeleteCommand}" 
                                    Style="{StaticResource AppDangerButton}"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
