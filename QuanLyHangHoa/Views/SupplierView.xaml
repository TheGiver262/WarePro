<UserControl x:Class="QuanLyHangHoa.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Quản Lý Nhà Cung Cấp" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                      AutoGenerateColumns="False" CanUserAddRows="False" Background="#1F2937" Foreground="Black" RowBackground="#374151" AlternatingRowBackground="#1F2937">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tên NCC" Binding="{Binding Name}" Width="1.5*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="1*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="2*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="#1F2937" CornerRadius="8" Margin="20,0,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Tên NCC:" Foreground="White" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8" BorderThickness="0" Margin="0,0,0,10"/>
                    <TextBlock Text="Điện thoại:" Foreground="White" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8" BorderThickness="0" Margin="0,0,0,10"/>
                    <TextBlock Text="Địa chỉ:" Foreground="White" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8" BorderThickness="0" Margin="0,0,0,20"/>
                    <Button Content="Thêm Mới" Command="{Binding AddCommand}" Background="#10B981" Foreground="White" Padding="10" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand"/>
                    <Button Content="Lưu Thay Đổi" Command="{Binding SaveEditCommand}" Background="#3B82F6" Foreground="White" Padding="10" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand"/>
                    <Button Content="Import Data" Command="{Binding ImportDataCommand}" Background="#1F2937" Foreground="White" Padding="10" BorderThickness="1" BorderBrush="#3B82F6" Margin="0,0,0,10" Cursor="Hand"/>
                    <Button Content="Xoá" Command="{Binding DeleteCommand}" Background="#EF4444" Foreground="White" Padding="10" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
