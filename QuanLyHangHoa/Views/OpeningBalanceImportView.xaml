<UserControl x:Class="QuanLyHangHoa.Views.OpeningBalanceImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 1: Header -->
            <Border Grid.Row="0" Margin="{StaticResource Margin.Bottom.lg}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DatabaseImport" Width="28" Height="28" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="NHẬP TỒN ĐẦU KỲ" Style="{StaticResource TypographyH2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Row 2: File Selector Card -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="24" Margin="{StaticResource Margin.Bottom.lg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             materialDesign:HintAssist.Hint="Đường dẫn file CSV/Excel" Margin="0,0,20,0"
                             Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" FontSize="14" IsReadOnly="True"/>

                    <Button Grid.Column="1" Content="CHỌN FILE" Command="{Binding BrowseFileCommand}" 
                            Style="{StaticResource AppSecondaryButton}" Margin="0,0,12,0" VerticalAlignment="Bottom"/>

                    <Button Grid.Column="2" Content="IMPORT DỮ LIỆU" Command="{Binding ImportOpeningBalanceCommand}" 
                            Style="{StaticResource AppPrimaryButton}" VerticalAlignment="Bottom"/>
                </Grid>
            </materialDesign:Card>

            <!-- Row 3: Error List Card -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="DANH SÁCH LỖI IMPORT" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Errors}" AutoGenerateColumns="False" 
                               CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}" 
                               MaxHeight="400" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DÒNG" Binding="{Binding RowNumber}" Width="80" ElementStyle="{StaticResource TextCenterElementStyle}"/>
                            <DataGridTextColumn Header="DỮ LIỆU GỐC" Binding="{Binding Data}" Width="200"/>
                            <DataGridTextColumn Header="CHI TIẾT LỖI" Binding="{Binding ErrorMessage}" Width="*" ElementStyle="{StaticResource TextErrorElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Row 4: Status Footer -->
            <materialDesign:Card Grid.Row="3" Margin="{StaticResource Margin.Top.lg}" Style="{StaticResource AppCard}" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
