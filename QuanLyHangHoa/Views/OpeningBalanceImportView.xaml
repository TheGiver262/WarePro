<UserControl x:Class="QuanLyHangHoa.Views.OpeningBalanceImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">



    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: File Selector -->
                <RowDefinition Height="*"/>    <!-- Row 2: Error List -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseImport" Width="32" Height="32" 
                                               Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="NHẬP TỒN ĐẦU KỲ" Style="{StaticResource TypographyH1}" 
                                 Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Import dữ liệu tồn kho đầu kỳ từ file Excel hoặc CSV để khởi tạo hệ thống" 
                             Style="{StaticResource TypographyCaption}" Margin="48,4,0,0" 
                             Opacity="0.7"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: File Selector Card -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="24" 
                                Background="{StaticResource SurfaceMutedBrush}"
                                Margin="{StaticResource SectionBottomMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource AppTextBoxStyle}" 
                             materialDesign:HintAssist.Hint="Đường dẫn file CSV/Excel (.xlsx, .csv)" Margin="0,0,24,0"
                             Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" 
                             IsReadOnly="True" VerticalAlignment="Center" Height="44"/>

                    <Button Grid.Column="1" Command="{Binding BrowseFileCommand}" 
                            Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileSearch" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                            <TextBlock Text="CHỌN FILE" Style="{StaticResource TypographyButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding ImportOpeningBalanceCommand}" 
                            Style="{StaticResource PrimaryButton}" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Upload" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                            <TextBlock Text="IMPORT DỮ LIỆU" Style="{StaticResource TypographyButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Error List Card -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="20,16" Background="{StaticResource SurfaceMutedBrush}" 
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20" 
                                                   Foreground="{StaticResource AppErrorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="DANH SÁCH LỖI IMPORT" Style="{StaticResource TypographyH4}" 
                                     Foreground="{StaticResource AppPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Errors}" AutoGenerateColumns="False" 
                               CanUserAddRows="False" IsReadOnly="True"
                               RowHeight="54" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DÒNG" Binding="{Binding RowNumber}" Width="100" 
                                              ElementStyle="{DynamicResource AppDataGridTextCenter}"/>
                            
                            <DataGridTemplateColumn Header="DỮ LIỆU GỐC" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Data}" VerticalAlignment="Center" Margin="16,0" Opacity="0.7" FontStyle="Italic"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="CHI TIẾT LỖI" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Margin="16,0" Foreground="{StaticResource AppErrorBrush}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Status Footer -->
                    <Border Grid.Row="2" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Information" Width="18" Height="18"
                                                   Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" 
                                     Foreground="{StaticResource AppSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
