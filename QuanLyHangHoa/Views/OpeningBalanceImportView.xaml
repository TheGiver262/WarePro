<UserControl x:Class="QuanLyHangHoa.Views.OpeningBalanceImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Nhap ton dau ky"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="File CSV/Excel" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                             Background="#374151"
                             Foreground="White"
                             Padding="8"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Chon file"
                        Command="{Binding BrowseFileCommand}"
                        Background="#4B5563"
                        Foreground="White"
                        Padding="18,10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        VerticalAlignment="Bottom"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="2"
                        Content="Import"
                        Command="{Binding ImportOpeningBalanceCommand}"
                        Background="#10B981"
                        Foreground="White"
                        Padding="18,10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Loi import"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Errors}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="#111827"
                          Foreground="White"
                          RowBackground="#1F2937"
                          AlternatingRowBackground="#253142"
                          GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dong" Binding="{Binding RowNumber}" Width="0.6*"/>
                        <DataGridTextColumn Header="Du lieu" Binding="{Binding Data}" Width="2*"/>
                        <DataGridTextColumn Header="Loi" Binding="{Binding ErrorMessage}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
