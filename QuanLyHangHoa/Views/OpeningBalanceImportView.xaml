<UserControl x:Class="QuanLyHangHoa.Views.OpeningBalanceImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.lg}">
                <materialDesign:PackIcon Kind="FileImport" Width="28" Height="28" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="NHẬP TỒN ĐẦU KỲ" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="24" Margin="{StaticResource Margin.Bottom.lg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             materialDesign:HintAssist.Hint="Đường dẫn file CSV/Excel" Margin="0,0,20,0"
                             Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" FontSize="14" IsReadOnly="True"/>

                    <Button Grid.Column="1" Content="CHỌN FILE" Command="{Binding BrowseFileCommand}" 
                            Style="{StaticResource AppSecondaryButton}" Margin="0,0,12,0" VerticalAlignment="Bottom"/>

                    <Button Grid.Column="2" Content="IMPORT DỮ LIỆU" Command="{Binding ImportOpeningBalanceCommand}" 
                            Style="{StaticResource AppPrimaryButton}" VerticalAlignment="Bottom"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16" Background="#F9FAFB" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#EF4444" VerticalAlignment="Center"/>
                            <TextBlock Text="DANH SÁCH LỖI IMPORT" FontWeight="Bold" Foreground="#1F2937" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Errors}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}" 
                              MaxHeight="400" BorderThickness="0" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dòng" Binding="{Binding RowNumber}" Width="80" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                            <DataGridTextColumn Header="Dữ liệu" Binding="{Binding Data}" Width="200" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="Chi tiết lỗi" Binding="{Binding ErrorMessage}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="3" Margin="0,24,0,0" UniformCornerRadius="8" Padding="12" Background="{StaticResource PrimaryHueLightBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppTertiaryBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
