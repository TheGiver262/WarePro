<UserControl x:Class="QuanLyHangHoa.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">
    
    <UserControl.DataContext>
        <vm:ProductViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section (Transparent) -->
            <Grid Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource AppTertiaryBrush}" Width="40" Height="40" CornerRadius="{StaticResource Radius.md}">
                        <materialDesign:PackIcon Kind="PackageVariant" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextOnPrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="{StaticResource Margin.Left.md}" VerticalAlignment="Center">
                        <TextBlock Text="DANH MỤC SẢN PHẨM" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppPrimaryBrush}"/>
                        <TextBlock Text="Quản lý thông tin hàng hóa, tồn kho và giá bán" Style="{StaticResource TypographyCaption}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="THÊM MỚI" Command="{Binding ClearInputCommand}" 
                            Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Right.sm}"/>
                    <Button Content="NHẬP EXCEL" Command="{Binding ImportDataCommand}" 
                            Style="{StaticResource AppSecondaryButton}"/>
                </StackPanel>
            </Grid>

            <!-- Search Row (Integrated) -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" Height="40" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="{StaticResource Padding.sm}" Foreground="{StaticResource AppSecondaryBrush}"/>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 materialDesign:HintAssist.Hint="Tìm kiếm sản phẩm..." 
                                 FontSize="14" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Content="TÌM KIẾM" Command="{Binding SearchCommand}" Style="{StaticResource AppSecondaryButton}" Margin="{StaticResource Margin.Left.sm}" Height="40"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>
                
                <!-- Data Table -->
                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.lg}" Style="{StaticResource AppCard}" Padding="0">
                    <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                               AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ" Binding="{Binding Id}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                            <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource AppPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ProductCode}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PHÂN LOẠI" Binding="{Binding Category.DisplayName}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTemplateColumn Header="TỒN KHO" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="{StaticResource Radius.sm}" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalQuantity}" Foreground="{StaticResource AppTertiaryBrush}" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="GIÁ BÁN" Binding="{Binding DefaultPrice, StringFormat='N0'}" Width="120" FontWeight="SemiBold" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding DefaultUnit.DisplayName}" Width="80" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- Edit Form -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.lg}">
                            <materialDesign:PackIcon Kind="PackageVariant" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CHI TIẾT SẢN PHẨM" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppPrimaryBrush}" Margin="{StaticResource Margin.Left.sm}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox materialDesign:HintAssist.Hint="Mã sản phẩm" Text="{Binding CurrentInputProduct.ProductCode}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="{StaticResource Margin.Bottom.md}"/>
                                <TextBox materialDesign:HintAssist.Hint="Tên hàng hóa" Text="{Binding CurrentInputProduct.DisplayName}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="{StaticResource Margin.Bottom.md}"/>
                                
                                <Grid Margin="{StaticResource Margin.Bottom.md}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Danh mục" Margin="{StaticResource Margin.Right.sm}" ItemsSource="{Binding Categories}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding CurrentInputProduct.CategoryId}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                    <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="Thương hiệu" Margin="{StaticResource Margin.Left.sm}" ItemsSource="{Binding Brands}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding CurrentInputProduct.BrandId}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </Grid>

                                <Grid Margin="{StaticResource Margin.Bottom.md}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Đơn vị tính" Margin="{StaticResource Margin.Right.sm}" ItemsSource="{Binding Units}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding CurrentInputProduct.DefaultUnitId}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Giá bán" Margin="{StaticResource Margin.Left.sm}" Text="{Binding CurrentInputProduct.DefaultPrice, StringFormat='N0'}" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontWeight="Bold" Foreground="{StaticResource AppTertiaryBrush}"/>
                                </Grid>

                                <TextBox materialDesign:HintAssist.Hint="Xuất xứ" Text="{Binding CurrentInputProduct.OriginCountry}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="{StaticResource Margin.Bottom.md}"/>
                                <TextBox materialDesign:HintAssist.Hint="Bảo hành (tháng)" Text="{Binding CurrentInputProduct.WarrantyPeriodMonths}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="{StaticResource Margin.Bottom.md}"/>
                                
                                <CheckBox Content="Theo dõi theo Serial Number" IsChecked="{Binding CurrentInputProduct.IsSerialTracked}" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource MaterialDesignCheckBox}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="{StaticResource Margin.Top.lg}">
                            <Button Content="CẬP NHẬT THÔNG TIN" Command="{Binding SaveProductCommand}" 
                                    Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Bottom.sm}"/>
                            <Button Content="XOÁ SẢN PHẨM" Command="{Binding DeleteProductCommand}" 
                                    Style="{StaticResource AppDangerButton}"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
