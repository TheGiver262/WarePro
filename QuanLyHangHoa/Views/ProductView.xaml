<UserControl x:Class="QuanLyHangHoa.Views.ProductView"
             x:Name="RootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             xmlns:helpers="clr-namespace:QuanLyHangHoa.Helpers"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Search / Filters -->
                <RowDefinition Height="*"/>    <!-- Row 2: Main Content -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariant" Width="32" Height="32" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="DANH MỤC SẢN PHẨM" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Quản lý danh mục sản phẩm" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}">

                    
                    <Button Command="{Binding OpenAddProductWindowCommand}" 
                            Style="{StaticResource PrimaryButton}"
                            Height="32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="THÊM SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row (Standardized Pro Max) -->
            <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Padding="{StaticResource Spacing.md}" Style="{StaticResource AppCard}">
                <StackPanel>
                    <!-- Main Search Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>      <!-- Mã -->
                            <ColumnDefinition Width="*"/>        <!-- Tên -->
                            <ColumnDefinition Width="Auto"/>     <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="MÃ SẢN PHẨM" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Mã sản phẩm..."
                                     Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="TÊN SẢN PHẨM" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Tìm kiếm theo tên sản phẩm..."
                                     Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ToggleAdvancedFilterCommand}"
                                    ToolTip="Lọc nâng cao"
                                    Width="180" Height="32" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="BỘ LỌC NÂNG CAO" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource AppRefreshButton}" 
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="Làm mới bộ lọc"
                                    Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                            </Button>

                            <Button Style="{StaticResource AppExcelButton}" 
                                    Command="{Binding ExportToExcelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Filter Row (Expandable) -->
                    <Grid Margin="0,16,0,0" Visibility="{Binding IsAdvancedFilterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>      <!-- Danh mục -->
                            <ColumnDefinition Width="180"/>      <!-- Thương hiệu -->
                            <ColumnDefinition Width="140"/>      <!-- Giá Min -->
                            <ColumnDefinition Width="140"/>      <!-- Giá Max -->
                            <ColumnDefinition Width="140"/>      <!-- Serial -->
                            <ColumnDefinition Width="140"/>      <!-- Bảo hành -->
                            <ColumnDefinition Width="*"/>        <!-- Trạng thái -->
                        </Grid.ColumnDefinitions>

                        <!-- Category -->
                        <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="DANH MỤC" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding Categories}" 
                                      SelectedItem="{Binding SelectedCategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Brand -->
                        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="THƯƠNG HIỆU" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding Brands}" 
                                      SelectedItem="{Binding SelectedBrandFilter, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Price Min -->
                        <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="GIÁ TỪ" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Giá thấp nhất"
                                     Text="{Binding SearchPriceMin, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Price Max -->
                        <StackPanel Grid.Column="3" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="GIÁ ĐẾN" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Giá cao nhất"
                                     Text="{Binding SearchPriceMax, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Serial -->
                        <StackPanel Grid.Column="4" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="SERIAL" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding SerialOptions}" 
                                      SelectedItem="{Binding SearchSerial, UpdateSourceTrigger=PropertyChanged}"
                                      Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Warranty -->
                        <StackPanel Grid.Column="5" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="BẢO HÀNH" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Tháng bảo hành..."
                                     Text="{Binding SearchWarranty, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding StatusOptions}" 
                                      SelectedItem="{Binding SearchStatus, UpdateSourceTrigger=PropertyChanged}"
                                      Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Row 2: Content Area -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              helpers:DataGridHelper.LoadMoreCommand="{Binding LoadMoreCommand}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="60"
                              SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <!-- 2. Mã SP -->
                        <DataGridTemplateColumn Width="110" SortMemberPath="ProductCode">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="MÃ SP" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductCode}" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Tên sản phẩm -->
                        <DataGridTemplateColumn Width="*" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="TÊN SP" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="12,4">
                                        <TextBlock Style="{StaticResource TypographyBodyBold}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="Brand.DisplayName"/>
                                                    <Binding Path="DisplayName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Category.DisplayName}" Style="{StaticResource TypographySmall}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Thương hiệu -->
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="THƯƠNG HIỆU" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Brand.DisplayName}" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. Serial -->
                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="SERIAL" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="-"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSerialTracked}" Value="True">
                                                        <Setter Property="Text" Value="Có"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 6. Bảo hành -->
                        <DataGridTemplateColumn Width="85">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="BH" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WarrantyPeriodMonths, StringFormat='{}{0} th'}" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7. Đơn vị -->
                        <DataGridTemplateColumn Width="95">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="ĐVT" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DefaultUnit.DisplayName}" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 8. Giá bán -->
                        <DataGridTextColumn Binding="{Binding DefaultPrice, StringFormat='N0'}" Width="120" 
                                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}" Foreground="{StaticResource AppTertiaryBrush}">
                            <DataGridTextColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="GIÁ BÁN" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- 9. Trạng thái -->
                        <!-- 9. Trạng thái -->
                        <DataGridTemplateColumn Width="140" SortMemberPath="IsActive"
                                                CellTemplate="{StaticResource BooleanStatusBadgeTemplate}">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="TRẠNG THÁI" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                        </DataGridTemplateColumn>

                        <!-- 7. Thao tác -->
                        <DataGridTemplateColumn Header="THAO TÁC" Width="95" Visibility="{Binding Data.CanManage, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Sửa" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenEditProductWindowCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{StaticResource AppSecondaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xóa"
                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="{StaticResource AppErrorBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Left">
                            <Run Text="Hiện có "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=" sản phẩm trong hệ thống · "/>
                            <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                            <Run Text=" Hoạt động · "/>
                            <Run Text="{Binding InactiveCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}"/>
                            <Run Text=" Dừng"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
