<UserControl x:Class="QuanLyHangHoa.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    <UserControl.DataContext><vm:ProductViewModel /></UserControl.DataContext>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search -->
                <RowDefinition Height="*"/>    <!-- Table -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CubeOutline" Width="32" Height="32" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="DANH SÁCH SẢN PHẨM" Style="{DynamicResource TypographyH2}"/>
                        <TextBlock Text="Quản lý thông tin hàng hóa và tồn kho hệ thống" Style="{DynamicResource TypographyCaption}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenAddProductWindowCommand}" Style="{StaticResource AppPrimaryButton}" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="THÊM SẢN PHẨM" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search & Filter Row -->
            <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" 
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Margin="{StaticResource Margin.Bottom.md}" Padding="16,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>     <!-- Code -->
                        <ColumnDefinition Width="*"/>     <!-- Name -->
                        <ColumnDefinition Width="*"/>     <!-- Category -->
                        <ColumnDefinition Width="*"/>     <!-- Status -->
                        <ColumnDefinition Width="Auto"/> <!-- Export -->
                    </Grid.ColumnDefinitions>

                    <!-- Code -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Mã sản phẩm" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SearchTextBoxStyle}" 
                                 Height="45" materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                 Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,10,0"
                                 materialDesign:HintAssist.IsFloating="False"
                                 materialDesign:HintAssist.Hint="Tìm theo mã..."/>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Tên sản phẩm" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SearchTextBoxStyle}" 
                                 Height="45" materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                 Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,10,0"
                                 materialDesign:HintAssist.IsFloating="False"
                                 materialDesign:HintAssist.Hint="Tìm theo tên..."/>
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Danh mục" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                  Margin="0" Height="45" Padding="12,0"
                                  materialDesign:HintAssist.IsFloating="False"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                  ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SelectedCategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName"
                                  VerticalContentAlignment="Center"
                                  materialDesign:HintAssist.Hint="Tất cả danh mục"/>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Trạng thái" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                  Margin="0" Height="45" Padding="12,0"
                                  materialDesign:HintAssist.IsFloating="False"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                  ItemsSource="{Binding StatusOptions}" 
                                  SelectedItem="{Binding SearchStatus, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Export Button -->
                    <Button Grid.Column="4" Command="{Binding ExportToExcelCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            BorderBrush="{StaticResource AppSecondaryBrush}"
                            Foreground="{StaticResource AppSecondaryBrush}"
                            Height="45" Margin="0,18,0,0" Padding="16,0"
                            materialDesign:ButtonAssist.CornerRadius="{StaticResource Radius.sm}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 2: Content Area -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              AlternationCount="10000" EnableRowVirtualization="False"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="56" BorderThickness="0" Background="Transparent"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="60" CanUserSort="False"
                                                Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowIndexConverter}}"
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>

                            <DataGridTemplateColumn Width="130">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.6"/>
                                        <TextBlock Text="MÃ SẢN PHẨM" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductCode}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.6"/>
                                        <TextBlock Text="TÊN SẢN PHẨM" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Category.DisplayName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding Brand.DisplayName}" Width="150" 
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="THƯƠNG HIỆU" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TỒN KHO" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StockBalances, Converter={StaticResource StockSumConverter}}" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockBalances, Converter={StaticResource StockSumConverter}}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding DefaultPrice, StringFormat='N0'}" Width="130" 
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}" FontWeight="Bold" Foreground="{StaticResource AppTertiaryBrush}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="GIÁ BÁN" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.6"/>
                                        <TextBlock Text="TRẠNG THÁI" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,4" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="NGỪNG HOẠT ĐỘNG"/>
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="ĐANG HOẠT ĐỘNG"/>
                                                                    <Setter Property="Foreground" Value="#166534"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="THAO TÁC" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" ToolTip="Sửa" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.OpenEditProductWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" ToolTip="Xóa"
                                                    Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="{StaticResource AppErrorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Hiện có {0} sản phẩm trong hệ thống">
                                    <Binding Path="Products.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
