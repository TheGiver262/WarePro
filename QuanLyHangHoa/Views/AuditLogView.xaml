<UserControl x:Class="QuanLyHangHoa.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Search / Filters -->
                <RowDefinition Height="*"/>    <!-- Row 2: Main Content -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="NHẬT KÝ HỆ THỐNG" Style="{StaticResource TypographyH2}"/>
                        <TextBlock Text="Theo dõi lịch sử thao tác và thay đổi dữ liệu" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenArchiveDialogCommand}" 
                            Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Right.sm}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArchiveArrowDownOutline" Width="20" Height="20"/>
                            <TextBlock Text="LƯU TRỮ" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding LoadLogsCommand}"
                            Foreground="{StaticResource AppTertiaryBrush}" ToolTip="Làm mới">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search / Filter Bar -->
            <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Padding="{StaticResource Spacing.md}" Style="{StaticResource AppCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>      <!-- Đối tượng -->
                        <ColumnDefinition Width="Auto"/>      <!-- Hành động -->
                        <ColumnDefinition Width="Auto"/>      <!-- Nhân viên -->
                        <ColumnDefinition Width="*"/>      <!-- Khoảng ngày -->
                        <ColumnDefinition Width="Auto"/>      <!-- Nút hành động -->
                    </Grid.ColumnDefinitions>

                    <!-- Entity Filter -->
                    <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}" Width="160">
                        <TextBlock Text="ĐỐI TƯỢNG" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <ComboBox ItemsSource="{Binding EntityNames}" SelectedItem="{Binding SelectedEntity}"
                                  Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Action Filter -->
                    <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}" Width="140">
                        <TextBlock Text="HÀNH ĐỘNG" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <ComboBox ItemsSource="{Binding ActionCodes}" SelectedItem="{Binding SelectedAction}"
                                  Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <!-- User Filter -->
                    <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}" Width="160">
                        <TextBlock Text="NHÂN VIÊN" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  DisplayMemberPath="FullName" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Date Range -->
                    <StackPanel Grid.Column="3" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="KHOẢNG NGÀY" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker SelectedDate="{Binding FromDate}" Width="200" Height="32" VerticalContentAlignment="Center"/>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="8,0"/>
                            <DatePicker SelectedDate="{Binding ToDate}" Width="200" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button Command="{Binding ExportLogsCommand}" Style="{StaticResource AppPrimaryButton}" Height="32">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="XUẤT EXCEL" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Main Content Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- DataGrid -->
                <materialDesign:Card Grid.Column="0" Style="{StaticResource AppCard}" Padding="0" Margin="{StaticResource Margin.Right.md}">
                    <DataGrid ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" 
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="40" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding PerformedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="160" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="NHÂN VIÊN" Binding="{Binding Performer.FullName}" Width="160" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="ĐỐI TƯỢNG" Binding="{Binding EntityName}" Width="160" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="HÀNH ĐỘNG" Binding="{Binding ActionCode}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- Detail Panel -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                            <TextBlock Text="CHI TIẾT THAY ĐỔI" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppTertiaryBrush}"/>
                            <Separator Background="{StaticResource AppBorderBrush}" Margin="{StaticResource Margin.Top.sm}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1">
                            <TextBlock Text="{Binding DiffResult}" TextWrapping="Wrap" FontSize="13" 
                                       FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <Border Grid.Row="3" Margin="{StaticResource Margin.Top.md}" Background="{StaticResource AppFooterBrush}" Padding="20,12" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                <TextBlock Style="{StaticResource TypographyCaption}" Opacity="0.8" VerticalAlignment="Center">
                    <Run Text="Hiện có "/>
                    <Run Text="{Binding Logs.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}"/>
                    <Run Text=" bản ghi nhật ký hệ thống."/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Archive Dialog Overlay -->
        <Grid Background="#80000000" Visibility="{Binding IsArchiveDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Padding="{StaticResource Spacing.lg}" Style="{StaticResource AppCard}">
                <StackPanel>
                    <TextBlock Text="LƯU TRỮ NHẬT KÝ" Style="{StaticResource TypographyH3}" 
                               HorizontalAlignment="Center" Margin="{StaticResource Margin.Bottom.md}"/>
                    
                    <TextBlock Text="Chọn khoảng thời gian để lưu trữ (phải trên 1 năm):" 
                               Style="{StaticResource TypographyCaption}" Margin="{StaticResource Margin.Bottom.md}"/>

                    <Grid Margin="{StaticResource Margin.Bottom.md}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="Từ ngày" 
                                    SelectedDate="{Binding ArchiveFromDate}" Margin="{StaticResource Margin.Right.sm}"/>
                        <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="Đến ngày" 
                                    SelectedDate="{Binding ArchiveToDate}"/>
                    </Grid>

                    <TextBlock Text="{Binding ArchiveValidationMessage}" 
                               Foreground="{StaticResource AppErrorBrush}" 
                               HorizontalAlignment="Center" Margin="{StaticResource Margin.Bottom.md}"
                               Visibility="{Binding ArchiveValidationMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="HỦY" Command="{Binding CloseArchiveDialogCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="{StaticResource Margin.Right.sm}"/>
                        <Button Content="XÁC NHẬN" Command="{Binding ConfirmArchiveCommand}" 
                                Style="{StaticResource AppPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
