<UserControl x:Class="QuanLyHangHoa.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}" MaxWidth="1600" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Search / Filters -->
                <RowDefinition Height="*"/>    <!-- Row 2: Main Content -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="NHẬT KÝ HỆ THỐNG" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Theo dõi lịch sử thao tác và thay đổi dữ liệu" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenArchiveDialogCommand}" 
                            Style="{StaticResource PrimaryButton}" Height="32" Margin="{StaticResource Margin.Right.sm}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArchiveArrowDownOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="LƯU TRỮ" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ProMaxIconButtonStyle}" Command="{Binding LoadLogsCommand}" ToolTip="Làm mới">
                        <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search / Filter Bar -->
            <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Padding="{StaticResource Spacing.md}" Style="{StaticResource AppCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>      <!-- Đối tượng -->
                        <ColumnDefinition Width="160"/>      <!-- Hành động -->
                        <ColumnDefinition Width="180"/>      <!-- Nhân viên -->
                        <ColumnDefinition Width="*"/>        <!-- Khoảng ngày -->
                        <ColumnDefinition Width="Auto"/>     <!-- Nút hành động -->
                    </Grid.ColumnDefinitions>

                    <!-- Entity Filter -->
                    <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="ĐỐI TƯỢNG" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding EntityNames}" SelectedItem="{Binding SelectedEntity}"
                                  Height="40"/>
                    </StackPanel>

                    <!-- Action Filter -->
                    <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="HÀNH ĐỘNG" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding ActionCodes}" SelectedItem="{Binding SelectedAction}"
                                  Height="40"/>
                    </StackPanel>
                    
                    <!-- User Filter -->
                    <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="NHÂN VIÊN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  DisplayMemberPath="FullName" Height="40"/>
                    </StackPanel>

                    <!-- Date Range -->
                    <StackPanel Grid.Column="3" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="KHOẢNG NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" Style="{StaticResource AppDatePickerStyle}" SelectedDate="{Binding FromDate}" Height="40"/>
                            <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DatePicker Grid.Column="2" Style="{StaticResource AppDatePickerStyle}" SelectedDate="{Binding ToDate}" Height="40"/>
                        </Grid>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AppRefreshButton}" 
                                Command="{Binding ResetFiltersCommand}"
                                ToolTip="Làm mới bộ lọc"
                                Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource AppExcelButton}" 
                                Command="{Binding ExportLogsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Main Content Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- DataGrid -->
                <materialDesign:Card Grid.Column="0" Style="{StaticResource AppCard}" Padding="0" Margin="{StaticResource Margin.Right.md}">
                    <DataGrid ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" 
                              EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" 
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="40" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="160" SortMemberPath="PerformedAt">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="THỜI GIAN" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PerformedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" VerticalAlignment="Center" Margin="12,0" FontSize="13"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="160" SortMemberPath="Performer.FullName">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="NHÂN VIÊN" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Performer.FullName}" VerticalAlignment="Center" Margin="12,0" FontSize="13"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="160" SortMemberPath="EntityName">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="ĐỐI TƯỢNG" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EntityName}" VerticalAlignment="Center" Margin="12,0" FontSize="13"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*" SortMemberPath="ActionCode">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="HÀNH ĐỘNG" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionCode}" VerticalAlignment="Center" Margin="12,0" FontSize="13"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- Detail Panel -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                            <TextBlock Text="CHI TIẾT THAY ĐỔI" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppTertiaryBrush}"/>
                            <Separator Background="{StaticResource AppBorderBrush}" Margin="{StaticResource Margin.Top.sm}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1">
                            <TextBlock Text="{Binding DiffResult}" TextWrapping="Wrap" FontSize="13" 
                                       FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <Border Grid.Row="3" Margin="{StaticResource Margin.Top.md}" Background="{StaticResource AppFooterBrush}" Padding="20,12" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                <TextBlock Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Run Text="Hiện có "/>
                    <Run Text="{Binding Logs.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Run Text=" bản ghi nhật ký hệ thống"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Archive Dialog Overlay -->
        <Grid Background="#80000000" Visibility="{Binding IsArchiveDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Padding="{StaticResource Spacing.lg}" Style="{StaticResource AppCard}">
                <StackPanel>
                    <TextBlock Text="LƯU TRỮ NHẬT KÝ" Style="{StaticResource TypographyH3}" 
                               HorizontalAlignment="Center" Margin="{StaticResource Margin.Bottom.md}"/>
                    
                    <TextBlock Text="Chọn khoảng thời gian để lưu trữ (phải trên 1 năm):" 
                               Style="{StaticResource TypographyCaption}" Margin="{StaticResource Margin.Bottom.md}"/>

                    <Grid Margin="{StaticResource Margin.Bottom.md}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="Từ ngày" 
                                    SelectedDate="{Binding ArchiveFromDate}" Margin="{StaticResource Margin.Right.sm}"/>
                        <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="Đến ngày" 
                                    SelectedDate="{Binding ArchiveToDate}"/>
                    </Grid>

                    <TextBlock Text="{Binding ArchiveValidationMessage}" 
                               Foreground="{StaticResource AppErrorBrush}" 
                               HorizontalAlignment="Center" Margin="{StaticResource Margin.Bottom.md}"
                               Visibility="{Binding ArchiveValidationMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="HỦY" Command="{Binding CloseArchiveDialogCommand}" 
                                Style="{StaticResource SecondaryButton}" Margin="{StaticResource Margin.Right.sm}"/>
                        <Button Content="XÁC NHẬN" Command="{Binding ConfirmArchiveCommand}" 
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
