<UserControl x:Class="QuanLyHangHoa.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.DataContext>
        <vm:CustomerViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <materialDesign:Card Grid.Row="0" Margin="{StaticResource Margin.Bottom.lg}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AppTertiaryBrush}" Width="40" Height="40" CornerRadius="{StaticResource Radius.md}">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        </Border>
                        <StackPanel Margin="{StaticResource Margin.Left.md}" VerticalAlignment="Center">
                            <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppPrimaryBrush}"/>
                            <TextBlock Text="Quản lý thông tin khách hàng và lịch sử giao dịch" Style="{StaticResource TypographyCaption}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" Width="300" Height="36" Margin="{StaticResource Margin.Right.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="{StaticResource Padding.sm}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" materialDesign:HintAssist.Hint="Tìm khách hàng..." FontSize="13" Background="Transparent"/>
                            </Grid>
                        </Border>
                        <Button Content="THÊM MỚI" Command="{Binding ClearCommand}" 
                                Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Right.sm}"/>
                        <Button Content="NHẬP EXCEL" Command="{Binding ImportDataCommand}" 
                                Style="{StaticResource AppSecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>
                
                <!-- Data Table -->
                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.lg}" Style="{StaticResource AppCard}" Padding="0">
                    <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                               AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ" Binding="{Binding Id}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                            <DataGridTextColumn Header="MÃ KH" Binding="{Binding CustomerCode}" Width="Auto" FontWeight="SemiBold" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTemplateColumn Header="KHÁCH HÀNG" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource AppPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="ĐỊA CHỈ" Binding="{Binding Address}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- Edit Form -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.lg}">
                            <materialDesign:PackIcon Kind="AccountEditOutline" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CHI TIẾT KHÁCH HÀNG" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppPrimaryBrush}" Margin="{StaticResource Margin.Left.sm}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox materialDesign:HintAssist.Hint="Mã khách hàng" Text="{Binding CustomerCode}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="{StaticResource Margin.Bottom.md}"/>
                                <TextBox materialDesign:HintAssist.Hint="Tên khách hàng" Text="{Binding DisplayName}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="{StaticResource Margin.Bottom.md}"/>
                                <TextBox materialDesign:HintAssist.Hint="Số điện thoại" Text="{Binding Phone}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="{StaticResource Margin.Bottom.md}"/>
                                <TextBox materialDesign:HintAssist.Hint="Email" Text="{Binding Email}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="{StaticResource Margin.Bottom.md}"/>
                                
                                <TextBox materialDesign:HintAssist.Hint="Địa chỉ khách hàng" Text="{Binding Address}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="{StaticResource Margin.Top.lg}">
                            <Button Content="LƯU THAY ĐỔI" Command="{Binding SaveCommand}" 
                                    Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Bottom.sm}"/>
                            <Button Content="XOÁ KHÁCH HÀNG" Command="{Binding DeleteCommand}" 
                                    Style="{StaticResource AppDangerButton}"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
