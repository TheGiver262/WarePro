<UserControl x:Class="QuanLyHangHoa.Views.AdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header / Toolbar -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,24" Style="{StaticResource AppCard}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tune" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="ĐIỀU CHỈNH TỒN KHO" Style="{StaticResource TypographyH2}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource AppPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="TẠO PHIẾU MỚI" Command="{Binding CreateCommand}" 
                                Style="{StaticResource AppPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Input Form -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,24" Style="{StaticResource AppCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="DisplayName"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" materialDesign:HintAssist.Hint="Chọn sản phẩm điều chỉnh" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBox Text="{Binding NewQuantity}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 materialDesign:HintAssist.Hint="Số lượng thực tế" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBox Text="{Binding Reason}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 materialDesign:HintAssist.Hint="Lý do điều chỉnh" FontSize="14"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="XÁC NHẬN" Command="{Binding ExecuteCommand}" 
                            Style="{StaticResource AppPrimaryButton}" Height="40" VerticalAlignment="Bottom"/>
                </Grid>
            </materialDesign:Card>

            <!-- Data Table -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <DataGrid ItemsSource="{Binding Adjustments}" AutoGenerateColumns="False" CanUserAddRows="False" 
                          IsReadOnly="True" BorderThickness="0" RowHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NGÀY" Binding="{Binding AdjustmentDate, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        <DataGridTextColumn Header="SẢN PHẨM" Binding="{Binding Product.DisplayName}" Width="2*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="SL CŨ" Binding="{Binding OldQuantity}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                        <DataGridTextColumn Header="SL MỚI" Binding="{Binding NewQuantity}" Width="*" FontWeight="Bold" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                        <DataGridTextColumn Header="LÝ DO" Binding="{Binding Reason}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
