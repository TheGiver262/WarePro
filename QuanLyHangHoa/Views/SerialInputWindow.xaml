<Window x:Class="QuanLyHangHoa.Views.SerialInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nhập Serial Number" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="QUẢN LÝ SERIAL NUMBERS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                <Separator Background="#F0F0F0" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Instructions -->
            <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="12" LineHeight="18">
                        • Nhập từng serial riêng lẻ (mỗi dòng một mã).<LineBreak/>
                        • Hoặc nhập dải số: <Bold>EM901-EM930</Bold>.<LineBreak/>
                        • Cách nhau bằng dấu phẩy hoặc xuống dòng.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Input Area -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <materialDesign:Card UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1" Padding="0">
                    <TextBox x:Name="SerialTextBox" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                             BorderThickness="0"
                             Padding="12"
                             FontFamily="Consolas"
                             FontSize="14"
                             materialDesign:HintAssist.Hint="Dán hoặc nhập danh sách serial tại đây..."
                             Text="{Binding SerialInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                </materialDesign:Card>

                <!-- Available Serials Hint (for StockOut) -->
                <materialDesign:Card Grid.Row="1" Margin="0,12,0,0" UniformCornerRadius="8" 
                                     Visibility="{Binding HasAvailableSerials, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander Header="Serial hiện có trong kho" FontSize="12" Background="#FFF8E1">
                        <ListBox x:Name="AvailableListBox" MaxHeight="120" BorderThickness="0"
                                 ItemsSource="{Binding AvailableSerials, RelativeSource={RelativeSource AncestorType=Window}}"
                                 SelectionChanged="AvailableListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="4"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </materialDesign:Card>
            </Grid>

            <!-- Preview Info -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,16">
                <materialDesign:PackIcon Kind="Counter" VerticalAlignment="Center" Foreground="#999999"/>
                <TextBlock x:Name="PreviewLabel" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="HỦY BỎ" Style="{StaticResource MaterialDesignOutlinedButton}" 
                        materialDesign:ButtonAssist.CornerRadius="8" Click="Cancel_Click" HorizontalAlignment="Left"/>

                <Button Grid.Column="1" Content="XÁC NHẬN" Style="{StaticResource MaterialDesignRaisedButton}" 
                        materialDesign:ButtonAssist.CornerRadius="8" Click="Confirm_Click" Width="120"/>
            </Grid>
        </Grid>
    </Border>
</Window>
