<Window x:Class="QuanLyHangHoa.Views.SerialInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập Serial Number" Height="480" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1D2E">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#6C63FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A52E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#2E3147"/>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="12" Background="#242740" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="📋 Nhập Serial Numbers" FontSize="18" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,16">
                Nhập từng serial riêng lẻ hoặc dải số.&#x0a;Ví dụ: EM90126000-EM90126030 → tạo 31 serial.&#x0a;Hỗ trợ nhiều dải, cách nhau bằng dấu phẩy hoặc xuống dòng.
            </TextBlock>

            <!-- Available serials hint -->
            <StackPanel Grid.Row="2" Visibility="{Binding HasAvailableSerials, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,8">
                <TextBlock Text="Serial còn trong kho:" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold"/>
                <ListBox x:Name="AvailableListBox" MaxHeight="90" Background="#1A1D2E" Foreground="#D1D5DB"
                         BorderThickness="0" FontSize="11"
                         ItemsSource="{Binding AvailableSerials, RelativeSource={RelativeSource AncestorType=Window}}"
                         SelectionChanged="AvailableListBox_SelectionChanged"/>
            </StackPanel>

            <!-- Input TextBox -->
            <TextBox Grid.Row="3" x:Name="SerialTextBox"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#1A1D2E" Foreground="White" FontFamily="Consolas" FontSize="13"
                     CaretBrush="White" BorderBrush="#6C63FF" BorderThickness="1"
                     Padding="10" Margin="0,0,0,8"
                     Text="{Binding SerialInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Preview count -->
            <TextBlock Grid.Row="4" x:Name="PreviewLabel" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,16"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" Style="{StaticResource SecondaryBtn}" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Content="✔ Xác nhận" Style="{StaticResource PrimaryBtn}" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
