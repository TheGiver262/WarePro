<Window x:Class="QuanLyHangHoa.Views.SerialInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nhập Serial Number" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border CornerRadius="{StaticResource Radius.lg}" Background="{StaticResource AppSurfaceBrush}" 
            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <TextBlock Text="NHẬP SERIAL NUMBER" Style="{StaticResource TypographyH2}"/>
                <Border Height="1" Background="{StaticResource AppBorderBrush}" Margin="{StaticResource Margin.Top.sm}"/>
            </StackPanel>

            <!-- Instructions -->
            <Border Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" CornerRadius="{StaticResource Radius.md}" 
                    Padding="{StaticResource Spacing.md}" Margin="{StaticResource Margin.Bottom.md}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" LineHeight="18">
                        • Nhập từng serial riêng lẻ (mỗi dòng một mã).<LineBreak/>
                        • Hoặc nhập dải số: <Bold>EM901-EM930</Bold>.<LineBreak/>
                        • Cách nhau bằng dấu phẩy hoặc xuống dòng.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Input Area -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Style="{StaticResource AppCard}" Padding="0" materialDesign:ElevationAssist.Elevation="Dp0" BorderThickness="1">
                    <TextBox x:Name="SerialTextBox" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                             BorderThickness="0"
                             Padding="{StaticResource Spacing.md}"
                             FontFamily="Consolas"
                             FontSize="14"
                             materialDesign:HintAssist.Hint="Dán hoặc nhập danh sách serial tại đây..."
                             Text="{Binding SerialInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                </materialDesign:Card>

                <!-- Available Serials Hint -->
                <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Top.md}" Style="{StaticResource AppCard}"                                       Visibility="{Binding HasAvailableSerials, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander Header="Serial hiện có trong kho" FontSize="12" Background="#FFF8E1" BorderThickness="0">
                        <ListBox x:Name="AvailableListBox" MaxHeight="120" BorderThickness="0"
                                 ItemsSource="{Binding AvailableSerials, RelativeSource={RelativeSource AncestorType=Window}}"
                                 SelectionChanged="AvailableListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="4" Style="{StaticResource TypographyBody}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </materialDesign:Card>
            </Grid>

            <!-- Preview Info -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="{StaticResource Margin.Y.md}">
                <materialDesign:PackIcon Kind="Counter" VerticalAlignment="Center" Foreground="{StaticResource AppSecondaryBrush}"/>
                <TextBlock x:Name="PreviewLabel" Foreground="{StaticResource AppSecondaryBrush}" Style="{StaticResource TypographyCaption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="HỦY BỎ" Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="{StaticResource AppSecondaryBrush}" Click="Cancel_Click" HorizontalAlignment="Left"/>

                <Button Grid.Column="1" Content="XÁC NHẬN" Style="{StaticResource AppPrimaryButton}" 
                        Click="Confirm_Click" Width="140" Height="40"/>
            </Grid>
        </Grid>
    </Border>
</Window>
