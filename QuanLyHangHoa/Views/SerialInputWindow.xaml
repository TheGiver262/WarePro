<Window x:Class="QuanLyHangHoa.Views.SerialInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nhập Serial Number" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Width" Value="480"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowAvailableSerials, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Width" Value="720"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border CornerRadius="{StaticResource Radius.lg}" Background="{StaticResource AppSurfaceBrush}" 
            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBgBrush}" Padding="16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BarcodeScanner" Foreground="White" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="NHẬP SERIAL NUMBER" Foreground="White" FontWeight="Bold" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}" 
                            Padding="0" Width="30" Height="30" Click="Cancel_Click">
                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="{StaticResource PagePadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Instructions -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource AppBackgroundBrush}" CornerRadius="{StaticResource Radius.md}" 
                        Padding="{StaticResource Spacing.md}" Margin="{StaticResource Margin.Bottom.md}"
                        Visibility="{Binding ShowConfirmButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock x:Name="InstructionTextBlock" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TypographyCaption}">
                                <Setter Property="Text" Value="• Nhập từng serial riêng lẻ (mỗi dòng một mã).&#x0a;• Hoặc nhập dải số: EM901-EM930.&#x0a;• Cách nhau bằng dấu phẩy hoặc xuống dòng."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAvailableSerials, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Text" Value="• Tích chọn các serial có sẵn ở cột bên trái.&#x0a;• Hoặc dán danh sách serial ở cột bên phải để tự động chọn nhanh."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Input Area (Split Grid) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Available list (Left) -->
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="*"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAvailableSerials, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                            <Setter Property="Width" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        
                        <!-- Column 1: TextBox and Selected list (Right) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column Panel: Available Serials -->
                    <Grid Grid.Column="0" Margin="0,0,12,0"
                          Visibility="{Binding ShowAvailableSerials, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="SERIAL CÓ SẴN TRONG KHO" Style="{StaticResource TypographyLabel}" 
                                   Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,8"/>
                                   
                        <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="0" 
                                             materialDesign:ElevationAssist.Elevation="Dp0" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AvailableItemsControl"
                                              ItemsSource="{Binding AvailableSerials, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Click="CheckBox_Click"
                                                      Padding="12,8"
                                                      Margin="0"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalContentAlignment="Center"
                                                      Style="{StaticResource MaterialDesignCheckBox}">
                                                <TextBlock Text="{Binding SerialNumber}" Style="{StaticResource TypographyBody}"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </materialDesign:Card>
                    </Grid>

                    <!-- Right Column Panel: TextBox Input -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="SERIAL ĐÃ CHỌN / NHẬP" Style="{StaticResource TypographyLabel}" 
                                   Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding ShowAvailableSerials, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        
                        <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="0" 
                                             materialDesign:ElevationAssist.Elevation="Dp0" BorderThickness="1">
                            <TextBox x:Name="SerialTextBox" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                     BorderThickness="0"
                                     Padding="{StaticResource Spacing.md}"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     materialDesign:HintAssist.Hint="Dán hoặc nhập danh sách serial tại đây..."
                                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Text="{Binding SerialInput, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneTime}"
                                     TextChanged="SerialTextBox_TextChanged"/>
                        </materialDesign:Card>
                    </Grid>
                </Grid>

                <!-- Preview Info -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="{StaticResource Margin.Top.md}">
                    <materialDesign:PackIcon Kind="Counter" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Width="16" Height="16"/>
                    <TextBlock x:Name="PreviewLabel" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource TypographyCaption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="{StaticResource AppBackgroundBrush}" Padding="{StaticResource PagePadding}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="{Binding CancelButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButton}" 
                            Click="Cancel_Click" HorizontalAlignment="{Binding CancelButtonAlignment, RelativeSource={RelativeSource AncestorType=Window}}"/>

                    <Button Grid.Column="1" Content="XÁC NHẬN" Style="{StaticResource PrimaryButton}" 
                            Visibility="{Binding ShowConfirmButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="Confirm_Click" Width="140" Height="40"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
