<UserControl x:Class="QuanLyHangHoa.Views.ProductSerialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Tra cuu serial"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Tu khoa" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#374151"
                             Foreground="White"
                             Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Trang thai" Foreground="White" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus}"
                              Background="#374151"
                              Foreground="White"
                              Padding="8"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Tim"
                        Command="{Binding SearchSerialsCommand}"
                        Background="#2563EB"
                        Foreground="White"
                        Padding="18,10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        VerticalAlignment="Bottom"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="3"
                        Content="Xoa loc"
                        Command="{Binding ClearSearchCommand}"
                        Background="#4B5563"
                        Foreground="White"
                        Padding="18,10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="8" Padding="18">
            <DataGrid ItemsSource="{Binding Serials}"
                      SelectedItem="{Binding SelectedSerial}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="#111827"
                      Foreground="White"
                      RowBackground="#1F2937"
                      AlternatingRowBackground="#253142"
                      GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="1.6*"/>
                    <DataGridTextColumn Header="Hang hoa" Binding="{Binding Product.Name}" Width="2*"/>
                    <DataGridTextColumn Header="Trang thai" Binding="{Binding Status}" Width="1.2*"/>
                    <DataGridTextColumn Header="Kho hien tai" Binding="{Binding CurrentWarehouse.Name}" Width="1.5*"/>
                    <DataGridTextColumn Header="Nhap gan nhat" Binding="{Binding StockInDetailId}" Width="1*"/>
                    <DataGridTextColumn Header="Xuat gan nhat" Binding="{Binding StockOutDetailId}" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
