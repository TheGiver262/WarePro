<UserControl x:Class="QuanLyHangHoa.Views.ProductSerialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Search / Filters -->
                <RowDefinition Height="*"/>    <!-- Row 2: Main Content -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BarcodeScan" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="QUẢN LÝ SERIAL" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Theo dõi chi tiết số serial sản phẩm trong kho" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row (Standardized Pro Max with Advanced Filter) -->
            <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Padding="{StaticResource Spacing.md}" Style="{StaticResource AppCard}">
                <StackPanel>
                    <!-- Main Search Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>    <!-- Serial -->
                            <ColumnDefinition Width="*"/>      <!-- Product -->
                            <ColumnDefinition Width="150"/>    <!-- Brand -->
                            <ColumnDefinition Width="180"/>    <!-- Status -->
                            <ColumnDefinition Width="Auto"/>   <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <!-- Serial Search -->
                        <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="SỐ SERIES" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox materialDesign:HintAssist.Hint="Tìm số series..." 
                                     Height="32" VerticalContentAlignment="Center"
                                     Text="{Binding SearchSerial, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Product Search -->
                        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="SẢN PHẨM" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Height="32" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Mã hoặc tên sản phẩm..."
                                     Text="{Binding SearchProduct, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Brand Search -->
                        <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="THƯƠNG HIỆU" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Height="32" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Thương hiệu..."
                                     Text="{Binding SearchBrand, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Status Filter -->
                        <StackPanel Grid.Column="3" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <ComboBox ItemsSource="{Binding Statuses}" 
                                      SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}"
                                      Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ToggleAdvancedFilterCommand}"
                                    ToolTip="Bộ lọc nâng cao"
                                    Width="180" Height="32" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="BỘ LỌC NÂNG CAO" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource AppRefreshButton}" 
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="Làm mới bộ lọc"
                                    Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                            </Button>
                            
                            <Button Style="{StaticResource AppExcelButton}" 
                                    Command="{Binding ExportToExcelCommand}"
                                    Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Filter Row (Expandable) -->
                    <Grid Margin="0,16,0,0" Visibility="{Binding IsAdvancedFilterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>    <!-- From Date -->
                            <ColumnDefinition Width="200"/>    <!-- To Date -->
                            <ColumnDefinition Width="*"/>      <!-- Note -->
                        </Grid.ColumnDefinitions>

                        <!-- From Date -->
                        <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="TỪ NGÀY" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <DatePicker Height="32" VerticalContentAlignment="Center"
                                       materialDesign:HintAssist.Hint="Từ ngày..."
                                       SelectedDate="{Binding SearchFromDate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- To Date -->
                        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <DatePicker Height="32" VerticalContentAlignment="Center"
                                       materialDesign:HintAssist.Hint="Đến ngày..."
                                       SelectedDate="{Binding SearchToDate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Note Search -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ghi chú" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Height="32" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Nội dung ghi chú..."
                                     Text="{Binding SearchNote, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Row 2: Content Area -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Serials}" SelectedItem="{Binding SelectedSerial, Mode=TwoWay}"
                              EnableRowVirtualization="False"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="44"
                              SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <!-- 2. Serial -->
                        <DataGridTemplateColumn Width="180" SortMemberPath="SerialNumber">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="SERIAL" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SerialNumber}" Style="{StaticResource TypographyBodyBold}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource AppSecondaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Sản phẩm -->
                        <DataGridTemplateColumn Width="*" SortMemberPath="Product.DisplayName">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.6"/>
                                    <TextBlock Text="SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding Product.DisplayName}" Style="{StaticResource TypographyBodyBold}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Thương hiệu -->
                        <DataGridTemplateColumn Width="150" SortMemberPath="Product.Brand.DisplayName">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="THƯƠNG HIỆU" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Product.Brand.DisplayName}" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. Trạng thái -->
                        <DataGridTemplateColumn Width="150" SortMemberPath="CurrentStatus"
                                                CellTemplate="{StaticResource SerialStatusBadgeTemplate}">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                    <TextBlock Text="TRẠNG THÁI" VerticalAlignment="Center" Style="{StaticResource TypographyLabelBold}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                        </DataGridTemplateColumn>

                        <!-- 6. Thao tác -->
                        <DataGridTemplateColumn Header="THAO TÁC" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xem chi tiết" Margin="0,0,4,0"
                                                Command="{Binding DataContext.ViewSerialDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Sửa" Margin="0,0,4,0"
                                                Command="{Binding DataContext.EditSerialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Row 1: Footer -->
                    <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource TypographyCaption}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Hiện có {0} số Serial trong hệ thống · {1} trong kho · {2} đã bán · {3} thanh lý">
                                    <Binding Path="TotalCount"/>
                                    <Binding Path="InStockCount"/>
                                    <Binding Path="SoldCount"/>
                                    <Binding Path="ScrappedCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
