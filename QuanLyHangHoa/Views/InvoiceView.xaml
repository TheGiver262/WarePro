<UserControl x:Class="QuanLyHangHoa.Views.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#111827">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Mode Toggle -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16" CornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3" Margin="0,0,0,24">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileDocumentEdit" Width="24" Height="24" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ModeTitle}" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Margin="0,0,8,0"
                                 Content="HÓA ĐƠN BÁN" IsChecked="True"
                                 Command="{Binding SwitchToSalesCommand}"
                                 materialDesign:ButtonAssist.CornerRadius="8" Padding="12,8"/>
                    <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
                                 Content="HÓA ĐƠN MUA"
                                 Command="{Binding SwitchToPurchaseCommand}"
                                 materialDesign:ButtonAssist.CornerRadius="8" Padding="12,8"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Document Info -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,20,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="THÔNG TIN CHUNG" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryHueMidBrush}" Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Số hóa đơn" Margin="0,0,0,16"
                                     Text="{Binding InvoiceCode, UpdateSourceTrigger=PropertyChanged}"/>

                            <DatePicker Style="{StaticResource MaterialDesignFloatingHintDatePicker}" materialDesign:HintAssist.Hint="Ngày hóa đơn" Margin="0,0,0,16"
                                        SelectedDate="{Binding InvoiceDate}"/>

                            <DatePicker Style="{StaticResource MaterialDesignFloatingHintDatePicker}" materialDesign:HintAssist.Hint="Hạn thanh toán" Margin="0,0,0,16"
                                        SelectedDate="{Binding DueDate}"/>

                            <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0,8,0,16"/>

                            <!-- Conditional Visibility for Customer/Supplier -->
                            <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" materialDesign:HintAssist.Hint="Khách hàng" Margin="0,0,0,16"
                                      ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name"
                                      materialDesign:TextFieldAssist.HasClearButton="True"/>

                            <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" materialDesign:HintAssist.Hint="Nhà cung cấp" Margin="0,0,0,16"
                                      ItemsSource="{Binding AvailableSuppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name"
                                      materialDesign:TextFieldAssist.HasClearButton="True"/>

                            <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Đã thanh toán" Margin="0,0,0,16"
                                     Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>

                            <Border Background="{StaticResource PrimaryHueLightBrush}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PaymentStatus, StringFormat='Trạng thái: {0}'}" 
                                               Foreground="{StaticResource PrimaryHueMidBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="{Binding SaveButtonText}" Command="{Binding SaveInvoiceCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Height="45" materialDesign:ButtonAssist.CornerRadius="8" Margin="0,20,0,0"/>
                </Grid>
            </materialDesign:Card>

            <!-- Main Content: Invoice Lines -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <materialDesign:Card UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Padding="16,12" Background="#F8F9FA" CornerRadius="12,12,0,0">
                            <Grid>
                                <TextBlock Text="CHI TIẾT MẶT HÀNG" FontWeight="Bold" VerticalAlignment="Center" Foreground="#555555"/>
                                <Button Content="+ THÊM DÒNG" Command="{Binding AddLineCommand}" HorizontalAlignment="Right" 
                                        Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="32" Padding="12,0" FontSize="11" materialDesign:ButtonAssist.CornerRadius="4"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Sản phẩm" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="Name" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" Padding="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitName}" IsReadOnly="True" Width="80"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="VAT (%)" Binding="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding GrandTotal, StringFormat=N0}" IsReadOnly="True" Width="130" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="Tác vụ" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" 
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Foreground="#EF5350">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- Summary Footer -->
                <materialDesign:Card Grid.Row="1" Margin="0,16,0,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="TIỀN HÀNG" FontSize="11" Foreground="#888888" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat=N0}" FontSize="16" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="THUẾ VAT" FontSize="11" Foreground="#888888" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TaxAmount, StringFormat=N0}" FontSize="16" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TỔNG CỘNG" FontSize="11" Foreground="#888888" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryHueMidBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
