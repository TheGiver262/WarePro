<UserControl x:Class="QuanLyHangHoa.Views.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding ModeTitle}" FontSize="24" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Hoa don ban" Command="{Binding SwitchToSalesCommand}" Background="#2563EB" Foreground="White" Padding="14,8" Margin="0,0,8,0" BorderThickness="0"/>
                <Button Content="Hoa don mua" Command="{Binding SwitchToPurchaseCommand}" Background="#7C3AED" Foreground="White" Padding="14,8" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                    <TextBlock Text="Ma hoa don" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding InvoiceCode, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,14">
                    <TextBlock Text="Ngay hoa don" Foreground="White" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding InvoiceDate}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,14,14">
                    <TextBlock Text="Han thanh toan" Foreground="White" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding DueDate}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,14,14">
                    <TextBlock Text="Da thanh toan" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,14">
                    <Button Content="+ Them dong" Command="{Binding AddLineCommand}" Background="#10B981" Foreground="White" Padding="14,9" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,14,0">
                    <TextBlock Text="Khach hang" Foreground="White" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Background="#374151" Foreground="Black" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,14,0">
                    <TextBlock Text="Nha cung cap" Foreground="White" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableSuppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Background="#374151" Foreground="Black" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding PaymentStatus, StringFormat='Trang thai: {0}'}" Foreground="#A7F3D0" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="#1F2937"
                  Foreground="Black"
                  RowBackground="#374151"
                  AlternatingRowBackground="#1F2937">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="San pham" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      Foreground="Black"
                                      MinWidth="180"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Don vi" Binding="{Binding UnitName}" IsReadOnly="True" Width="0.7*"/>
                <DataGridTextColumn Header="So luong" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="0.8*"/>
                <DataGridTextColumn Header="Don gia" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="1*"/>
                <DataGridTextColumn Header="VAT" Binding="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Width="0.7*"/>
                <DataGridTextColumn Header="Tien hang" Binding="{Binding SubTotal, StringFormat=N0}" IsReadOnly="True" Width="1*"/>
                <DataGridTextColumn Header="Tien thue" Binding="{Binding TaxAmount, StringFormat=N0}" IsReadOnly="True" Width="1*"/>
                <DataGridTextColumn Header="Tong dong" Binding="{Binding GrandTotal, StringFormat=N0}" IsReadOnly="True" Width="1*"/>
                <DataGridTemplateColumn Header="Xoa" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="X"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="#EF4444"
                                    Foreground="White"
                                    Padding="6,0"
                                    Margin="5"
                                    BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{Binding SubTotal, StringFormat='Tien hang: {0:N0}'}" Foreground="White" FontWeight="SemiBold" Margin="0,0,22,0"/>
                    <TextBlock Text="{Binding TaxAmount, StringFormat='Thue: {0:N0}'}" Foreground="White" FontWeight="SemiBold" Margin="0,0,22,0"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat='Tong cong: {0:N0}'}" Foreground="#A7F3D0" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveInvoiceCommand}" Background="#6366F1" Foreground="White" Padding="18,10" FontSize="15" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
