<Window x:Class="QuanLyHangHoa.Views.ImportInstructionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="HƯỚNG DẪN NHẬP TỒN ĐẦU KỲ" Height="620" Width="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.lg}" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="*"/>    <!-- Row 1: Scrollable Content -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Footer Button -->
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="36" Height="36" VerticalAlignment="Center" Foreground="{StaticResource AppPrimaryBrush}"/>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="HƯỚNG DẪN NHẬP TỒN ĐẦU KỲ" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <TextBlock Text="Thứ tự nhập dữ liệu, các bước thực hiện và hướng dẫn khắc phục lỗi" Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,12,0">
                <StackPanel>
                    
                    <!-- 1. QUY TRÌNH 4 BƯỚC -->
                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="1. Quy trình nhập dữ liệu (4 bước)" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,10"/>
                            
                            <Grid Margin="10,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Step 1 -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,12,8">
                                    <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Chọn File: Tải file Excel (.xlsx, .xls) hoặc CSV. Hệ thống sẽ tự động quét tiêu đề cột để đoán loại dữ liệu (Sản phẩm, Hóa đơn, Số Serial...)." Style="{StaticResource TypographyBody}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <!-- Step 2 -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,12,8">
                                    <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Ánh xạ cột: So khớp các trường trong Cơ sở dữ liệu với tiêu đề cột trong file của bạn (sử dụng tính năng so khớp mờ gợi ý tự động)." Style="{StaticResource TypographyBody}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <!-- Step 3 -->
                                <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,12,8">
                                    <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Xem trước: Hệ thống hiển thị 5 dòng đầu tiên dưới dạng lưới để bạn kiểm tra tính chính xác của dữ liệu sau khi ánh xạ." Style="{StaticResource TypographyBody}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <!-- Step 4 -->
                                <Border Grid.Row="3" Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,12,0">
                                    <TextBlock Text="4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Xác nhận &amp; Lưu: Thực thi quá trình ghi dữ liệu dạng Transaction (lỗi 1 dòng sẽ hủy bỏ toàn bộ tệp để tránh rác cơ sở dữ liệu)." Style="{StaticResource TypographyBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. THỨ TỰ NHẬP LIỆU CHUẨN -->
                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="2. Thứ tự nhập dữ liệu bắt buộc" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Để tránh lỗi vi phạm khóa ngoại (foreign key) như lỗi 'Không tìm thấy sản phẩm', bạn bắt buộc phải nhập dữ liệu theo đúng trình tự sau:" Style="{StaticResource TypographyBody}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <!-- Priority List -->
                            <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Background="{StaticResource SurfaceMutedBrush}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ƯU TIÊN 1:" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" Width="90"/>
                                        <TextBlock Grid.Column="1" Text="Nhập danh mục sản phẩm (hoặc Nhóm sản phẩm) trước tiên. Sản phẩm gốc phải tồn tại trong cơ sở dữ liệu thì mới nhập được phiếu kho/hóa đơn." Style="{StaticResource TypographyBody}" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ƯU TIÊN 2:" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" Width="90"/>
                                        <TextBlock Grid.Column="1" Text="Nhập Phiếu nhập kho hoặc Danh sách số Serial có sẵn. Đây là bước nạp lượng tồn kho và đăng ký số Serial ở trạng thái 'Trong kho' (InStock)." Style="{StaticResource TypographyBody}" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ƯU TIÊN 3:" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" Width="90"/>
                                        <TextBlock Grid.Column="1" Text="Nhập Phiếu xuất kho hoặc Hóa đơn bán hàng. Các số Serial cần bán/xuất phải có sẵn từ Bước 2 mới có thể xuất thành công." Style="{StaticResource TypographyBody}" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. CÁC LỖI THƯỜNG GẶP -->
                    <StackPanel>
                        <TextBlock Text="3. Các lỗi thường gặp và cách xử lý" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,10"/>

                        <!-- Error 1 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="• Lỗi không tìm thấy sản phẩm '[Mã]' khi nhập phiếu/hóa đơn:" FontWeight="Bold" Style="{StaticResource TypographyBody}" TextWrapping="Wrap"/>
                            <TextBlock Text="  => Nguyên nhân: Mã sản phẩm trong file hóa đơn/phiếu nhập chưa tồn tại trong danh mục sản phẩm của hệ thống." Margin="0,2,0,2" Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                            <TextBlock Text="  => Khắc phục: Tiến hành import danh mục sản phẩm chứa mã sản phẩm này trước." Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Error 2 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="• Lỗi trùng lặp khóa hoặc giá trị đã tồn tại (Unique Constraint):" FontWeight="Bold" Style="{StaticResource TypographyBody}" TextWrapping="Wrap"/>
                            <TextBlock Text="  => Nguyên nhân: Bạn cố gắng nhập một mã hóa đơn, mã phiếu nhập/xuất đã được ghi sổ trước đó trong hệ thống." Margin="0,2,0,2" Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                            <TextBlock Text="  => Khắc phục: Đổi mã phiếu/hóa đơn trong file Excel thành mã mới chưa từng sử dụng." Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Error 3 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="• Lỗi sai định dạng số hoặc ngày tháng:" FontWeight="Bold" Style="{StaticResource TypographyBody}" TextWrapping="Wrap"/>
                            <TextBlock Text="  => Nguyên nhân: Định dạng cột Số lượng, Đơn giá chứa chữ cái hoặc dùng sai dấu phân cách thập phân. Cột Ngày tháng bị nhập sai định dạng." Margin="0,2,0,2" Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                            <TextBlock Text="  => Khắc phục: Định dạng cột Excel dưới dạng số chuẩn (Number) và cột ngày tháng theo dạng dd/MM/yyyy hoặc yyyy-MM-dd." Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Error 4 -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="• Lỗi số Serial không có sẵn trong kho khi xuất kho:" FontWeight="Bold" Style="{StaticResource TypographyBody}" TextWrapping="Wrap"/>
                            <TextBlock Text="  => Nguyên nhân: Các số Serial khai báo trong file xuất kho chưa được nhập kho hoặc đã bị bán, bảo hành." Margin="0,2,0,2" Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                            <TextBlock Text="  => Khắc phục: Nhập kho (tăng tồn) cho các số Serial đó trước thông qua tệp nhập kho hoặc nhập danh sách serial có sẵn trước." Style="{StaticResource TypographyCaption}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Close Button -->
            <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Click="Close_Click" Width="160" Height="36" HorizontalAlignment="Center">
                <TextBlock Text="ĐÓNG HƯỚNG DẪN" Style="{StaticResource TypographyButtonText}"/>
            </Button>
        </Grid>
    </Border>
</Window>
