<Window x:Class="QuanLyHangHoa.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
        mc:Ignorable="d"
        Title="Đăng Nhập Khai Báo" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        x:Name="LoginWindow">

    <!-- Cấu hình DataContext liên kết giao diện với ViewModel của màn Đăng nhập -->
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <!-- Border chính tạo viền bo tròn đổ bóng cho cửa sổ -->
    <Border Background="White" CornerRadius="15" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Gray" Direction="-90" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <!-- Cho phép người dùng kéo thả cửa sổ -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Nút đóng cửa sổ bên phải góc (X) -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                    Click="BtnClose_Click">
                <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="Gray"/>
            </Button>

            <!-- Tiêu đề logo -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,20">
                <materialDesign:PackIcon Kind="Storefront" Width="60" Height="60" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="QUẢN LÝ HÀNG HOÁ" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Ô nhập Tài khoản (Username) liên kết (Bind) tới thuộc tính Username trong ViewModel -->
            <TextBox Grid.Row="2" Margin="10,10,10,20" 
                     materialDesign:HintAssist.Hint="Tên đăng nhập (Username)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Ô nhập Mật khẩu (Do WPF PasswordBox không hỗ trợ data binding dễ dàng, xử lý riêng tại Code-behind nếu cần, 
                 Tạm thời demo nhanh, sử dụng TextBox ẩn hoặc thư viện. Để giữ mã đơn giản và có MVVM Bind, ta có thể kết hợp Event hoặc bind text) -->
            <PasswordBox Grid.Row="3" Margin="10,0,10,20" x:Name="txtPassword"
                         materialDesign:HintAssist.Hint="Mật khẩu (Password)"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         PasswordChanged="TxtPassword_PasswordChanged"/>

            <StackPanel Grid.Row="4" Margin="10,0">
                <!-- Hiển thị Dòng thông báo lỗi (Error message đỏ) -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" 
                           HorizontalAlignment="Center" Margin="0,0,0,10" />

                <!-- Nút Login kết nối với Lệnh LoginCommand. Lệnh (Command) này sẽ chạy khi button được click -->
                <!-- Tham số `CommandParameter` gửi chính cửa sổ này về để làm thao tác Close nó đi khi login thành công -->
                <Button Content="ĐĂNG NHẬP" Height="45"
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=LoginWindow}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
