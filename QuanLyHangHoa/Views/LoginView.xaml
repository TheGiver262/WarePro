<Window x:Class="QuanLyHangHoa.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
        xmlns:converters="clr-namespace:QuanLyHangHoa.Converters"
        mc:Ignorable="d"
        Title="Đăng Nhập - Inventory Pro Max" Height="600" Width="460"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        x:Name="LoginWindow">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <!-- Local override for Login TextBoxes - Reverted to Outlined as per user request -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="False"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
            <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="{StaticResource Margin.Bottom.md}"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="{StaticResource Radius.lg}" Margin="{StaticResource Spacing.md}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Decorative Bar -->
            <Grid Grid.Row="0" Margin="{StaticResource PagePadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Close -->
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Form -->
                    <RowDefinition Height="Auto"/> <!-- Error -->
                    <RowDefinition Height="Auto"/> <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- Close Button -->
                <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        Width="32" Height="32"
                        Click="BtnClose_Click" Margin="0,-8,-16,0">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <!-- Brand Header -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="{StaticResource Margin.Bottom.lg}">
                    <Border Width="72" Height="72" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.lg}" Margin="{StaticResource Margin.Bottom.md}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#10000000" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Warehouse" Width="40" Height="40" Foreground="{StaticResource AppTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="INVENTORY" Style="{StaticResource TypographyDisplay}" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="PHẦN MỀM QUẢN LÝ KHO HÀNG" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Login Form -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource LoginTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Tên đăng nhập"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <PasswordBox x:Name="txtPassword"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 materialDesign:HintAssist.Hint="Mật khẩu"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.FloatingScale="0.85"
                                 PasswordChanged="TxtPassword_PasswordChanged"
                                 FontSize="15" Margin="{StaticResource Margin.Bottom.sm}"
                                 BorderBrush="{StaticResource AppBorderBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{Binding StartupMessage}" Foreground="{StaticResource AppSecondaryBrush}"
                           FontSize="12" HorizontalAlignment="Center" Margin="{StaticResource Spacing.sm}"
                           Visibility="{Binding StartupMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Error Message -->
                <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="{StaticResource Spacing.sm}" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Actions -->
                <StackPanel Grid.Row="4" Margin="{StaticResource Margin.Top.md}">
                    <Button Content="ĐĂNG NHẬP" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoginCommand}" IsEnabled="{Binding IsDatabaseReady}" 
                            CommandParameter="{Binding ElementName=LoginWindow}"/>
                    
                    <TextBlock Text="Quên mật khẩu? Liên hệ quản trị viên" 
                               Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" 
                               HorizontalAlignment="Center" Margin="{StaticResource Margin.Top.lg}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
