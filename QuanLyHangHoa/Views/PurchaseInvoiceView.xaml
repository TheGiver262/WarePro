<UserControl x:Class="QuanLyHangHoa.Views.PurchaseInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyHangHoa.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24">
        <TabControl materialDesign:ColorZoneAssist.Mode="Standard"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            
            <!-- LIST TAB -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 1: Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Filter Card -->
                        <RowDefinition Height="*"/>    <!-- Row 3: DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- ROW 1: HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="HÓA ĐƠN NHẬP HÀNG" 
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Text="Quản lý và theo dõi các hóa đơn nhập hàng" 
                                       Style="{StaticResource SubtitleText}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="TẠO TỪ PHIẾU NHẬP" 
                                    Style="{StaticResource AppSecondaryButton}" 
                                    Margin="0,0,12,0" 
                                    Height="40" Padding="20,0"/>
                            <Button Command="{Binding ResetFormCommand}"
                                    Style="{StaticResource AppPrimaryButton}" 
                                    Height="40" Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="TẠO MỚI" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 2: FILTER CARD -->
                    <materialDesign:Card Grid.Row="1" Margin="0,0,0,24" Padding="16" Style="{StaticResource AppCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- MAIN FILTER ROW -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="SỐ HOÁ ĐƠN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding SearchInvoiceCode, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Mã hoá đơn..."
                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                             Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding SearchSupplierName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Tìm nhà cung cấp..."
                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                             Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Command="{Binding RefreshCommand}"
                                            Style="{StaticResource AppSecondaryButton}" 
                                            Width="36" Height="36" Padding="0" Margin="0,0,8,0"
                                            ToolTip="Làm mới bộ lọc">
                                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                                    </Button>

                                    <Button Command="{Binding ToggleAdvancedFilterCommand}"
                                            Style="{StaticResource AppSecondaryButton}" 
                                            Width="180" Height="36" Margin="0,0,8,0"
                                            ToolTip="Bộ lọc nâng cao">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="BỘ LỌC NÂNG CAO" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Content="XUẤT EXCEL" 
                                            Style="{StaticResource AppPrimaryButton}" 
                                            Height="36" Padding="16,0" FontSize="12">
                                        <Button.ToolTip>Xuất danh sách ra tệp Excel</Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ADVANCED FILTER ROW (Collapsible) -->
                            <Grid Grid.Row="1" 
                                  Visibility="{Binding IsAdvancedFilterOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Date Filter Group -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="TỪ NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding FilterStartDate}"
                                                 materialDesign:HintAssist.Hint="Từ ngày..."
                                                 Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding FilterEndDate}"
                                                 materialDesign:HintAssist.Hint="Đến ngày..."
                                                 Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Price Range Filter -->
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="KHOẢNG GIÁ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FilterMinTotal, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Giá từ..."
                                                 Height="32" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="4,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding FilterMaxTotal, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Giá đến..."
                                                 Height="32" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Status Filter -->
                                <StackPanel Grid.Column="3" Margin="0,0,0,0">
                                    <TextBlock Text="TRẠNG THÁI THANH TOÁN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailablePaymentStatuses}"
                                              SelectedItem="{Binding SelectedFilterPaymentStatus}"
                                              Height="32" VerticalContentAlignment="Center"
                                              Width="200" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- ROW 3: DATAGRID -->
                    <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding Invoices}"
                                      SelectedItem="{Binding SelectedInvoice}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SỐ HĐ" Binding="{Binding InvoiceCode}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextBold}"/>
                                    <DataGridTextColumn Header="NGÀY NHẬP" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yyyy'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                    <DataGridTextColumn Header="NHÀ CUNG CẤP" Binding="{Binding Supplier.DisplayName}" Width="*" ElementStyle="{StaticResource AppDataGridTextBold}"/>
                                    <DataGridTextColumn Header="TRƯỚC THUẾ" Binding="{Binding SubTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextRight}"/>
                                    <DataGridTextColumn Header="THUẾ" Binding="{Binding TaxAmount, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextRight}"/>
                                    <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding GrandTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextRightBold}"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI TT" Width="Auto" CellTemplate="{StaticResource PaymentStatusBadgeTemplate}"/>
                                    <DataGridTemplateColumn Header="THAO TÁC" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=EyeOutline}" 
                                                            Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4" ToolTip="Xem chi tiết"/>
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=PencilOutline}" 
                                                            Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4" Margin="4,0,0,0" ToolTip="Chỉnh sửa"/>
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=PrinterOutline}" 
                                                            Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4" Margin="4,0,0,0" ToolTip="In hóa đơn"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Row 1: Footer -->
                            <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource AppSecondaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}Hiện có {0} hoá đơn · {1} Đã thanh toán · {2} TT 1 phần · {3} Chưa TT · {4} Quá hạn">
                                            <Binding Path="Invoices.Count"/>
                                            <Binding Path="PaidCount"/>
                                            <Binding Path="PartialCount"/>
                                            <Binding Path="UnpaidCount"/>
                                            <Binding Path="OverdueCount"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- CREATE TAB -->
            <TabItem Header="TẠO MỚI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,24,0,0">
                        <materialDesign:Card UniformCornerRadius="12" Padding="32" Background="White"
                                             materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header -->
                                    <RowDefinition Height="Auto"/> <!-- Info Grid -->
                                    <RowDefinition Height="Auto"/> <!-- Ghi chú -->
                                    <RowDefinition Height="*"/>    <!-- Products Table -->
                                    <RowDefinition Height="Auto"/> <!-- Summary & Actions -->
                                </Grid.RowDefinitions>

                                <!-- ROW 0: HEADER -->
                                <Grid Grid.Row="0" Margin="0,0,0,32">
                                    <StackPanel>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
                                                    <Setter Property="Text" Value="TẠO MỚI HÓA ĐƠN NHẬP"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                                                            <Setter Property="Text" Value="CHI TIẾT HÓA ĐƠN NHẬP"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                            <Setter Property="Text" Value="CHỈNH SỬA HÓA ĐƠN NHẬP"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Nhập thông tin chi tiết hàng hóa và thanh toán" Style="{StaticResource SubtitleText}"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="TRỞ LẠI DANH SÁCH" 
                                            Click="BackToList_Click"
                                            Style="{StaticResource AppSecondaryButton}"
                                            Height="36" Padding="16,0"/>
                                </Grid>

                                <!-- ROW 1: INFO GRID (3 COLUMNS) -->
                                <Grid Grid.Row="1" Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column 0: Invoice Details -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                                        <TextBlock Text="SỐ HOÁ ĐƠN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding InvoiceCode}"
                                                 Height="32" VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="NGÀY LẬP HOÁ ĐƠN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding InvoiceDate}"
                                                    Height="32" VerticalContentAlignment="Center"
                                                    IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <!-- Column 1: Partner & Document -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,16,16">
                                        <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding AvailableSuppliers}"
                                                  SelectedItem="{Binding SelectedSupplier}"
                                                  DisplayMemberPath="DisplayName"
                                                  Height="32" VerticalContentAlignment="Center"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,16,0">
                                        <TextBlock Text="PHIẾU NHẬP KHO" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding AvailableStockIns}"
                                                  SelectedItem="{Binding SelectedStockIn}"
                                                  DisplayMemberPath="StockInCode"
                                                  Height="32" VerticalContentAlignment="Center"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <!-- Column 2: Payment & Terms -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="16,0,0,16">
                                        <TextBlock Text="HẠN THANH TOÁN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding DueDate}"
                                                    Height="32" VerticalContentAlignment="Center"
                                                    IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock Text="TRẠNG THÁI THANH TOÁN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding AvailablePaymentStatuses}"
                                                  SelectedItem="{Binding SelectedPaymentStatus}"
                                                  Height="32" VerticalContentAlignment="Center"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 2: GHI CHÚ (FULL WIDTH) -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,32">
                                    <TextBlock Text="GHI CHÚ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Notes}"
                                             materialDesign:HintAssist.Hint="Nhập nội dung ghi chú hoá đơn..."
                                             AcceptsReturn="True" Height="60"
                                             VerticalContentAlignment="Top"
                                             IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                </StackPanel>

                                <!-- ROW 3: PRODUCTS TABLE -->
                                <Grid Grid.Row="3">
                                    <StackPanel>
                                        <TextBlock Text="CHI TIẾT SẢN PHẨM" FontWeight="Bold" Margin="0,0,0,16" FontSize="13" Foreground="{StaticResource AppTertiaryBrush}"/>
                                        <DataGrid ItemsSource="{Binding Lines}" 
                                                  AutoGenerateColumns="False" 
                                                  CanUserAddRows="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  GridLinesVisibility="None"
                                                  IsReadOnly="{Binding IsViewMode}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="MÃ SẢN PHẨM" Binding="{Binding SelectedProduct.ProductCode}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding SelectedProduct}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      VerticalAlignment="Center"
                                                                      materialDesign:TextFieldAssist.HasClearButton="True"
                                                                      IsEnabled="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                                <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding UnitPrice, StringFormat='N0', UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource AppDataGridTextRightBold}"/>
                                                <DataGridTextColumn Header="THUẾ (%)" Binding="{Binding TaxRate, StringFormat='P0', UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                                <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding TotalPrice, StringFormat='N0'}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource AppDataGridTextRightBold}"/>
                                                
                                                <DataGridTemplateColumn Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=Close, Size=18}"
                                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Foreground="Red"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Command="{Binding AddLineCommand}" 
                                                 Style="{StaticResource MaterialDesignFlatButton}"
                                                 HorizontalAlignment="Left" Margin="0,12,0,0"
                                                 Visibility="{Binding IsViewMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Width="18" Height="18"/>
                                                <TextBlock Text="THÊM DÒNG SẢN PHẨM" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 4: SUMMARY & ACTIONS -->
                                <Grid Grid.Row="4" Margin="0,40,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="500"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Info or Empty -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,40,0">
                                        <Border Background="#F8F9FA" Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="THÔNG TIN NHẬP HÀNG" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AppTertiaryBrush}" Margin="0,0,0,12"/>
                                                <TextBlock Text="• Hoá đơn nhập sẽ cập nhật tồn kho và công nợ nhà cung cấp." FontSize="12" Foreground="{StaticResource AppSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="• Kiểm tra đối chiếu chứng từ gốc trước khi lưu hệ thống." FontSize="12" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: Summary Card (Increased Size) -->
                                    <StackPanel Grid.Column="1">
                                        <materialDesign:Card Padding="32" Background="#FAFAFA" UniformCornerRadius="12" materialDesign:ShadowAssist.ShadowDepth="Depth1" Margin="0,0,0,24">
                                            <StackPanel>
                                                <!-- Calculation Rows -->
                                                <Grid Margin="0,0,0,16">
                                                    <TextBlock Text="Tổng tiền hàng (chưa thuế)" FontSize="14" Foreground="{StaticResource AppSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding FormSubTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,16">
                                                    <TextBlock Text="Thuế giá trị gia tăng (VAT)" FontSize="14" Foreground="{StaticResource AppSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding FormTaxAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold"/>
                                                </Grid>
                                                
                                                <Separator Margin="0,8,0,20" Background="{StaticResource AppBorderBrush}"/>
                                                
                                                <Grid Margin="0,0,0,24">
                                                    <TextBlock Text="TỔNG CỘNG THANH TOÁN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormTotalAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}"/>
                                                </Grid>

                                                <!-- Payment Input (More prominent) -->
                                                <Border Background="White" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" Margin="0,0,0,16">
                                                    <Grid>
                                                        <TextBlock Text="SỐ TIỀN ĐÃ THANH TOÁN" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppSecondaryBrush}"/>
                                                        <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}"
                                                                 HorizontalAlignment="Right" Width="200" HorizontalContentAlignment="Right"
                                                                 FontSize="20" FontWeight="Bold" BorderThickness="0"
                                                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                                 materialDesign:TextFieldAssist.HasClearButton="False"
                                                                 IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Balance -->
                                                <Grid Margin="16,0">
                                                    <TextBlock Text="CÒN LẠI (CÔNG NỢ NCC)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#D32F2F"/>
                                                    <TextBlock Text="{Binding FormRemainingAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="#D32F2F"/>
                                                </Grid>
                                            </StackPanel>
                                        </materialDesign:Card>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="HỦY BỎ" 
                                                    Click="BackToList_Click"
                                                    Style="{StaticResource AppSecondaryButton}" 
                                                    Width="120" Height="44" Margin="0,0,12,0"/>
                                            
                                            <Button Command="{Binding SaveInvoiceCommand}"
                                                     Width="180" Height="44"
                                                     Visibility="{Binding IsViewMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
                                                        <Setter Property="Content" Value="LƯU HOÁ ĐƠN"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                                  <Setter Property="Content" Value="CẬP NHẬT"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
