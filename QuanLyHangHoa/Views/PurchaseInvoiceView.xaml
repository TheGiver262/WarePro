<UserControl x:Class="QuanLyHangHoa.Views.PurchaseInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.DataContext>
        <vm:PurchaseInvoiceViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Main Content (Tabs) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileImport" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="HÓA ĐƠN NHẬP HÀNG" Style="{DynamicResource TypographyH2}"/>
                        <TextBlock Text="Quản lý nhập kho và đối soát nhà cung cấp" Style="{DynamicResource TypographyCaption}"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="XUẤT BÁO CÁO" Command="{Binding ExportCommand}" Style="{StaticResource AppSecondaryButton}" Height="36" Padding="16,0" Margin="0,0,12,0"/>
                    <Button Content="TẢI LẠI" Command="{Binding LoadDataCommand}" Style="{StaticResource AppPrimaryButton}" Height="36" Padding="16,0"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Main Content (Tabs) -->
            <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignNavigationRailTabControl}">
                <!-- Tab 1: List -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Height="40">
                            <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center"/>
                            <TextBlock Text="DANH SÁCH PHIẾU NHẬP" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Search & Stats Bar (Tab-specific) -->
                        <materialDesign:Card Grid.Row="0" Style="{StaticResource AppCard}" Margin="0,16,0,16" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="24" Height="48" Padding="16,0" Width="450">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" 
                                                     materialDesign:HintAssist.Hint="Tìm kiếm phiếu nhập..."
                                                     FontSize="14">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Padding="16,8" Background="#F3E5F5" CornerRadius="8" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="TỔNG PHIẾU NHẬP" Style="{StaticResource TypographyCaption}" Foreground="#7B1FA2"/>
                                            <TextBlock Text="{Binding TotalPurchaseCount}" Style="{DynamicResource TypographyH3}" Foreground="#7B1FA2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="16,8" Background="#EFEBE9" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="TỔNG GIÁ TRỊ" Style="{StaticResource TypographyCaption}" Foreground="#5D4037"/>
                                            <TextBlock Text="{Binding TotalPurchaseAmount, StringFormat='N0'}" Style="{DynamicResource TypographyH3}" Foreground="#5D4037"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Row 1: DataGrid Section -->
                        <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="380"/>
                                </Grid.ColumnDefinitions>

                                <!-- Table Section -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Border Padding="16,12" Background="{StaticResource AppBackgroundBrush}" BorderThickness="0,0,1,1" BorderBrush="{StaticResource AppBorderBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="TruckDelivery" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                                            <TextBlock Text="LỊCH SỬ NHẬP KHO" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              RowHeight="52" BorderThickness="0,0,1,0" BorderBrush="{StaticResource AppBorderBrush}" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="MÃ PHIẾU" Binding="{Binding InvoiceCode}" Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                                            <DataGridTextColumn Header="NGÀY NHẬP" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yyyy'}" Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                                            <DataGridTextColumn Header="NHÀ CUNG CẤP" Binding="{Binding Supplier.DisplayName}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                                            <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding GrandTotal, StringFormat='N0'}" Width="150" FontWeight="Bold" Foreground="{StaticResource AppTertiaryBrush}" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <!-- Detail Section (Sidebar inside Tab) -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                <Border Padding="16,12" Background="{StaticResource AppBackgroundBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppBorderBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" Foreground="{StaticResource AppPrimaryBrush}"/>
                                        <TextBlock Text="CHI TIẾT PHIẾU NHẬP" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <Border Padding="20">
                                        <StackPanel>
                                        <StackPanel Margin="0,0,0,24">
                                            <TextBlock Text="MÃ PHIẾU" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding SelectedInvoice.InvoiceCode}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding SelectedInvoice.Supplier.DisplayName}" FontWeight="SemiBold" FontSize="15"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,24">
                                            <TextBlock Text="NGÀY NHẬP" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding SelectedInvoice.InvoiceDate, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="14"/>
                                        </StackPanel>
                                        
                                        <Separator Margin="0,0,0,24" Background="{StaticResource AppBorderBrush}"/>
                                        
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Cộng tiền hàng:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedInvoice.SubTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Thuế GTGT:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedInvoice.TaxAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                        
                                        <Border Background="{StaticResource AppBackgroundBrush}" Padding="16" CornerRadius="8" Margin="0,12,0,24">
                                            <Grid>
                                                <TextBlock Text="TỔNG GIÁ TRỊ" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedInvoice.GrandTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Black" FontSize="20" Foreground="{StaticResource AppTertiaryBrush}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="GHI CHÚ" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <Border Background="{StaticResource AppBackgroundBrush}" Padding="12" CornerRadius="4" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding SelectedInvoice.Notes}" TextWrapping="Wrap" FontStyle="Italic" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedInvoice.Notes}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="Không có ghi chú."/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedInvoice.Notes}" Value="">
                                                                    <Setter Property="Text" Value="Không có ghi chú."/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
                
                <!-- Tab 2: Create -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Height="40">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" VerticalAlignment="Center"/>
                            <TextBlock Text="TẠO PHIẾU NHẬP MỚI" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <materialDesign:Card Style="{StaticResource AppCard}" Margin="0,16,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Padding="20,16" Background="{StaticResource AppBackgroundBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppBorderBrush}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePlusOutline" VerticalAlignment="Center" Foreground="{StaticResource AppSuccessBrush}" Width="20" Height="20"/>
                                        <TextBlock Text="NHẬP THÔNG TIN PHIẾU NHẬP KHO" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="LÀM MỚI BIỂU MẪU" Command="{Binding ResetFormCommand}" Style="{StaticResource AppSecondaryButton}" Height="32" Padding="16,0" FontSize="11"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Border Padding="24">
                                    <StackPanel>
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="MÃ PHIẾU" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding InvoiceCode}" Style="{StaticResource AppTextBoxStyle}" Height="40" Padding="12,0"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                            <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding AvailableSuppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="DisplayName" Style="{StaticResource AppComboBoxStyle}" Height="40"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="NGÀY NHẬP" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <DatePicker SelectedDate="{Binding InvoiceDate}" Style="{StaticResource AppDatePickerStyle}" Height="40"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Margin="0,0,0,24">
                                        <StackPanel>
                                            <Border Background="{StaticResource SidebarBgDarkerBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="PackageVariant" Foreground="White" VerticalAlignment="Center" Width="18" Height="18"/>
                                                        <TextBlock Text="DANH SÁCH MẶT HÀNG NHẬP" Style="{StaticResource TypographyLabel}" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" Content="+ THÊM SẢN PHẨM" Command="{Binding AddLineCommand}" Style="{StaticResource AppPrimaryButton}" Height="30" Padding="16,0" FontSize="11" Background="{StaticResource AppSuccessBrush}" BorderBrush="{StaticResource AppSuccessBrush}"/>
                                                </Grid>
                                            </Border>
                                            
                                            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeight="50">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                          SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                                          DisplayMemberPath="DisplayName" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                                          VerticalAlignment="Center" FontSize="13" Margin="12,0"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                                                    <DataGridTextColumn Header="ĐƠN GIÁ (VNĐ)" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                                                    <DataGridTemplateColumn Header="THÀNH TIỀN" Width="150">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding TotalPrice, StringFormat='N0'}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource AppTertiaryBrush}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource AppErrorBrush}" Width="36" Height="36"
                                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20"/>
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel>
                                        <TextBlock Text="GHI CHÚ NHẬP KHO" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding Notes}" Style="{StaticResource AppTextBoxStyle}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12"/>
                                    </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>

                            <Border Grid.Row="2" Padding="24,16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Text="TỔNG GIÁ TRỊ NHẬP:" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='N0'}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <Button Content="XÁC NHẬN &amp; LƯU PHIẾU NHẬP" Command="{Binding SaveInvoiceCommand}" Style="{StaticResource AppPrimaryButton}" Width="250" Height="48" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
