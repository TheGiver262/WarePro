<UserControl x:Class="QuanLyHangHoa.Views.PurchaseInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.DataContext>
        <vm:PurchaseInvoiceViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,24" UniformCornerRadius="12" Background="{StaticResource PrimaryIndigoBrush}" materialDesign:ElevationAssist.Elevation="Dp2" Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="White" Width="48" Height="48" CornerRadius="12" Opacity="0.2"/>
                        <Border Width="48" Height="48" CornerRadius="12">
                            <materialDesign:PackIcon Kind="FileImport" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="HÓA ĐƠN NHẬP HÀNG" FontSize="20" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="TẠO HÓA ĐƠN MỚI" Command="{Binding ResetFormCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="White" BorderBrush="White" BorderThickness="1"
                                materialDesign:ButtonAssist.CornerRadius="8" Height="40"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Statistics Summary Bar (Pro Max) -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,24" UniformCornerRadius="12" Background="#F1F5F9" materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid Margin="20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG HÓA ĐƠN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPurchaseCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="12,4"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG TIỀN NHẬP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPurchaseAmount, StringFormat='N0'}" FontSize="20" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Separator Grid.Column="3" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="12,4"/>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="ĐÃ TRẢ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPaidAmount, StringFormat='N0'}" FontSize="20" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Separator Grid.Column="5" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="12,4"/>

                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                        <TextBlock Text="CÒN NỢ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalDebtAmount, StringFormat='N0'}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Main: Invoices List (LEFT) -->
                <TabControl Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource MaterialDesignNavigatilRailTabControl}">
                    <TabItem Header="DANH SÁCH">
                        <materialDesign:Card UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Padding="20,16" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Database" VerticalAlignment="Center" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                                        <TextBlock Text="DANH SÁCH HÓA ĐƠN ĐÃ LƯU" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Margin="0"
                                          Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <materialDesign:DataGridTextColumn Header="Mã HĐ" Binding="{Binding InvoiceCode}" Width="110"/>
                                        <materialDesign:DataGridTextColumn Header="Ngày" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                                        <materialDesign:DataGridTextColumn Header="Nhà Cung Cấp" Binding="{Binding Supplier.DisplayName}" Width="*"/>
                                        <materialDesign:DataGridTextColumn Header="Tổng Tiền" Binding="{Binding GrandTotal, StringFormat='N0'}" Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                                        <materialDesign:DataGridTextColumn Header="Đã Trả" Binding="{Binding PaidAmount, StringFormat='N0'}" Width="110"/>
                                        <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,2" CornerRadius="12" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã thanh toán">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                                        <Setter Property="Background" Value="#FEF9C3"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Thanh toán một phần">
                                                                        <Setter Property="Background" Value="#FEF9C3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding PaymentStatus}" FontSize="12" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                                            <Setter Property="Foreground" Value="#166534"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã thanh toán">
                                                                            <Setter Property="Foreground" Value="#166534"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                                            <Setter Property="Foreground" Value="#854D0E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Thanh toán một phần">
                                                                            <Setter Property="Foreground" Value="#854D0E"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <materialDesign:DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>
                    </TabItem>
                    
                    <TabItem Header="LẬP HÓA ĐƠN NHẬP">
                        <materialDesign:Card UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Padding="20,16" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CartPlus" VerticalAlignment="Center" Foreground="#1E40AF"/>
                                            <TextBlock Text="THÔNG TIN HÓA ĐƠN NHẬP MỚI" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="#1E40AF"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Content="LÀM MỚI" Command="{Binding ResetFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" FontSize="12" materialDesign:ButtonAssist.CornerRadius="6"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="24">
                                        <Grid Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBox Grid.Column="0" Margin="0,0,12,0" materialDesign:HintAssist.Hint="Mã hóa đơn" Text="{Binding InvoiceCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                            <ComboBox Grid.Column="1" Margin="0,0,12,0" materialDesign:HintAssist.Hint="Nhà cung cấp" ItemsSource="{Binding AvailableSuppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="DisplayName" Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                                            <DatePicker Grid.Column="2" materialDesign:HintAssist.Hint="Ngày nhập" SelectedDate="{Binding InvoiceDate}" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                                        </Grid>

                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <TextBlock Text="DANH SÁCH MẶT HÀNG" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                                                    <Button HorizontalAlignment="Right" Content="THÊM MẶT HÀNG" Command="{Binding AddLineCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource PrimaryIndigoBrush}" Height="32" FontSize="12"/>
                                                </Grid>
                                                
                                                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}" Background="Transparent">
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Sản phẩm" Width="*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                              SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                                              DisplayMemberPath="DisplayName" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <materialDesign:DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                                                        <materialDesign:DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                                                        <DataGridTemplateColumn Header="" Width="50">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="#EF4444" Width="32" Height="32" Padding="0"
                                                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <TextBox materialDesign:HintAssist.Hint="Ghi chú hóa đơn" Text="{Binding Notes}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                        
                                        <Grid Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="CashMultiple" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                                <TextBlock Text="Số tiền đã trả:" VerticalAlignment="Center" Margin="8,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" Width="150" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" Margin="0"/>
                                            </StackPanel>
                                            
                                            <Button HorizontalAlignment="Right" Content="LƯU HÓA ĐƠN" Command="{Binding SaveInvoiceCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E40AF" BorderBrush="#1E40AF" Width="200" Height="48"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </materialDesign:Card>
                    </TabItem>
                </TabControl>

                <!-- Sidebar: Details (RIGHT) -->
                <materialDesign:Card Grid.Column="1" Margin="12,0,0,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource PrimaryIndigoBrush}" Padding="16,12" CornerRadius="12,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Chi tiết hóa đơn" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Padding="20">
                            <StackPanel>
                                <TextBox materialDesign:HintAssist.Hint="Mã HĐ" Text="{Binding SelectedInvoice.InvoiceCode}" IsReadOnly="True" Margin="0,0,0,16" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <TextBox materialDesign:HintAssist.Hint="Nhà cung cấp" Text="{Binding SelectedInvoice.Supplier.DisplayName}" IsReadOnly="True" Margin="0,0,0,16" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <TextBox materialDesign:HintAssist.Hint="Ngày lập" Text="{Binding SelectedInvoice.InvoiceDate, StringFormat='dd/MM/yyyy HH:mm'}" IsReadOnly="True" Margin="0,0,0,16" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                
                                <Separator Margin="0,8,0,16" Background="{StaticResource AppBorderBrush}"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Cộng tiền hàng:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoice.SubTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Thuế GTGT:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoice.TaxAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="TỔNG CỘNG:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoice.GrandTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                                </Grid>

                                <Separator Margin="0,8,0,16" Background="{StaticResource AppBorderBrush}"/>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Đã thanh toán:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoice.PaidAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#166534"/>
                                </Grid>
                                
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Ghi chú" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedInvoice.Notes}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontStyle="Italic"/>
                                        <TextBlock Text="Không có ghi chú" FontSize="13" Foreground="#94A3B8" FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedInvoice.Notes}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedInvoice.Notes}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        
                                        <Separator Margin="0,12,0,8" Background="#E2E8F0"/>
                                        <Grid>
                                            <TextBlock Text="Thời gian tạo" FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding SelectedInvoice.CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Content="THANH TOÁN" Margin="0,8,0,0" 
                                        Command="{Binding DataContext.OpenPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding SelectedInvoice}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{StaticResource PrimaryIndigoBrush}" BorderBrush="{StaticResource PrimaryIndigoBrush}"
                                        Height="44" materialDesign:ButtonAssist.CornerRadius="8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
