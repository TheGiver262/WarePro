<Window x:Class="QuanLyHangHoa.Views.ProductSerialEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Chỉnh sửa Serial" Height="600" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="CHỈNH SỬA THÔNG TIN" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppPrimaryBrush}"/>
            <TextBlock Text="Cập nhật trạng thái và ghi chú cho số Serial" FontSize="12" Foreground="{StaticResource AppSecondaryBrush}" Margin="0,4,0,0"/>
            <Separator Margin="0,8,0,0" Background="{StaticResource AppPrimaryBrush}" Height="1" Opacity="0.3"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Readonly info section -->
                <Border Background="{StaticResource AppBackgroundBrush}" Padding="16" CornerRadius="8" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="SỐ SERIAL" Style="{StaticResource TypographyCaption}" FontWeight="Bold" Margin="0,0,0,4" Foreground="{StaticResource AppSecondaryBrush}"/>
                            <TextBlock Text="{Binding SerialNumber}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="SẢN PHẨM" Style="{StaticResource TypographyCaption}" FontWeight="Bold" Margin="0,0,0,4" Foreground="{StaticResource AppSecondaryBrush}"/>
                            <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Editable fields section -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Trạng thái hiện tại" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"
                              Style="{StaticResource AppComboBoxStyle}" Height="45"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Ghi chú chi tiết" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource AppTextBoxStyle}" 
                             materialDesign:HintAssist.Hint="Nhập thông tin ghi chú về tình trạng Serial này..."
                             Height="120" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="12"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="ĐÓNG" Width="100" Height="40" Margin="0,0,12,0"
                        Command="{Binding CancelCommand}"/>
                <Button Style="{StaticResource AppPrimaryButton}" Content="LƯU THÔNG TIN" Width="150" Height="40" 
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
