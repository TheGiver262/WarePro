<UserControl x:Class="QuanLyHangHoa.Views.SalesInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyHangHoa.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24">
        <TabControl materialDesign:ColorZoneAssist.Mode="Standard"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            
            <!-- LIST TAB -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 1: Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Filter Card -->
                        <RowDefinition Height="*"/>    <!-- Row 3: DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- ROW 1: HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="HÓA ĐƠN BÁN HÀNG" 
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Text="Quản lý và theo dõi các hóa đơn bán hàng cho khách hàng" 
                                       Style="{StaticResource SubtitleText}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="TẠO TỪ PHIẾU XUẤT" 
                                    Style="{StaticResource AppSecondaryButton}" 
                                    Margin="0,0,12,0" 
                                    Height="40" Padding="20,0"/>
                            <Button Command="{Binding ResetFormCommand}"
                                    Style="{StaticResource AppPrimaryButton}" 
                                    Height="40" Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="TẠO MỚI" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 2: FILTER CARD -->
                    <materialDesign:Card Grid.Row="1" Margin="0,0,0,24" Padding="16" Style="{StaticResource AppCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="SỐ HOÁ ĐƠN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SearchInvoiceCode, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Mã hoá đơn..."
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SearchCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Tên khách hàng..."
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="TỪ NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding FilterStartDate}"
                                             materialDesign:HintAssist.Hint="Từ ngày"
                                             Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding FilterEndDate}"
                                             materialDesign:HintAssist.Hint="Đến ngày"
                                             Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,12,0">
                                <TextBlock Text="TRẠNG THÁI TT" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                                <ComboBox ItemsSource="{Binding AvailablePaymentStatuses}"
                                          SelectedItem="{Binding SelectedFilterPaymentStatus}"
                                          Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="5" Content="XUẤT EXCEL" 
                                    Style="{StaticResource AppSecondaryButton}" 
                                    VerticalAlignment="Bottom" Height="36"
                                    Padding="16,0" FontSize="12">
                                <Button.ToolTip>Xuất danh sách ra tệp Excel</Button.ToolTip>
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- ROW 3: DATAGRID -->
                    <materialDesign:Card Grid.Row="2" UniformCornerRadius="12" Background="White"
                                         materialDesign:ShadowAssist.ShadowDepth="Depth1">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Invoices}"
                                      SelectedItem="{Binding SelectedInvoice}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SỐ HĐ" Binding="{Binding InvoiceCode}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextBold}"/>
                                    <DataGridTextColumn Header="NGÀY BÁN" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yyyy'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                    <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding Customer.DisplayName}" Width="*" ElementStyle="{StaticResource AppDataGridTextBold}"/>
                                    <DataGridTextColumn Header="TRƯỚC THUẾ" Binding="{Binding SubTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextRight}"/>
                                    <DataGridTextColumn Header="THUẾ" Binding="{Binding TaxAmount, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextRight}"/>
                                    <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding GrandTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextRightBold}"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI TT" Width="Auto" CellTemplate="{StaticResource PaymentStatusBadgeTemplate}"/>
                                    <DataGridTextColumn Header="HẠN TT" Binding="{Binding DueDate, StringFormat='dd/MM/yyyy'}" Width="Auto" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                    <DataGridTemplateColumn Header="THAO TÁC" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=EyeOutline}" 
                                                            Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4" ToolTip="Xem chi tiết"/>
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=PencilOutline}" 
                                                            Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4" Margin="4,0,0,0" ToolTip="Chỉnh sửa"/>
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=PrinterOutline}" 
                                                            Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4" Margin="4,0,0,0" ToolTip="In hóa đơn"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- CREATE TAB -->
            <TabItem Header="TẠO MỚI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,24,0,0">
                        <materialDesign:Card UniformCornerRadius="12" Padding="32" Background="White"
                                             materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header -->
                                    <RowDefinition Height="Auto"/> <!-- Info Grid -->
                                    <RowDefinition Height="Auto"/> <!-- Ghi chú -->
                                    <RowDefinition Height="*"/>    <!-- Products Table -->
                                    <RowDefinition Height="Auto"/> <!-- Summary & Actions -->
                                </Grid.RowDefinitions>

                                <!-- ROW 0: HEADER -->
                                <Grid Grid.Row="0" Margin="0,0,0,32">
                                    <StackPanel>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
                                                    <Setter Property="Text" Value="TẠO MỚI HÓA ĐƠN BÁN"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                                                            <Setter Property="Text" Value="CHI TIẾT HÓA ĐƠN BÁN"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                            <Setter Property="Text" Value="CHỈNH SỬA HÓA ĐƠN BÁN"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Nhập thông tin chi tiết hàng hóa và thanh toán khách hàng" Style="{StaticResource SubtitleText}"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="TRỞ LẠI DANH SÁCH" 
                                            Click="BackToList_Click"
                                            Style="{StaticResource AppSecondaryButton}"
                                            Height="36" Padding="16,0"/>
                                </Grid>

                                <!-- ROW 1: INFO GRID (3 COLUMNS) -->
                                <Grid Grid.Row="1" Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column 0: Invoice Details -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                                        <TextBlock Text="SỐ HOÁ ĐƠN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding InvoiceCode}"
                                                 Height="32" VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="NGÀY LẬP HOÁ ĐƠN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding InvoiceDate}"
                                                    Height="32" VerticalContentAlignment="Center"
                                                    IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <!-- Column 1: Partner & Document -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,16,16">
                                        <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding AvailableCustomers}"
                                                  SelectedItem="{Binding SelectedCustomer}"
                                                  DisplayMemberPath="DisplayName"
                                                  Height="32" VerticalContentAlignment="Center"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,16,0">
                                        <TextBlock Text="PHIẾU XUẤT KHO" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding AvailableStockOuts}"
                                                  SelectedItem="{Binding SelectedStockOut}"
                                                  DisplayMemberPath="StockOutCode"
                                                  materialDesign:HintAssist.Hint="Liên kết phiếu xuất"
                                                  Height="32" VerticalContentAlignment="Center"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <!-- Column 2: Payment & Terms -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="16,0,0,16">
                                        <TextBlock Text="HẠN THANH TOÁN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding DueDate}"
                                                    Height="32" VerticalContentAlignment="Center"
                                                    IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock Text="TRẠNG THÁI THANH TOÁN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding AvailablePaymentStatuses}"
                                                  SelectedItem="{Binding SelectedPaymentStatus}"
                                                  Height="32" VerticalContentAlignment="Center"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 2: GHI CHÚ (FULL WIDTH) -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,32">
                                    <TextBlock Text="GHI CHÚ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Notes}"
                                             materialDesign:HintAssist.Hint="Nhập nội dung ghi chú hoá đơn..."
                                             AcceptsReturn="True" Height="60"
                                             VerticalContentAlignment="Top"
                                             IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                </StackPanel>

                                <!-- ROW 3: PRODUCTS TABLE -->
                                <Grid Grid.Row="3">
                                    <StackPanel>
                                        <TextBlock Text="CHI TIẾT SẢN PHẨM" FontWeight="Bold" Margin="0,0,0,16" FontSize="13" Foreground="{StaticResource AppTertiaryBrush}"/>
                                        <DataGrid ItemsSource="{Binding Lines}" 
                                                  AutoGenerateColumns="False" 
                                                  CanUserAddRows="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  GridLinesVisibility="None"
                                                  IsReadOnly="{Binding IsViewMode}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="MÃ SẢN PHẨM" Binding="{Binding SelectedProduct.ProductCode}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding SelectedProduct}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      VerticalAlignment="Center"
                                                                      materialDesign:TextFieldAssist.HasClearButton="True"
                                                                      IsEnabled="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                                <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding UnitPrice, StringFormat='N0', UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource AppDataGridTextRightBold}"/>
                                                <DataGridTextColumn Header="THUẾ (%)" Binding="{Binding TaxRate, StringFormat='P0', UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                                                <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding TotalPrice, StringFormat='N0'}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource AppDataGridTextRightBold}"/>
                                                
                                                <DataGridTemplateColumn Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=Close, Size=18}"
                                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Foreground="Red"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Command="{Binding AddLineCommand}" 
                                                 Style="{StaticResource MaterialDesignFlatButton}"
                                                 HorizontalAlignment="Left" Margin="0,12,0,0"
                                                 Visibility="{Binding IsViewMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Width="18" Height="18"/>
                                                <TextBlock Text="THÊM DÒNG SẢN PHẨM" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 4: SUMMARY & ACTIONS -->
                                <Grid Grid.Row="4" Margin="0,40,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="400"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Action Buttons (Bottom Left relative to summary) -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <materialDesign:Card Padding="24" Style="{StaticResource AppCard}" Margin="0,0,0,24">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <TextBlock Text="TỔNG TIỀN HÀNG" Style="{StaticResource TypographyLabel}"/>
                                                    <TextBlock Text="{Binding FormSubTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <TextBlock Text="THUẾ (VAT)" Style="{StaticResource TypographyLabel}"/>
                                                    <TextBlock Text="{Binding FormTaxAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <TextBlock Text="TỔNG CỘNG" Style="{StaticResource TypographyLabel}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding FormTotalAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AppPrimaryBrush}"/>
                                                </Grid>
                                                <Separator Margin="0,8,0,12" Background="{StaticResource AppBorderBrush}"/>
                                                <Grid Margin="0,0,0,12">
                                                    <TextBlock Text="ĐÃ THANH TOÁN" Style="{StaticResource TypographyLabel}"/>
                                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}"
                                                             HorizontalAlignment="Right" Width="150" HorizontalContentAlignment="Right"
                                                             IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="CÒN LẠI" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding FormRemainingAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Foreground="Red"/>
                                                </Grid>
                                            </StackPanel>
                                        </materialDesign:Card>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="HỦY BỎ" 
                                                    Click="BackToList_Click"
                                                    Style="{StaticResource AppSecondaryButton}" 
                                                    Width="120" Height="40" Margin="0,0,12,0"/>
                                            
                                            <Button Command="{Binding SaveInvoiceCommand}"
                                                     Width="160" Height="40"
                                                     Visibility="{Binding IsViewMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
                                                        <Setter Property="Content" Value="LƯU HOÁ ĐƠN"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                                <Setter Property="Content" Value="CẬP NHẬT"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
