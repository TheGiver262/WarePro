<UserControl x:Class="QuanLyHangHoa.Views.SalesInvoiceView"
             x:Name="RootSalesInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyHangHoa.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24">
        <TabControl materialDesign:ColorZoneAssist.Mode="Standard"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
            
            <!-- LIST TAB -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 1: Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Filter Card -->
                        <RowDefinition Height="*"/>    <!-- Row 3: DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- ROW 1: HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="HÓA ĐƠN BÁN HÀNG" 
                                       Style="{StaticResource TypographyH1}" />
                            <TextBlock Text="Quản lý và theo dõi các hóa đơn bán hàng" 
                                       Style="{StaticResource TypographyCaption}" Opacity="0.7" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="TẠO TỪ PHIẾU XUẤT" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Height="32"
                                    Margin="0,0,12,0"/>
                            <Button Command="{Binding ResetFormCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="TẠO MỚI" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 2: FILTER CARD -->
                    <materialDesign:Card Grid.Row="1" Margin="0,0,0,24" Padding="16" Style="{StaticResource AppCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- MAIN FILTER ROW -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="SỐ HOÁ ĐƠN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding SearchInvoiceCode, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Mã hoá đơn..."
                                             materialDesign:TextFieldAssist.HasClearButton="False"
                                             Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding SearchCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Tìm khách hàng..."
                                             materialDesign:TextFieldAssist.HasClearButton="False"
                                             Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Command="{Binding RefreshCommand}"
                                            Style="{StaticResource AppRefreshButton}" 
                                            Height="32" Margin="0,0,8,0"/>

                                    <Button Command="{Binding ToggleAdvancedFilterCommand}"
                                            Style="{StaticResource SecondaryButton}" 
                                            Width="180" Height="32" Margin="0,0,8,0"
                                            ToolTip="Bộ lọc nâng cao">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="FilterText" Text="BỘ LỌC NÂNG CAO" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ExportToExcelCommand}"
                                            Style="{StaticResource AppExcelButton}" 
                                            Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- ADVANCED FILTER ROW (Collapsible) -->
                            <Grid Grid.Row="1" 
                                  Visibility="{Binding IsAdvancedFilterOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Date Filter Group -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="TỪ NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding FilterStartDate}"
                                                 materialDesign:HintAssist.Hint="Từ ngày..."
                                                 Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding FilterEndDate}"
                                                 materialDesign:HintAssist.Hint="Đến ngày..."
                                                 Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Price Range Filter -->
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="KHOẢNG GIÁ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FilterMinTotal, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Giá từ..."
                                                 Height="32" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="4,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding FilterMaxTotal, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Giá đến..."
                                                 Height="32" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Status Filter -->
                                <StackPanel Grid.Column="3" Margin="0,0,0,0">
                                    <TextBlock Text="TRẠNG THÁI THANH TOÁN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailablePaymentStatuses}"
                                              SelectedItem="{Binding SelectedFilterPaymentStatus}"
                                              Height="32" VerticalContentAlignment="Center"
                                              Width="200" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- ROW 3: DATAGRID -->
                    <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding Invoices}"
                                      SelectedItem="{Binding SelectedInvoice}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      CanUserReorderColumns="False"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SỐ HĐ" Binding="{Binding InvoiceCode}" Width="Auto" ElementStyle="{DynamicResource AppDataGridTextBold}"/>
                                    <DataGridTextColumn Header="NGÀY BÁN" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yyyy'}" Width="Auto" ElementStyle="{DynamicResource AppDataGridTextCenter}"/>
                                    <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding Customer.DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="TRƯỚC THUẾ" Binding="{Binding SubTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{DynamicResource AppDataGridTextRight}"/>
                                    <DataGridTextColumn Header="THUẾ" Binding="{Binding TaxAmount, StringFormat='N0'}" Width="Auto" ElementStyle="{DynamicResource AppDataGridTextRight}"/>
                                    <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding GrandTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{DynamicResource AppDataGridTextRightBold}"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI TT" Width="Auto" CellTemplate="{StaticResource PaymentStatusBadgeTemplate}"/>
                                    <DataGridTemplateColumn Header="THAO TÁC" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ProMaxIconButtonStyle}" 
                                                            Command="{Binding DataContext.ViewInvoiceCommand, ElementName=RootSalesInvoiceView}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Xem chi tiết">
                                                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" Foreground="{StaticResource AppSecondaryBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource ProMaxIconButtonStyle}" 
                                                            Command="{Binding DataContext.EditInvoiceCommand, ElementName=RootSalesInvoiceView}"
                                                            CommandParameter="{Binding}"
                                                            Margin="4,0,0,0" ToolTip="Chỉnh sửa">
                                                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{StaticResource AppSecondaryBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource ProMaxIconButtonStyle}" 
                                                            Command="{Binding DataContext.PrintInvoiceCommand, ElementName=RootSalesInvoiceView}"
                                                            CommandParameter="{Binding}"
                                                            Margin="4,0,0,0" ToolTip="In hóa đơn">
                                                        <materialDesign:PackIcon Kind="PrinterOutline" Width="18" Height="18" Foreground="{StaticResource AppSecondaryBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Row 1: Footer -->
                            <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource AppSecondaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}Hiện có {0} hoá đơn · {1} Đã thanh toán · {2} TT 1 phần · {3} Chưa TT · {4} Quá hạn">
                                            <Binding Path="Invoices.Count"/>
                                            <Binding Path="PaidCount"/>
                                            <Binding Path="PartialCount"/>
                                            <Binding Path="UnpaidCount"/>
                                            <Binding Path="OverdueCount"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- CREATE TAB -->
            <TabItem Header="TẠO MỚI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,24,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="Auto"/> <!-- Info Card -->
                                <RowDefinition Height="Auto"/> <!-- Add Line Button -->
                                <RowDefinition Height="*"/>    <!-- Products Table -->
                                <RowDefinition Height="Auto"/> <!-- Summary & Actions -->
                            </Grid.RowDefinitions>

                            <!-- ROW 0: HEADER -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="32" Height="32" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Margin="16,0,0,0">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TypographyH1}">
                                                    <Setter Property="Text" Value="TẠO MỚI HÓA ĐƠN BÁN"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                                                            <Setter Property="Text" Value="CHI TIẾT HÓA ĐƠN BÁN"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                            <Setter Property="Text" Value="CHỈNH SỬA HÓA ĐƠN BÁN"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Nhập thông tin chi tiết hàng hóa và thanh toán khách hàng" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="TRỞ LẠI DANH SÁCH" 
                                            Click="BackToList_Click"
                                            Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,12,0"/>
                                    <Button Command="{Binding SaveInvoiceCommand}"
                                            Style="{StaticResource PrimaryButton}" Height="36"
                                            Visibility="{Binding IsViewMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TypographyButtonText}">
                                                            <Setter Property="Text" Value="LƯU HOÁ ĐƠN"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                                    <Setter Property="Text" Value="CẬP NHẬT"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ROW 1: INFO CARD -->
                            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Background="{StaticResource SurfaceMutedBrush}" Padding="20" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                                        <TextBlock Text="SỐ HOÁ ĐƠN" Style="{StaticResource DetailFormLabel}"/>
                                        <TextBox Text="{Binding InvoiceCode}" Style="{StaticResource DetailFormTextBoxStyle}"
                                                 IsReadOnly="{Binding IsViewMode}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,16">
                                        <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource DetailFormLabel}"/>
                                        <ComboBox ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}"
                                                  DisplayMemberPath="DisplayName" Style="{StaticResource DetailFormComboBoxStyle}"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="16,0,0,16">
                                        <TextBlock Text="PHIẾU XUẤT KHO" Style="{StaticResource DetailFormLabel}"/>
                                        <ComboBox ItemsSource="{Binding AvailableStockOuts}" SelectedItem="{Binding SelectedStockOut}"
                                                  DisplayMemberPath="StockOutCode" Style="{StaticResource DetailFormComboBoxStyle}"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <!-- Row 1 -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,16">
                                        <TextBlock Text="NGÀY LẬP HOÁ ĐƠN" Style="{StaticResource DetailFormLabel}"/>
                                        <DatePicker SelectedDate="{Binding InvoiceDate}" Style="{StaticResource DetailFormDatePickerStyle}"
                                                    IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,16">
                                        <TextBlock Text="HẠN THANH TOÁN" Style="{StaticResource DetailFormLabel}"/>
                                        <DatePicker SelectedDate="{Binding DueDate}" Style="{StaticResource DetailFormDatePickerStyle}"
                                                    IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="16,0,0,16">
                                        <TextBlock Text="TRẠNG THÁI THANH TOÁN" Style="{StaticResource DetailFormLabel}"/>
                                        <ComboBox ItemsSource="{Binding AvailablePaymentStatuses}" SelectedItem="{Binding SelectedPaymentStatus}"
                                                  Style="{StaticResource DetailFormComboBoxStyle}"
                                                  IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>

                                    <!-- Row 2: Notes (full width) -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="GHI CHÚ" Style="{StaticResource DetailFormLabel}"/>
                                        <TextBox Text="{Binding Notes}" Style="{StaticResource DetailFormNotesStyle}"
                                                 materialDesign:HintAssist.Hint="Nhập nội dung ghi chú hoá đơn..."
                                                 IsReadOnly="{Binding IsViewMode}"/>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <!-- ROW 2: ADD LINE BUTTON -->
                            <Button Grid.Row="2" Command="{Binding AddLineCommand}" 
                                    Style="{StaticResource SecondaryButton}" Height="36"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                    Visibility="{Binding IsViewMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="THÊM DÒNG SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>

                            <!-- ROW 3: PRODUCTS TABLE -->
                            <materialDesign:Card Grid.Row="3" Style="{StaticResource AppCard}" Padding="0" Margin="0,0,0,24">
                                <DataGrid ItemsSource="{Binding Lines}" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False"
                                          CanUserReorderColumns="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          GridLinesVisibility="None"
                                          RowHeight="54"
                                          IsReadOnly="{Binding IsViewMode}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="120">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="MÃ SP" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SelectedProduct.ProductCode}" VerticalAlignment="Center" Margin="8,0" Style="{StaticResource TypographyCaption}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="*">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, ElementName=RootSalesInvoiceView}"
                                                              SelectedItem="{Binding SelectedProduct}"
                                                              DisplayMemberPath="DisplayName"
                                                              Style="{StaticResource AppComboBoxStyle}" Margin="8,4" BorderThickness="0" Height="36"
                                                              materialDesign:TextFieldAssist.HasClearButton="False"
                                                              IsEnabled="{Binding DataContext.IsViewMode, ElementName=RootSalesInvoiceView, Converter={StaticResource InverseBooleanConverter}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="100">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="SỐ LƯỢNG" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"
                                                             Style="{StaticResource AppTextBoxStyle}" Margin="8,4" Height="36" BorderThickness="0"
                                                             IsReadOnly="{Binding DataContext.IsViewMode, ElementName=RootSalesInvoiceView}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="140">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="ĐƠN GIÁ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding UnitPrice, StringFormat='N0', UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"
                                                             Style="{StaticResource AppTextBoxStyle}" Margin="8,4" Height="36" BorderThickness="0"
                                                             IsReadOnly="{Binding DataContext.IsViewMode, ElementName=RootSalesInvoiceView}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="100">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="THUẾ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding TaxRate, StringFormat='P0', UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"
                                                             Style="{StaticResource AppTextBoxStyle}" Margin="8,4" Height="36" BorderThickness="0"
                                                             IsReadOnly="{Binding DataContext.IsViewMode, ElementName=RootSalesInvoiceView}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="140" IsReadOnly="True">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="THÀNH TIỀN" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TotalPrice, StringFormat='N0'}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                               Margin="8,0" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ProMaxIconButtonStyle}"
                                                            Command="{Binding DataContext.RemoveLineCommand, ElementName=RootSalesInvoiceView}"
                                                            CommandParameter="{Binding}" VerticalAlignment="Center"
                                                            Visibility="{Binding DataContext.IsViewMode, ElementName=RootSalesInvoiceView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="{StaticResource AppErrorBrush}"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </materialDesign:Card>

                            <!-- ROW 4: SUMMARY & ACTIONS -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="460"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Info tips -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,24,0">
                                    <Border Background="{StaticResource SurfaceMutedBrush}" Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}">
                                        <StackPanel>
                                            <TextBlock Text="THÔNG TIN BỔ SUNG" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppTertiaryBrush}" Margin="0,0,0,12"/>
                                            <TextBlock Text="• Hoá đơn này sẽ được lưu vào hệ thống và cập nhật công nợ khách hàng." FontSize="12" Foreground="{StaticResource AppSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Vui lòng kiểm tra kỹ số lượng và đơn giá trước khi xác nhận." FontSize="12" Foreground="{StaticResource AppSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right: Summary Card -->
                                <materialDesign:Card Grid.Column="1" Padding="24" Background="{StaticResource SurfaceMutedBrush}" UniformCornerRadius="12" materialDesign:ShadowAssist.ShadowDepth="Depth1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Tổng tiền chưa thuế" FontSize="13" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            <TextBlock Text="{Binding FormSubTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="15"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Thuế giá trị gia tăng (VAT)" FontSize="13" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            <TextBlock Text="{Binding FormTaxAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="15"/>
                                        </Grid>
                                        
                                        <Separator Margin="0,4,0,16" Background="{StaticResource AppBorderBrush}"/>
                                        
                                        <Grid Margin="0,0,0,20">
                                            <TextBlock Text="TỔNG CỘNG THANH TOÁN" FontSize="14" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FormTotalAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="24" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="Bold"/>
                                        </Grid>

                                        <Border Background="White" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="KHÁCH ĐÃ THANH TOÁN" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource AppSecondaryBrush}"/>
                                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}"
                                                         HorizontalAlignment="Right" Width="180" HorizontalContentAlignment="Right"
                                                         Style="{StaticResource StatNumberInputStyle}" BorderThickness="0"
                                                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                         materialDesign:TextFieldAssist.HasClearButton="False"
                                                         IsReadOnly="{Binding IsViewMode}"/>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="12,0">
                                            <TextBlock Text="CÒN LẠI (CÔNG NỢ)" FontSize="13" VerticalAlignment="Center" Foreground="#D32F2F" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding FormRemainingAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="20" Foreground="#D32F2F" FontWeight="SemiBold"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
