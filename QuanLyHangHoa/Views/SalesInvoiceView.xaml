<UserControl x:Class="QuanLyHangHoa.Views.SalesInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyHangHoa.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24">
        <TabControl Style="{StaticResource MaterialDesignNavigatilRailTabControl}"
                    materialDesign:ColorZoneAssist.Mode="Standard"
                    SelectedIndex="{Binding SelectedTabIndex}">
            
            <!-- LIST TAB -->
            <TabItem Header="DANH SÁCH">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 1: Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Filter Card -->
                        <RowDefinition Height="*"/>    <!-- Row 3: DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- ROW 1: HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="QUẢN LÝ HÓA ĐƠN BÁN" 
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Text="Theo dõi các hóa đơn bán hàng và trạng thái thanh toán" 
                                       Style="{StaticResource SubtitleText}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="XUẤT EXCEL" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Margin="0,0,12,0" 
                                    materialDesign:ButtonAssist.CornerRadius="8"/>
                            <Button Content="TẠO TỪ PHIẾU XUẤT" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Margin="0,0,12,0" 
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    BorderBrush="{StaticResource AppTertiaryBrush}"
                                    Foreground="{StaticResource AppTertiaryBrush}"/>
                            <Button Content="+ TẠO HÓA ĐƠN" 
                                    Command="{Binding ResetFormCommand}"
                                    Click="CreateNew_Click"
                                    Style="{StaticResource PrimaryButton}" 
                                    materialDesign:ButtonAssist.CornerRadius="8"/>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 2: FILTER CARD -->
                    <materialDesign:Card Grid.Row="1" Padding="20" Margin="0,0,0,24" 
                                         UniformCornerRadius="12" Background="White"
                                         materialDesign:ShadowAssist.ShadowDepth="Depth1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Tìm kiếm số HĐ / Khách hàng" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Số hóa đơn, tên khách..."
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Khoảng ngày hóa đơn" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding FilterStartDate}"
                                                materialDesign:HintAssist.Hint="Từ ngày"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                    <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="8,0"/>
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding FilterEndDate}"
                                                materialDesign:HintAssist.Hint="Đến ngày"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Trạng thái TT" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding AvailablePaymentStatuses}"
                                          SelectedItem="{Binding SelectedFilterPaymentStatus}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                <TextBlock Text="Phiếu xuất" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding FilterLinkDocCode}"
                                         materialDesign:HintAssist.Hint="Mã phiếu xuất..."
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="LỌC DỮ LIỆU" 
                                    Command="{Binding LoadDataCommand}"
                                    Style="{StaticResource PrimaryButton}" 
                                    VerticalAlignment="Bottom" Height="45"
                                    materialDesign:ButtonAssist.CornerRadius="8"/>
                        </Grid>
                    </materialDesign:Card>

                    <!-- ROW 3: DATAGRID -->
                    <materialDesign:Card Grid.Row="2" UniformCornerRadius="12" Background="White"
                                         materialDesign:ShadowAssist.ShadowDepth="Depth1">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Invoices}"
                                      SelectedItem="{Binding SelectedInvoice}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SỐ HĐ" Binding="{Binding InvoiceCode}" Width="Auto" ElementStyle="{StaticResource DataGridTextBold}"/>
                                    <DataGridTextColumn Header="NGÀY HĐ" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yyyy'}" Width="Auto"/>
                                    <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding Customer.DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="PHIẾU XUẤT" Binding="{Binding StockOut.StockOutCode}" Width="Auto" ElementStyle="{StaticResource DataGridTextItalic}"/>
                                    <DataGridTextColumn Header="TRƯỚC THUẾ" Binding="{Binding SubTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource DataGridTextRight}"/>
                                    <DataGridTextColumn Header="THUẾ" Binding="{Binding TaxAmount, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource DataGridTextRight}"/>
                                    <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding GrandTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource DataGridTextRightBold}"/>
                                    <DataGridTextColumn Header="ĐÃ TT" Binding="{Binding PaidAmount, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource DataGridTextRight}"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI TT" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,4" CornerRadius="12" HorizontalAlignment="Left"
                                                        Background="{Binding PaymentStatus, Converter={StaticResource StatusToBrushConverter}}">
                                                    <TextBlock Text="{Binding PaymentStatus}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="HẠN TT" Binding="{Binding DueDate, StringFormat='dd/MM/yyyy'}" Width="Auto" ElementStyle="{StaticResource DataGridTextCenter}"/>
                                    <DataGridTemplateColumn Header="THAO TÁC" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=EyeOutline}" Padding="4" ToolTip="Xem chi tiết"/>
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=PencilOutline}" Padding="4" Margin="4,0,0,0" ToolTip="Chỉnh sửa"/>
                                                    <Button Style="{StaticResource IconButton}" Content="{materialDesign:PackIcon Kind=PrinterOutline}" Padding="4" Margin="4,0,0,0" ToolTip="In hóa đơn"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- CREATE TAB -->
            <TabItem Header="TẠO MỚI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,24,0,0">
                        <materialDesign:Card UniformCornerRadius="12" Padding="32" Background="White"
                                             materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            <StackPanel>
                                <!-- Form Header -->
                                <Grid Margin="0,0,0,32">
                                    <StackPanel>
                                        <TextBlock Text="TẠO MỚI HÓA ĐƠN BÁN" Style="{StaticResource TitleText}"/>
                                        <TextBlock Text="Nhập thông tin chi tiết hàng hóa và thanh toán" Style="{StaticResource SubtitleText}"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="TRỞ LẠI DANH SÁCH" 
                                            Command="{Binding LoadDataCommand}"
                                            Click="BackToList_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </Grid>

                                <!-- Form Body -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Info & Lines -->
                                    <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                        <materialDesign:Card Padding="24" Background="{StaticResource AppBackgroundBrush}" UniformCornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,16">
                                                    <TextBlock Text="Khách hàng" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                                    <ComboBox ItemsSource="{Binding AvailableCustomers}"
                                                              SelectedItem="{Binding SelectedCustomer}"
                                                              DisplayMemberPath="DisplayName"
                                                              materialDesign:HintAssist.Hint="Chọn khách hàng"
                                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,16">
                                                    <TextBlock Text="Ngày hóa đơn" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                                    <DatePicker SelectedDate="{Binding InvoiceDate}"
                                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="Số hóa đơn" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                                    <TextBox Text="{Binding InvoiceCode}"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="Hạn thanh toán" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                                    <DatePicker SelectedDate="{Binding DueDate}"
                                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                                </StackPanel>
                                            </Grid>
                                        </materialDesign:Card>

                                        <TextBlock Text="CHI TIẾT HÀNG HÓA" FontWeight="Bold" Margin="0,32,0,16" FontSize="14" Foreground="{StaticResource AppTertiaryBrush}"/>
                                        
                                        <!-- Products Table -->
                                        <DataGrid ItemsSource="{Binding Lines}" 
                                                  AutoGenerateColumns="False" 
                                                  CanUserAddRows="False"
                                                  Background="White"
                                                  BorderThickness="1"
                                                  BorderBrush="{StaticResource AppBorderBrush}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      BorderThickness="0"
                                                                      IsEditable="True"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="SL" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding UnitPrice, StringFormat='N0', UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                                <DataGridTemplateColumn Header="THUẾ" Width="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox SelectedValue="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Tag"
                                                                      BorderThickness="0">
                                                                <ComboBoxItem Content="0%" Tag="0.0"/>
                                                                <ComboBoxItem Content="5%" Tag="0.05"/>
                                                                <ComboBoxItem Content="8%" Tag="0.08"/>
                                                                <ComboBoxItem Content="10%" Tag="0.1"/>
                                                            </ComboBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding TotalPrice, StringFormat='N0'}" Width="130" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextRightBold}"/>
                                                <DataGridTemplateColumn Header="" Width="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource IconButton}"
                                                                    Content="{materialDesign:PackIcon Kind=DeleteOutline}"
                                                                    Foreground="Red"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Command="{Binding AddLineCommand}" 
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                HorizontalAlignment="Left" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                                                <TextBlock Text="THÊM DÒNG" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Right Column: Summary & Payment -->
                                    <StackPanel Grid.Column="1">
                                        <materialDesign:Card Padding="24" Background="{StaticResource AppBackgroundBrush}" UniformCornerRadius="12">
                                            <StackPanel>
                                                <TextBlock Text="THANH TOÁN" FontWeight="Bold" Margin="0,0,0,24" FontSize="14" Foreground="{StaticResource AppTertiaryBrush}"/>
                                                
                                                <Grid Margin="0,0,0,16">
                                                    <TextBlock Text="Tạm tính" Style="{StaticResource LabelText}"/>
                                                    <TextBlock Text="{Binding FormTotalAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                </Grid>
                                                
                                                <Grid Margin="0,0,0,16">
                                                    <TextBlock Text="Thuế GTGT" Style="{StaticResource LabelText}"/>
                                                    <TextBlock Text="Tính trong đơn giá" HorizontalAlignment="Right" FontStyle="Italic" FontSize="11" Foreground="Gray"/>
                                                </Grid>
                                                
                                                <Separator Background="{StaticResource AppBorderBrush}" Margin="0,8,0,16"/>
                                                
                                                <Grid Margin="0,0,0,24">
                                                    <TextBlock Text="TỔNG CỘNG" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="{Binding FormTotalAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AppTertiaryBrush}"/>
                                                </Grid>

                                                <TextBlock Text="Số tiền đã thu" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         materialDesign:TextFieldAssist.PrefixText="₫ "
                                                         FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                                                <Grid Margin="0,0,0,32">
                                                    <TextBlock Text="Còn lại" Style="{StaticResource LabelText}"/>
                                                    <TextBlock Text="{Binding FormRemainingAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="Red"/>
                                                </Grid>

                                                <TextBlock Text="Ghi chú" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                                <TextBox Text="{Binding Notes}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         AcceptsReturn="True" Height="80" VerticalContentAlignment="Top"
                                                         materialDesign:HintAssist.Hint="Nhập ghi chú hóa đơn..."/>
                                            </StackPanel>
                                        </materialDesign:Card>

                                        <Button Content="LƯU HÓA ĐƠN" 
                                                Command="{Binding SaveInvoiceCommand}"
                                                Style="{StaticResource PrimaryButton}" 
                                                Height="50" Margin="0,24,0,0"
                                                materialDesign:ButtonAssist.CornerRadius="8"/>
                                        <Button Content="HỦY BỎ" 
                                                Command="{Binding LoadDataCommand}"
                                                Click="BackToList_Click"
                                                Style="{StaticResource SecondaryButton}" 
                                                Margin="0,12,0,0"
                                                materialDesign:ButtonAssist.CornerRadius="8"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
