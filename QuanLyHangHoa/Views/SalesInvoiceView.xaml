<UserControl x:Class="QuanLyHangHoa.Views.SalesInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.DataContext>
        <vm:SalesInvoiceViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <materialDesign:Card Grid.Row="0" Margin="{StaticResource Margin.Bottom.lg}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AppTertiaryBrush}" Width="40" Height="40" CornerRadius="{StaticResource Radius.md}">
                            <materialDesign:PackIcon Kind="FileExport" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        </Border>
                        <StackPanel Margin="{StaticResource Margin.Left.md}" VerticalAlignment="Center">
                            <TextBlock Text="HÓA ĐƠN BÁN HÀNG" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppPrimaryBrush}"/>
                            <TextBlock Text="Quản lý doanh thu và lịch sử bán hàng" Style="{StaticResource TypographyCaption}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="TẠO HÓA ĐƠN MỚI" Command="{Binding ResetFormCommand}" Style="{StaticResource AppPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Statistics Summary Bar (Pro Max) -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.lg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                    <StackPanel>
                        <TextBlock Text="TỔNG HÓA ĐƠN" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalSalesCount}" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppTertiaryBrush}" Margin="{StaticResource Margin.Top.sm}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Margin="{StaticResource Margin.Horizontal.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                    <StackPanel>
                        <TextBlock Text="TỔNG DOANH THU" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalSalesAmount, StringFormat='N0'}" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppPrimaryBrush}" Margin="{StaticResource Margin.Top.sm}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Margin="{StaticResource Margin.Horizontal.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                    <StackPanel>
                        <TextBlock Text="ĐÃ THU" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalPaidAmount, StringFormat='N0'}" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppSuccessBrush}" Margin="{StaticResource Margin.Top.sm}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="3" Margin="{StaticResource Margin.Left.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                    <StackPanel>
                        <TextBlock Text="CÒN NỢ" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalDebtAmount, StringFormat='N0'}" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppErrorBrush}" Margin="{StaticResource Margin.Top.sm}"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Main: Invoices List (LEFT) -->
                <TabControl Grid.Column="0" Margin="{StaticResource Margin.Right.lg}" Style="{StaticResource MaterialDesignNavigationRailTabControl}">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Height="40">
                                <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center"/>
                                <TextBlock Text="DANH SÁCH" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.sm}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <materialDesign:Card Style="{StaticResource AppCard}" Margin="{StaticResource Margin.Top.md}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Padding="{StaticResource Spacing.md}" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Database" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                                        <TextBlock Text="LỊCH SỬ XUẤT HÓA ĐƠN" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Left.md}" Foreground="{StaticResource AppPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                          RowHeight="28" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MÃ HĐ" Binding="{Binding InvoiceCode}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                                        <DataGridTextColumn Header="NGÀY" Binding="{Binding InvoiceDate, StringFormat='dd/MM/yyyy'}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                                        <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding Customer.DisplayName}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                                        <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding GrandTotal, StringFormat='N0'}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,1" CornerRadius="{StaticResource Radius.sm}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã thanh toán">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                                        <Setter Property="Background" Value="#FEF9C3"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Thanh toán một phần">
                                                                        <Setter Property="Background" Value="#FEF9C3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding PaymentStatus}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                                            <Setter Property="Foreground" Value="#166534"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã thanh toán">
                                                                            <Setter Property="Foreground" Value="#166534"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                                            <Setter Property="Foreground" Value="#854D0E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Thanh toán một phần">
                                                                            <Setter Property="Foreground" Value="#854D0E"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>
                    </TabItem>
                    
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Height="40">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                                <TextBlock Text="LẬP HÓA ĐƠN" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.sm}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <materialDesign:Card Style="{StaticResource AppCard}" Margin="{StaticResource Margin.Top.md}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Padding="{StaticResource Spacing.md}" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePlusOutline" VerticalAlignment="Center" Foreground="{StaticResource AppSuccessBrush}"/>
                                            <TextBlock Text="THÔNG TIN HÓA ĐƠN MỚI" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Left.md}" Foreground="{StaticResource AppPrimaryBrush}"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Content="LÀM MỚI" Command="{Binding ResetFormCommand}" Style="{StaticResource AppSecondaryButton}" Height="32" Padding="12,0" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <Border Padding="{StaticResource Spacing.md}">
                                        <StackPanel>
                                        <Grid Margin="{StaticResource Margin.Bottom.md}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBox Grid.Column="0" Margin="{StaticResource Margin.Right.md}" materialDesign:HintAssist.Hint="Mã hóa đơn" Text="{Binding InvoiceCode}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <ComboBox Grid.Column="1" Margin="{StaticResource Margin.Right.md}" materialDesign:HintAssist.Hint="Khách hàng" ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="DisplayName" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                            <DatePicker Grid.Column="2" materialDesign:HintAssist.Hint="Ngày lập" SelectedDate="{Binding InvoiceDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                        </Grid>

                                        <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="{StaticResource Radius.md}" Padding="{StaticResource Spacing.md}" Margin="{StaticResource Margin.Bottom.md}">
                                            <StackPanel>
                                                <Grid Margin="{StaticResource Margin.Bottom.sm}">
                                                    <TextBlock Text="DANH SÁCH MẶT HÀNG" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppTertiaryBrush}"/>
                                                    <Button HorizontalAlignment="Right" Content="+ THÊM HÀNG" Command="{Binding AddLineCommand}" Style="{StaticResource AppPrimaryButton}" Height="32" Padding="12,0" FontSize="12"/>
                                                </Grid>
                                                
                                                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeight="28">
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                              SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                                              DisplayMemberPath="DisplayName" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                                              VerticalAlignment="Center" FontSize="12"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                                                        <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                                                        <DataGridTemplateColumn Header="" Width="50">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource AppErrorBrush}" Width="24" Height="24" Padding="0"
                                                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <TextBox materialDesign:HintAssist.Hint="Ghi chú hóa đơn" Text="{Binding Notes}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                        
                                        <Grid Margin="{StaticResource Margin.Top.md}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="CashMultiple" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center" Width="24" Height="24"/>
                                                <TextBlock Text="KHÁCH TRẢ:" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.sm}" Style="{StaticResource TypographyLabel}"/>
                                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" Width="150" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.md}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            </StackPanel>
                                            
                                            <Button HorizontalAlignment="Right" Content="LƯU HÓA ĐƠN" Command="{Binding SaveInvoiceCommand}" Style="{StaticResource AppPrimaryButton}" Width="160"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                            </Grid>
                        </materialDesign:Card>
                    </TabItem>
                </TabControl>

                <!-- Sidebar: Details (RIGHT) -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.lg}">
                            <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CHI TIẾT HÓA ĐƠN" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppPrimaryBrush}" Margin="{StaticResource Margin.Left.sm}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox materialDesign:HintAssist.Hint="Mã HĐ" Text="{Binding SelectedInvoice.InvoiceCode}" IsReadOnly="True" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <TextBox materialDesign:HintAssist.Hint="Khách hàng" Text="{Binding SelectedInvoice.Customer.DisplayName}" IsReadOnly="True" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <TextBox materialDesign:HintAssist.Hint="Ngày lập" Text="{Binding SelectedInvoice.InvoiceDate, StringFormat='dd/MM/yyyy HH:mm'}" IsReadOnly="True" Margin="{StaticResource Margin.Bottom.lg}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                
                                <Separator Margin="{StaticResource Margin.Bottom.lg}" Background="{StaticResource AppBorderBrush}"/>
                                
                                <Grid Margin="{StaticResource Margin.Bottom.sm}">
                                    <TextBlock Text="Cộng tiền hàng:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoice.SubTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="{StaticResource Margin.Bottom.sm}">
                                    <TextBlock Text="Thuế GTGT:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoice.TaxAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="{StaticResource Margin.Bottom.lg}">
                                    <TextBlock Text="TỔNG CỘNG:" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AppTertiaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoice.GrandTotal, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AppTertiaryBrush}"/>
                                </Grid>

                                <Separator Margin="{StaticResource Margin.Bottom.lg}" Background="{StaticResource AppBorderBrush}"/>

                                <Grid Margin="{StaticResource Margin.Bottom.md}">
                                    <TextBlock Text="Đã thu:" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoice.PaidAmount, StringFormat='N0'}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}"/>
                                </Grid>
                                
                                <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="{StaticResource Radius.md}" Padding="{StaticResource Spacing.md}" Margin="{StaticResource Margin.Bottom.md}">
                                    <StackPanel>
                                        <TextBlock Text="GHI CHÚ" Style="{StaticResource TypographyLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="{StaticResource Margin.Bottom.sm}"/>
                                        <TextBlock Text="{Binding SelectedInvoice.Notes}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource AppPrimaryBrush}" FontStyle="Italic"/>
                                        <TextBlock Text="Không có ghi chú" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedInvoice.Notes}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedInvoice.Notes}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Button Content="XUẤT PHIẾU THU" 
                                        Command="{Binding DataContext.OpenPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding SelectedInvoice}"
                                        Style="{StaticResource AppPrimaryButton}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
