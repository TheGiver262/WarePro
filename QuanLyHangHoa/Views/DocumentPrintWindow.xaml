<Window x:Class="QuanLyHangHoa.Views.DocumentPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước bản in" Width="794" Height="950" MaxHeight="1050"
        WindowStartupLocation="CenterOwner" Background="#ECEFF1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="PrintArea" Width="746" MinHeight="900" Margin="20"
                    Padding="44,36" Background="White">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WAREHOUSEPRO" FontSize="17" FontWeight="Bold" Foreground="#1A237E"/>
                            <TextBlock Text="PHẦN MỀM QUẢN LÝ HÀNG HÓA &amp; BẢO HÀNH"
                                       FontSize="10" Foreground="#5C6BC0"/>
                            <TextBlock Text="Địa chỉ: ........................................................"
                                       FontSize="9" Foreground="#666" Margin="0,4,0,0"/>
                            <TextBlock Text="Điện thoại: ........................  Email: ........................"
                                       FontSize="9" Foreground="#666"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Số chứng từ" FontSize="9" Foreground="#666" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Code}" FontSize="13" FontWeight="Bold"
                                       Foreground="#1A237E" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="#1A237E" BorderThickness="0,0,0,2" Margin="0,4,0,14"/>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#1A237E" Margin="0,0,0,16"/>

                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                            Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="THÔNG TIN CHỨNG TỪ"
                                       FontSize="10" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="9" Foreground="#666">
                                <Run Text="{Binding DateLabel}"/><Run Text=": "/>
                                <Run Text="{Binding DocumentDate, StringFormat=dd/MM/yyyy}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="9" Foreground="#666">
                                <Run Text="Kho: "/><Run Text="{Binding WarehouseName}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="9" Foreground="#666" Margin="0,5,0,0">
                                <Run Text="Chứng từ liên kết: "/><Run Text="{Binding LinkedDocumentCode}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="9" Foreground="#666" Margin="0,5,0,0">
                                <Run Text="Người lập: "/><Run Text="{Binding CreatedByName}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                            <TextBlock Grid.Row="3" Grid.Column="0" FontSize="9" Foreground="#666" Margin="0,5,0,0">
                                <Run Text="Trạng thái: "/><Run Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                            Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding PartnerLabel, StringFormat=THÔNG TIN {0}}"
                                       FontSize="10" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="9" Foreground="#666">
                                <Run Text="Tên: "/><Run Text="{Binding PartnerName}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="9" Foreground="#666">
                                <Run Text="Mã: "/><Run Text="{Binding PartnerCode}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="9" Foreground="#666" Margin="0,5,0,0">
                                <Run Text="Điện thoại: "/><Run Text="{Binding PartnerPhone}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" FontSize="9" Foreground="#666" Margin="0,5,0,0" TextWrapping="Wrap">
                                <Run Text="Địa chỉ: "/><Run Text="{Binding PartnerAddress}" FontWeight="SemiBold" Foreground="#333"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#B0BEC5" BorderThickness="1">
                        <StackPanel>
                            <Grid Background="#ECEFF1" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource PrintHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="MÃ SP" Style="{StaticResource PrintHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="TÊN SẢN PHẨM" Style="{StaticResource PrintHeaderText}"/>
                                <TextBlock Grid.Column="3" Text="ĐVT" Style="{StaticResource PrintHeaderText}"/>
                                <TextBlock Grid.Column="4" Text="SL" Style="{StaticResource PrintHeaderText}"/>
                                <TextBlock Grid.Column="5" Text="ĐƠN GIÁ" Style="{StaticResource PrintHeaderText}"/>
                                <TextBlock Grid.Column="6" Text="THUẾ" Style="{StaticResource PrintHeaderText}"/>
                                <TextBlock Grid.Column="7" Text="THÀNH TIỀN" Style="{StaticResource PrintHeaderText}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"/>
                                            <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource PrintCellCenter}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProductCode}" Style="{StaticResource PrintCellText}"/>
                                            <StackPanel Grid.Column="2" Margin="5,3">
                                                <TextBlock Text="{Binding ProductName}" FontSize="9" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Serials}" FontSize="8" Foreground="#777" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding UnitName}" Style="{StaticResource PrintCellCenter}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Quantity, StringFormat=N2}" Style="{StaticResource PrintCellRight}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding UnitPrice, StringFormat=N0}" Style="{StaticResource PrintCellRight}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding TaxRateText}" Style="{StaticResource PrintCellCenter}"/>
                                            <TextBlock Grid.Column="7" Text="{Binding LineTotal, StringFormat=N0}" Style="{StaticResource PrintCellRight}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="GHI CHÚ" FontSize="9" FontWeight="Bold" Foreground="#1A237E"/>
                            <TextBlock Text="{Binding Notes}" FontSize="9" Foreground="#444"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Cộng tiền hàng:" Style="{StaticResource PrintTotalLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, StringFormat=N0}" Style="{StaticResource PrintTotalValue}"/>
                            <TextBlock Grid.Row="1" Text="Tiền thuế:" Style="{StaticResource PrintTotalLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaxAmount, StringFormat=N0}" Style="{StaticResource PrintTotalValue}"/>
                            <TextBlock Grid.Row="2" Text="TỔNG CỘNG:" Style="{StaticResource PrintTotalLabel}" FontWeight="Bold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GrandTotal, StringFormat=N0}" Style="{StaticResource PrintTotalValue}" FontWeight="Bold"/>
                            <TextBlock Grid.Row="3" Text="Đã thanh toán:" Style="{StaticResource PrintTotalLabel}"
                                       Visibility="{Binding ShowPaymentSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PaidAmount, StringFormat=N0}" Style="{StaticResource PrintTotalValue}"
                                       Visibility="{Binding ShowPaymentSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="4" Text="Còn lại:" Style="{StaticResource PrintTotalLabel}" FontWeight="Bold"
                                       Visibility="{Binding ShowPaymentSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RemainingAmount, StringFormat=N0}" Style="{StaticResource PrintTotalValue}" FontWeight="Bold"
                                       Visibility="{Binding ShowPaymentSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LeftSignatureTitle}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký và ghi rõ họ tên)" FontSize="8" Foreground="#888" HorizontalAlignment="Center"/>
                            <Border Height="58"/>
                            <TextBlock Text="{Binding CreatedByName}" FontSize="9" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RightSignatureTitle}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký và ghi rõ họ tên)" FontSize="8" Foreground="#888" HorizontalAlignment="Center"/>
                            <Border Height="58"/>
                            <TextBlock Text="{Binding PartnerName}" FontSize="9" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="16">
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="IN CHỨNG TỪ" Click="PrintButton_Click" Padding="24,10"
                        FontSize="12" FontWeight="Bold" Background="#1A237E" Foreground="White"/>
                <Button Content="ĐÓNG" Click="CloseButton_Click" Margin="12,0,0,0"
                        Padding="24,10" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="PrintHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrintCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PrintCellCenter" TargetType="TextBlock" BasedOn="{StaticResource PrintCellText}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrintCellRight" TargetType="TextBlock" BasedOn="{StaticResource PrintCellText}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="PrintTotalLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="PrintTotalValue" TargetType="TextBlock" BasedOn="{StaticResource PrintTotalLabel}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
</Window>
