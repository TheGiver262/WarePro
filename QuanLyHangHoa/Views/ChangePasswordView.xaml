<UserControl x:Class="QuanLyHangHoa.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="{StaticResource Margin.Bottom.lg}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Key" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppPrimaryBrush}"/>
                <TextBlock Text="ĐỔI MẬT KHẨU" Style="{StaticResource TypographyH2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="40" MaxWidth="500" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="AccountCircle" Width="24" Height="24" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Username, StringFormat='Tài khoản: {0}'}" Style="{StaticResource TypographyBody}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                
                <Border Height="1" Background="{StaticResource AppBorderBrush}" Margin="0,16,0,32"/>

                <PasswordBox x:Name="CurrentPasswordBox"
                             materialDesign:HintAssist.Hint="Mật khẩu hiện tại" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             Margin="0,0,0,24" FontSize="14"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                
                <PasswordBox x:Name="NewPasswordBox"
                             materialDesign:HintAssist.Hint="Mật khẩu mới" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             Margin="0,0,0,24" FontSize="14"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                
                <PasswordBox x:Name="ConfirmPasswordBox"
                             materialDesign:HintAssist.Hint="Xác nhận mật khẩu mới" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             Margin="0,0,0,32" FontSize="14"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <Button Content="CẬP NHẬT MẬT KHẨU" 
                        Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource AppPrimaryButton}" 
                        Height="48"
                        Margin="0,0,0,24"/>

                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource AppTertiaryBrush}" 
                           TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                
                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                    <TextBlock Text="Lưu ý: Để đảm bảo an toàn, hãy sử dụng mật khẩu mạnh và không chia sẻ cho người khác." 
                               Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>
                </Border>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
