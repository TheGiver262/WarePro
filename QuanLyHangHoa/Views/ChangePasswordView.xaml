<UserControl x:Class="QuanLyHangHoa.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Doi mat khau" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Username, StringFormat='Tai khoan: {0}'}" Foreground="#A7F3D0" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Mat khau moi" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Xac nhan" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <Button Grid.Column="3" Content="Doi mat khau" Command="{Binding ChangePasswordCommand}" Background="#6366F1" Foreground="White" Padding="18,10" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="8" Padding="18">
            <TextBlock Text="Mat khau hien duoc luu theo co che hien tai cua ung dung de giu tuong thich du lieu cu. Co the nang cap hash mat khau rieng o module bao mat tiep theo." Foreground="#D1D5DB" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
