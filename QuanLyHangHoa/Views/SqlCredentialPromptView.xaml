<Window x:Class="QuanLyHangHoa.Views.SqlCredentialPromptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Kết nối cơ sở dữ liệu - WarePro"
        Width="460"
        Height="410"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Margin="20"
            Padding="28"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="Đăng nhập SQL Server"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="Nhập tài khoản được quản trị viên cấp. Mật khẩu được lưu an toàn cho tài khoản Windows hiện tại."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <TextBox x:Name="UserNameInput"
                     Grid.Row="1"
                     Margin="0,0,0,14"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Tên đăng nhập SQL Server"
                     materialDesign:HintAssist.IsFloating="True" />

            <PasswordBox x:Name="PasswordInput"
                         Grid.Row="2"
                         Margin="0,0,0,8"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         materialDesign:HintAssist.Hint="Mật khẩu"
                         materialDesign:HintAssist.IsFloating="True" />

            <TextBlock x:Name="ErrorText"
                       Grid.Row="3"
                       MinHeight="36"
                       Margin="0,4,0,10"
                       Foreground="{StaticResource DangerTextBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Padding="20,8"
                        Content="Hủy"
                        Click="Cancel_Click" />
                <Button Padding="20,8"
                        Content="Lưu và tiếp tục"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
