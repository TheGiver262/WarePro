<UserControl x:Class="QuanLyHangHoa.Views.ProductUnitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Don vi san pham"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Hang hoa" Foreground="White" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableProducts}"
                              SelectedItem="{Binding SelectedProduct}"
                              DisplayMemberPath="Name"
                              Background="#374151"
                              Foreground="White"
                              Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Don vi" Foreground="White" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableUnits}"
                              SelectedItem="{Binding SelectedUnit}"
                              DisplayMemberPath="Name"
                              Background="#374151"
                              Foreground="White"
                              Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Ty le ve don vi goc" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ConversionRateToBaseUnit, UpdateSourceTrigger=PropertyChanged}"
                             Background="#374151"
                             Foreground="White"
                             Padding="8"/>
                </StackPanel>

                <CheckBox Grid.Column="3"
                          Content="Don vi goc"
                          IsChecked="{Binding IsBaseUnit}"
                          Foreground="White"
                          VerticalAlignment="Bottom"
                          Margin="0,0,14,8"/>

                <Button Grid.Column="4"
                        Content="Luu"
                        Command="{Binding SaveProductUnitCommand}"
                        Background="#10B981"
                        Foreground="White"
                        Padding="18,10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Bang quy doi"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left"/>
                    <Button Content="Xoa"
                            Command="{Binding DeleteProductUnitCommand}"
                            Background="#EF4444"
                            Foreground="White"
                            Padding="14,8"
                            BorderThickness="0"
                            DockPanel.Dock="Right"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ProductUnits}"
                          SelectedItem="{Binding SelectedProductUnit}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="#111827"
                          Foreground="White"
                          RowBackground="#1F2937"
                          AlternatingRowBackground="#253142"
                          GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hang hoa" Binding="{Binding Product.Name}" Width="2*"/>
                        <DataGridTextColumn Header="Don vi" Binding="{Binding Unit.Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="Ty le ve don vi goc" Binding="{Binding ConversionRateToBaseUnit}" Width="1.5*"/>
                        <DataGridCheckBoxColumn Header="Don vi goc" Binding="{Binding IsBaseUnit}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
