<UserControl x:Class="QuanLyHangHoa.Views.BrandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search -->
                <RowDefinition Height="*"/>    <!-- Table -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Shield" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="THƯƠNG HIỆU" Style="{StaticResource TypographyH2}"/>
                        <TextBlock Text="Quản lý nhãn hiệu và các nhà sản xuất hệ thống" Style="{StaticResource TypographyCaption}"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddNewCommand}" Style="{StaticResource AppPrimaryButton}" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="THÊM THƯƠNG HIỆU" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row (Standardized Multi-field) -->
            <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" 
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Margin="{StaticResource Margin.Bottom.md}" Padding="16,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>     <!-- Code -->
                        <ColumnDefinition Width="*"/>     <!-- Name -->
                        <ColumnDefinition Width="*"/>     <!-- Status -->
                        <ColumnDefinition Width="Auto"/>  <!-- Export -->
                    </Grid.ColumnDefinitions>

                    <!-- Code -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Mã thương hiệu" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SearchTextBoxStyle}" 
                                 Height="50" materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                 Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,10,0"
                                 materialDesign:HintAssist.IsFloating="False"
                                 materialDesign:HintAssist.Hint="Tìm theo mã..."/>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Tên thương hiệu" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SearchTextBoxStyle}" 
                                 Height="50" materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                 Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,10,0"
                                 materialDesign:HintAssist.IsFloating="False"
                                 materialDesign:HintAssist.Hint="Tìm theo tên..."/>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Trạng thái" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                  Margin="0" Height="50" Padding="12,0"
                                  materialDesign:HintAssist.IsFloating="False"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                  ItemsSource="{Binding StatusOptions}" 
                                  SelectedItem="{Binding SearchStatus, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Export -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Top">
                        <TextBlock Text="Thao tác" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6" Opacity="0"/>
                        <Button Style="{StaticResource AppPrimaryButton}" Command="{Binding ExportToExcelCommand}" 
                                Height="50" Padding="16,0" materialDesign:ButtonAssist.CornerRadius="{StaticResource Radius.sm}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Content Area (DataGrid) -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                              AlternationCount="10000" EnableRowVirtualization="False"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="54" BorderThickness="0" Background="Transparent">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        
                        <DataGrid.Columns>
                            <!-- Index Column -->
                            <DataGridTextColumn Header="STT" Width="60" CanUserSort="False"
                                                Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowIndexConverter}}"
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>

                            <!-- Code Column -->
                            <DataGridTextColumn Binding="{Binding BrandCode}" Width="200" 
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="MÃ THƯƠNG HIỆU" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <!-- Name Column -->
                            <DataGridTemplateColumn Width="*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TÊN THƯƠNG HIỆU" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Origin Column -->
                            <DataGridTextColumn Header="XUẤT XỨ" Binding="{Binding OriginCountry}" Width="200" 
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>

                            <!-- Status Column (Pro Max Chips) -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="180" SortMemberPath="IsActive">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,4" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" >
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="NGỪNG HOẠT ĐỘNG"/>
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="ĐANG HOẠT ĐỘNG"/>
                                                                    <Setter Property="Foreground" Value="#166534"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="38" Height="38" ToolTip="Chỉnh sửa"
                                                    Command="{Binding DataContext.EditBrandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="22" Height="22" Foreground="{StaticResource AppTertiaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="38" Height="38" ToolTip="Xoá thương hiệu"
                                                    Command="{Binding DataContext.DeleteBrandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="22" Height="22" Foreground="{StaticResource DangerTextBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="1" Padding="20,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Hiện có {0} thương hiệu trong hệ thống">
                                    <Binding Path="Brands.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Overlay Edit Panel -->
        <Border Background="#40000000" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Border Background="{StaticResource AppSurfaceBrush}" Padding="20,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Trademark" Foreground="{StaticResource AppPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="THÔNG TIN THƯƠNG HIỆU" Style="{StaticResource TypographyH3}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Panel Content -->
                    <StackPanel Grid.Row="1" Margin="24">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Mã thương hiệu" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="54" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.IsFloating="False"
                                     materialDesign:HintAssist.Hint="Nhập mã thương hiệu (viết liền, không dấu)"
                                     Text="{Binding EditBrandCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Tên thương hiệu" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="54" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.IsFloating="False"
                                     materialDesign:HintAssist.Hint="Nhập tên hiển thị thương hiệu"
                                     Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Xuất xứ" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="54" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.IsFloating="False"
                                     materialDesign:HintAssist.Hint="Nhập quốc gia xuất xứ"
                                     Text="{Binding EditOriginCountry, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <CheckBox Content="Đang hoạt động" IsChecked="{Binding EditIsActive}" 
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AppPrimaryBrush}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Panel Footer -->
                    <Border Grid.Row="2" Background="{StaticResource AppBackgroundBrush}" Padding="24,16" CornerRadius="0,0,12,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="HUỶ" Width="100" Height="40" Margin="0,0,12,0"
                                    Command="{Binding CancelCommand}"/>
                            <Button Style="{StaticResource AppPrimaryButton}" Content="LƯU THÔNG TIN" Width="150" Height="41" 
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Border>
    </Grid>
</UserControl>
