<UserControl x:Class="QuanLyHangHoa.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <!-- Cột trái: Chọn danh sách nhập -->
            <ColumnDefinition Width="5*"/>
            <!-- Cột phải: Xem tổng quát phiếu nhập -->
        </Grid.ColumnDefinitions>

        <!-- KHIẾU BÊN TRÁI: TẤT CẢ SẢN PHẨM KHAI BÁO -->
        <Border Grid.Column="0" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="MENU HÀNG NGUYÊN LIỆU" FontWeight="Bold" FontSize="18" Foreground="#2980B9" Margin="0,0,0,15"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding Id}" />
                        <DataGridTextColumn Header="Tên Hàng" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Kho" Binding="{Binding Quantity}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2" Margin="0,15,0,0" Content="CHỌN NHẬP MẶT HÀNG NÀY ➡" 
                        Command="{Binding AddToImportListCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#2980B9" BorderBrush="#2980B9"/>
            </Grid>
        </Border>

        <!-- KHU BÊN PHẢI: CHI TIẾT PHIẾU NHẬP -->
        <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15" Background="#F4F6F6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CHI TIẾT PHIẾU NHẬP KHO" FontWeight="Bold" FontSize="18" Foreground="#2980B9" Margin="0,0,0,15"/>

                <!-- Bản xem trước DataGrid Phiếu Nhập -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding ImportItems}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Product.Name}" IsReadOnly="True" Width="*"/>
                        <!-- Edit trực tiếp số lượng và giá trên DataGrid -->
                        <DataGridTextColumn Header="SL Nhập" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Giá Gồm VAT" Binding="{Binding ImportPrice, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <Separator Margin="0,0,0,10"/>
                    <Grid>
                        <TextBlock Text="TỔNG VỐN DỰ TÍNH:" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding TotalImportAmount, StringFormat='{}{0:N0} VNĐ'}" FontWeight="Bold" FontSize="20" Foreground="#D35400" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button Content="THỰC THI CHỨT KHO (LƯU)" Height="60" FontSize="18" FontWeight="Bold" Margin="0,15,0,0"
                            Command="{Binding CompleteImportCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#16A085" BorderBrush="#16A085"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
