<Window x:Class="QuanLyHangHoa.Views.ImportResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Kết quả Import" Height="500" Width="700" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Border CornerRadius="{StaticResource Radius.lg}" Background="{StaticResource AppSurfaceBrush}" 
            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                <RowDefinition Height="*"/>    <!-- Error List -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBgBrush}" Padding="16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileImport" Foreground="White" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="KẾT QUẢ IMPORT DỮ LIỆU" Foreground="White" FontWeight="Bold" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}" 
                            Padding="0" Width="30" Height="30" Click="Close_Click">
                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Summary Bar -->
            <Border Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" Padding="20,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:Card Background="#E8F5E9" Padding="12,8" Margin="0,0,16,0" materialDesign:ElevationAssist.Elevation="Dp0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSuccess" Text="Thành công: 0" Foreground="#2E7D32" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Background="#FFEBEE" Padding="12,8" materialDesign:ElevationAssist.Elevation="Dp0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C62828" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtFailed" Text="Thất bại: 0" Foreground="#C62828" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Border>

            <!-- Error List -->
            <Grid Grid.Row="2" Margin="{StaticResource PagePadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="DANH SÁCH CHI TIẾT LỖI" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                
                <DataGrid Grid.Row="1" x:Name="DgErrors" AutoGenerateColumns="False" IsReadOnly="True" 
                          ItemsSource="{Binding Errors}" Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DÒNG" Binding="{Binding RowNumber}" Width="80" ElementStyle="{StaticResource TextCenterElementStyle}"/>
                        <DataGridTextColumn Header="DỮ LIỆU GỐC" Binding="{Binding Data}" Width="150"/>
                        <DataGridTextColumn Header="CHI TIẾT LỖI" Binding="{Binding ErrorMessage}" Width="*" ElementStyle="{StaticResource TextErrorElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Footer Buttons -->
            <Border Grid.Row="3" Background="{StaticResource AppBackgroundBrush}" Padding="{StaticResource PagePadding}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                <Button Content="ĐÓNG CỬA SỔ" Style="{StaticResource PrimaryButton}" 
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
