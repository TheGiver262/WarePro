<UserControl x:Class="QuanLyHangHoa.Views.StockInView"
             x:Name="RootStockInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             xmlns:helpers="clr-namespace:QuanLyHangHoa.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:StockInViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WarePro;component/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <TextBlock Panel.ZIndex="10"
                   Text="{Binding WriteStatus}"
                   Style="{StaticResource TypographyCaption}"
                   Foreground="{StaticResource AppSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,12,0,0"
                   IsHitTestVisible="False"/>
        <!-- ═══════════════════════════════════════════ -->
        <!-- LIST VIEW                                   -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Margin="{StaticResource PagePadding}" Visibility="{Binding IsListViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search & Stats -->
                <RowDefinition Height="*"/>    <!-- Table -->
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ArrowDownBold" Width="32" Height="32" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="QUẢN LÝ NHẬP KHO" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Danh sách và quản lý các phiếu nhập kho hàng hóa" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CreateNewCommand}" Style="{StaticResource PrimaryButton}" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="TẠO PHIẾU MỚI" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 1: Search Row (Standardized Pro Max) -->
            <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Padding="{StaticResource Spacing.md}" Style="{StaticResource AppCard}">
                <StackPanel>
                    <!-- Main Search Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>      <!-- Số phiếu -->
                            <ColumnDefinition Width="*"/>        <!-- Nhà cung cấp -->
                            <ColumnDefinition Width="130"/>      <!-- Từ ngày -->
                            <ColumnDefinition Width="130"/>      <!-- Đến ngày -->
                            <ColumnDefinition Width="Auto"/>     <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="SỐ PHIẾU" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Mã phiếu..."
                                     Text="{Binding SearchDocumentCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Tên NCC..."
                                     Text="{Binding SearchSupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="TỪ NGÀY" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <DatePicker Style="{StaticResource AppDatePickerStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                        materialDesign:HintAssist.Hint="Từ ngày..."
                                        SelectedDate="{Binding FilterFromDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <DatePicker Style="{StaticResource AppDatePickerStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                        materialDesign:HintAssist.Hint="Đến ngày..."
                                        SelectedDate="{Binding FilterToDate}"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ToggleAdvancedFilterCommand}"
                                    ToolTip="Lọc nâng cao"
                                    Width="180" Height="32" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="BỘ LỌC NÂNG CAO" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource AppRefreshButton}" 
                                    Command="{Binding ResetFilterCommand}"
                                    ToolTip="Làm mới bộ lọc"
                                    Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                            </Button>

                            <Button Style="{StaticResource AppExcelButton}" 
                                    Command="{Binding ExportExcelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Filter Row (Expandable) -->
                    <Grid Margin="0,16,0,0" Visibility="{Binding IsAdvancedFilterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>      <!-- Kho hàng -->
                            <ColumnDefinition Width="180"/>      <!-- Trạng thái -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="KHO HÀNG" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="40" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding AvailableWarehouses}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedWarehouseFilter}"
                                      materialDesign:HintAssist.Hint="Tất cả kho"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="40" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- DataGrid Section -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid Grid.Row="0" ItemsSource="{Binding StockInList}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" IsReadOnly="True" RowHeight="56"
                               EnableRowVirtualization="True"
                               VirtualizingPanel.VirtualizationMode="Standard"
                               VirtualizingPanel.ScrollUnit="Pixel"
                               helpers:DataGridHelper.LoadMoreCommand="{Binding LoadMoreCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding DocumentCode}" Width="150" ElementStyle="{DynamicResource AppDataGridTextBold}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="MÃ PHIẾU" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding ImportDate, StringFormat='dd/MM/yyyy'}" Width="120" ElementStyle="{DynamicResource AppDataGridTextCenter}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="NGÀY NHẬN" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Supplier.DisplayName}" Width="*" ElementStyle="{DynamicResource AppDataGridText}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Warehouse.DisplayName}" Width="150" ElementStyle="{DynamicResource AppDataGridText}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="KHO" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Creator.FullName}" Width="150" ElementStyle="{DynamicResource AppDataGridText}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="NGƯỜI LẬP" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="140" CellTemplate="{StaticResource InventoryStatusBadgeTemplate}">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="THAO TÁC" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xem chi tiết"
                                                    Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20" Foreground="{StaticResource AppPrimaryBrush}"/>
                                            </Button>
                                            <Button ToolTip="Chỉnh sửa"
                                                     Command="{Binding DataContext.EditDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                 <Button.Style>
                                                     <Style TargetType="Button" BasedOn="{StaticResource ProMaxIconButtonStyle}">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <MultiDataTrigger>
                                                                 <MultiDataTrigger.Conditions>
                                                                     <Condition Binding="{Binding Status}" Value="nháp"/>
                                                                     <Condition Binding="{Binding DataContext.CanUserEdit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                                                                 </MultiDataTrigger.Conditions>
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </MultiDataTrigger>
                                                             <MultiDataTrigger>
                                                                 <MultiDataTrigger.Conditions>
                                                                     <Condition Binding="{Binding Status}" Value="Draft"/>
                                                                     <Condition Binding="{Binding DataContext.CanUserEdit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                                                                 </MultiDataTrigger.Conditions>
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </MultiDataTrigger>
                                                             <MultiDataTrigger>
                                                                 <MultiDataTrigger.Conditions>
                                                                     <Condition Binding="{Binding Status}" Value="draft"/>
                                                                     <Condition Binding="{Binding DataContext.CanUserEdit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                                                                 </MultiDataTrigger.Conditions>
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </MultiDataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Button.Style>
                                                 <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" Foreground="{StaticResource AppSecondaryBrush}"/>
                                             </Button>
                                            <Button ToolTip="Xóa phiếu nháp" Style="{StaticResource ProMaxIconButtonStyle}"
                                                    Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                            </Button>
                                             <Button ToolTip="Duyệt phiếu"
                                                     Command="{Binding DataContext.ApproveDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                 <Button.Style>
                                                     <Style TargetType="Button" BasedOn="{StaticResource ProMaxIconButtonStyle}">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <MultiDataTrigger>
                                                                 <MultiDataTrigger.Conditions>
                                                                     <Condition Binding="{Binding Status}" Value="Draft"/>
                                                                     <Condition Binding="{Binding DataContext.IsAdminOrManager, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                                                                 </MultiDataTrigger.Conditions>
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </MultiDataTrigger>
                                                             <MultiDataTrigger>
                                                                 <MultiDataTrigger.Conditions>
                                                                     <Condition Binding="{Binding Status}" Value="nháp"/>
                                                                     <Condition Binding="{Binding DataContext.IsAdminOrManager, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                                                                 </MultiDataTrigger.Conditions>
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="PendingApproval"/>
                                                                    <Condition Binding="{Binding DataContext.IsAdminOrManager, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="Approved"/>
                                                                    <Condition Binding="{Binding DataContext.IsAdminOrManager, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Button.Style>
                                                 <materialDesign:PackIcon Kind="CheckDecagramOutline" Width="20" Height="20" Foreground="{StaticResource SuccessTextBrush}"/>
                                             </Button>
                                             <Button ToolTip="In phiếu"
                                                     Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                 <Button.Style>
                                                     <Style TargetType="Button" BasedOn="{StaticResource ProMaxIconButtonStyle}">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding Status}" Value="đã ghi sổ">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Posted">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="posted">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="đã duyệt">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="approved">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Button.Style>
                                                 <materialDesign:PackIcon Kind="PrinterOutline" Width="20" Height="20" Foreground="{StaticResource AppTertiaryBrush}"/>
                                             </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer Stats -->
                    <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Run Text="Hiện có "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=" phiếu nhập trong hệ thống · "/>
                            <Run Text="{Binding DraftCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource WarningTextBrush}"/>
                            <Run Text=" Nháp · "/>
                            <Run Text="{Binding PostedCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                            <Run Text=" Đã ghi sổ"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>

        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- DETAIL/CREATE VIEW                          -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Margin="{StaticResource PagePadding}" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Info -->
                <RowDefinition Height="Auto"/> <!-- Add Line Button -->
                <RowDefinition Height="*"/>    <!-- Lines -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding BackToListCommand}" Style="{StaticResource ProMaxIconButtonStyle}" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="{StaticResource AppPrimaryBrush}"/>
                    </Button>
                    <materialDesign:PackIcon Kind="ArrowDownBold" Width="32" Height="32" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="CHI TIẾT PHIẾU NHẬP" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="{Binding DocumentCode}" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryStatusBadgeTemplate}" 
                                    VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Button Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Height="36" 
                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="LƯU NHÁP" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ConfirmAndPostCommand}" Style="{StaticResource PrimaryButton}" Height="36"
                            Visibility="{Binding CanApprove, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckDecagramOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="PHÊ DUYỆT" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Document Info Fields -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Background="{StaticResource SurfaceMutedBrush}" Margin="{StaticResource SectionBottomMargin}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="MÃ PHIẾU" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DetailFormTextBoxStyle}" IsReadOnly="True" Width="130"
                                 materialDesign:TextFieldAssist.HasClearButton="False"
                                 Text="{Binding DocumentCode}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="KHO HÀNG" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Width="160" Style="{StaticResource DetailFormComboBoxStyle}" 
                                  ItemsSource="{Binding AvailableWarehouses}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  IsEnabled="{Binding CanEdit}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,24,0">
                        <TextBlock Text="NHÀ CUNG CẤP" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Width="200" Style="{StaticResource DetailFormComboBoxStyle}" 
                                  ItemsSource="{Binding AvailableSuppliers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSupplier}"
                                  IsEnabled="{Binding CanEdit}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,24,0">
                        <TextBlock Text="NGÀY NHẬP" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <DatePicker Width="140" Style="{StaticResource DetailFormDatePickerStyle}" SelectedDate="{Binding ImportDate}"
                                    IsEnabled="{Binding CanEdit}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,24,0">
                        <TextBlock Text="GHI CHÚ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DetailFormTextBoxStyle}" materialDesign:HintAssist.Hint="Ghi chú nhập kho..."
                                 Text="{Binding Notes}"
                                 IsReadOnly="{Binding CanEdit, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                </Grid>
            </materialDesign:Card>

            <!-- Add Line Button -->
            <Button Grid.Row="2" Command="{Binding AddLineCommand}" Style="{StaticResource SecondaryButton}" Height="36"
                    HorizontalAlignment="Left" Margin="0,12,0,0"
                    Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="THÊM DÒNG SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                </StackPanel>
            </Button>

            <!-- Row 3: Items List -->
            <materialDesign:Card Grid.Row="3" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Lines}" 
                               EnableRowVirtualization="True"
                               VirtualizingPanel.VirtualizationMode="Standard"
                               VirtualizingPanel.ScrollUnit="Pixel"
                               CanUserReorderColumns="False"
                               AutoGenerateColumns="False" CanUserAddRows="False" 
                               RowHeight="64" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" LostFocus="ProductComboBox_LostFocus"
                                                  DisplayMemberPath="DisplayName" Style="{StaticResource AppComboBoxStyle}" Margin="8,4" BorderThickness="0" Height="36"
                                                  IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="ĐƠN VỊ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableUnits}" 
                                                  SelectedItem="{Binding SelectedUnit, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" LostFocus="UnitComboBox_LostFocus"
                                                  DisplayMemberPath="DisplayName" Style="{StaticResource AppComboBoxStyle}" Margin="8,4" BorderThickness="0" Height="36"
                                                  IsEnabled="{Binding DataContext.CanEdit, ElementName=RootStockInView}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="SỐ LƯỢNG" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" 
                                                  Style="{StaticResource AppTextBoxStyle}" Margin="8,4" Height="36"
                                                  IsReadOnly="{Binding DataContext.CanEdit, ElementName=RootStockInView, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="160">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="ĐƠN GIÁ NHẬP" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" IsReadOnly="True" HorizontalContentAlignment="Right" 
                                                  Style="{StaticResource AppTextBoxStyle}" Margin="8,4" Height="36"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="180">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="SERIAL" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,4">
                                            <!-- If serial is required -->
                                            <Grid Visibility="{Binding IsSerialRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Serial detail list (wrapped) -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TypographyCaption}">
                                                                <Setter Property="Text" Value="{Binding SerialDetail}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SerialNumbers.Count}" Value="0">
                                                                        <Setter Property="Text" Value="Chưa có Serial"/>
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSerialComplete}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    
                                                    <!-- Serial summary count if complete -->
                                                    <TextBlock Text="{Binding SerialSummary}" Style="{StaticResource TypographyCaption}" Opacity="0.6" Margin="0,2,0,0"
                                                               Visibility="{Binding IsSerialComplete, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>

                                                <!-- Edit button -->
                                                <Button Grid.Column="1" Style="{StaticResource ProMaxIconButtonStyle}"
                                                        Command="{Binding DataContext.OpenSerialInputCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Center" Margin="8,0,0,0" Width="32" Height="32" Padding="0">
                                                    <materialDesign:PackIcon Kind="BarcodeScan" Width="18" Height="18">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSerialComplete}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Button>
                                            </Grid>
                                            
                                            <!-- If serial is not required -->
                                            <TextBlock Text="N/A" Visibility="{Binding IsSerialRequired, Converter={StaticResource InverseBooleanToVisibilityConverter}}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="THAO TÁC" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                         <Button Style="{StaticResource ProMaxIconButtonStyle}" Margin="4" HorizontalAlignment="Center"
                                                 Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}"
                                                 Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Detail Footer -->
                    <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Run Text="Tổng "/>
                                <Run Text="{Binding Lines.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Run Text=" dòng hàng"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="TỔNG GIÁ TRỊ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="0,0,16,0" Foreground="{StaticResource AppSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat='N0'}" VerticalAlignment="Center" Style="{StaticResource TypographyStatNumber}" Foreground="{StaticResource AppPrimaryBrush}" FontSize="24"/>
                                <TextBlock Text="VNĐ" VerticalAlignment="Center" Style="{StaticResource TypographyCaption}" Margin="8,4,0,0" Foreground="{StaticResource AppSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
