<UserControl x:Class="QuanLyHangHoa.Views.StockInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.DataContext>
        <vm:StockInViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header / Toolbar -->
            <materialDesign:Card Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}" Background="Transparent" materialDesign:ShadowAssist.ShadowDepth="Depth0" Padding="{StaticResource Spacing.sm}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowDownBox" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="NHẬP KHO HÀNG HÓA" Style="{StaticResource TypographyH2}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource AppPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="HỦY PHIẾU" Command="{Binding CancelCommand}" 
                                Style="{StaticResource AppSecondaryButton}" Margin="{StaticResource Margin.Right.md}"/>
                        <Button Content="XÁC NHẬN NHẬP KHO" Command="{Binding SaveStockInCommand}" 
                                Style="{StaticResource AppPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Search Row (Integrated Search) -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" Height="40" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="{StaticResource Padding.sm}" Foreground="{StaticResource AppSecondaryBrush}"/>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 materialDesign:HintAssist.Hint="Tìm kiếm sản phẩm hoặc mã phiếu..." 
                                 FontSize="14" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Content="TÌM KIẾM" Command="{Binding LoadDataCommand}" Style="{StaticResource AppSecondaryButton}" Margin="{StaticResource Margin.Left.sm}" Height="40"/>
            </Grid>

            <!-- Main Form Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Items List Card (LEFT) -->
                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.md}" Style="{StaticResource AppCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Padding="{StaticResource Spacing.md}" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource Radius.lg}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                                    <TextBlock Text="DANH SÁCH MẶT HÀNG NHẬP" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource AppPrimaryBrush}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Content="THÊM DÒNG" Command="{Binding AddLineCommand}" 
                                        Style="{StaticResource AppSecondaryButton}" Height="32" Padding="12,0" FontSize="12"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  BorderThickness="0" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="{StaticResource Spacing.sm}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="SỐ LƯỢNG" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" 
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="{StaticResource Spacing.sm}" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="ĐƠN GIÁ" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" HorizontalContentAlignment="Right" 
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="{StaticResource Spacing.sm}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource AppErrorBrush}" Width="32" Height="32" Padding="0"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Padding="{StaticResource Spacing.md}" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="TRẠNG THÁI:" VerticalAlignment="Center" Style="{StaticResource TypographyCaption}" Margin="{StaticResource Margin.Right.sm}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AppTertiaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Document Info Card (RIGHT) -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.md}">
                            <materialDesign:PackIcon Kind="FileDocumentEditOutline" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="THÔNG TIN PHIẾU" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Mã số phiếu nhập (Tự động)" IsReadOnly="True" Margin="{StaticResource Margin.Bottom.md}" 
                                 Text="{Binding DocumentCode}" FontSize="14"/>
                        
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Kho hàng tiếp nhận" Margin="{StaticResource Margin.Bottom.md}" IsEnabled="False" SelectedIndex="0" FontSize="14">
                            <ComboBoxItem Content="Kho tổng mặc định"/>
                        </ComboBox>

                        <DatePicker Style="{StaticResource MaterialDesignOutlinedDatePicker}" materialDesign:HintAssist.Hint="Ngày lập phiếu" Margin="{StaticResource Margin.Bottom.md}" 
                                    SelectedDate="{Binding ImportDate}" FontSize="14"/>

                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Ghi chú nội bộ" Height="100" 
                                 TextWrapping="Wrap" VerticalAlignment="Top" AcceptsReturn="True" Margin="{StaticResource Margin.Top.sm}" FontSize="14"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

