<UserControl x:Class="QuanLyHangHoa.Views.WarrantyClaimView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Search -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Action Form -->
                <RowDefinition Height="*"/>    <!-- Row 3: DataGrid -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AppTertiaryBrush}" Width="40" Height="40" CornerRadius="{StaticResource Radius.md}">
                        <materialDesign:PackIcon Kind="Tools" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextOnPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="YÊU CẦU BẢO HÀNH" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppPrimaryBrush}" Margin="{StaticResource Margin.Left.md}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Tìm kiếm theo mã phiếu, serial/IMEI..." 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{StaticResource Margin.Right.sm}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Command="{Binding LoadDataCommand}"
                        Style="{StaticResource AppPrimaryButton}" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Search" Width="20" Height="20"/>
                        <TextBlock Text="TÌM KIẾM" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 2: Action Form Row (Horizontal) -->
            <materialDesign:Card Grid.Row="2" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/> <!-- Claim Code -->
                        <ColumnDefinition Width="1.5*"/> <!-- Serial -->
                        <ColumnDefinition Width="3*"/>   <!-- Problem -->
                        <ColumnDefinition Width="Auto"/> <!-- Buttons -->
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Mã phiếu" Margin="{StaticResource Margin.Right.sm}"
                             Text="{Binding SelectedWarranty.ClaimCode}" IsReadOnly="True"
                             />

                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Serial / IMEI" Margin="{StaticResource Margin.Right.sm}"
                             Text="{Binding SelectedWarranty.ProductSerial.SerialNumber}" IsReadOnly="True"
                             />

                    <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Mô tả lỗi / Yêu cầu" Margin="{StaticResource Margin.Right.sm}"
                             Text="{Binding SelectedWarranty.ProblemDescription}"
                             />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="LƯU" Command="{Binding SaveWarrantyCommand}" 
                                Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Right.sm}"/>
                        <Button Content="XÓA" Command="{Binding DeleteWarrantyCommand}" 
                                Style="{StaticResource AppDangerButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 3: Data Table -->
            <materialDesign:Card Grid.Row="3" Style="{StaticResource AppCard}" Padding="0">
                <DataGrid ItemsSource="{Binding Warranties}" SelectedItem="{Binding SelectedWarranty}"
                           AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                           BorderThickness="0" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ PHIẾU" Binding="{Binding ClaimCode}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                        <DataGridTextColumn Header="NGÀY NHẬN" Binding="{Binding ReceivedDate, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                        <DataGridTextColumn Header="SERIAL / IMEI" Binding="{Binding ProductSerial.SerialNumber}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        <DataGridTextColumn Header="SẢN PHẨM" Binding="{Binding ProductSerial.Product.Name}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding WarrantyCoverage.Customer.FullName}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Open">
                                            <Setter Property="Foreground" Value="{StaticResource AppTertiaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                            <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Ready">
                                            <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Closed">
                                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
