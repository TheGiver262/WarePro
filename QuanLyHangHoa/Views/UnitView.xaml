<UserControl x:Class="QuanLyHangHoa.Views.UnitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QuanLyHangHoa.Views"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"

             Background="#111827">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Qu?n Lý Ðon V? Tính" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                      AutoGenerateColumns="False" CanUserAddRows="False" Background="#1F2937" Foreground="White" RowBackground="#374151" AlternatingRowBackground="#1F2937">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tên Ðon V?" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Form -->
            <Border Grid.Column="1" Background="#1F2937" CornerRadius="8" Margin="20,0,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Tên don v?:" Foreground="White" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8" BorderThickness="0" Margin="0,0,0,20"/>
                    
                    <Button Content="Thêm M?i" Command="{Binding AddCommand}" Background="#10B981" Foreground="White" Padding="10" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand"/>
                    <Button Content="Luu Thay Ð?i" Command="{Binding SaveEditCommand}" Background="#3B82F6" Foreground="White" Padding="10" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand"/>
                    <Button Content="Import Data" Command="{Binding ImportDataCommand}" Background="#1F2937" Foreground="White" Padding="10" BorderThickness="1" BorderBrush="#3B82F6" Margin="0,0,0,10" Cursor="Hand"/>
                    <Button Content="Xoá" Command="{Binding DeleteCommand}" Background="#EF4444" Foreground="White" Padding="10" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
