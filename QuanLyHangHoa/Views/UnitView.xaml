<UserControl x:Class="QuanLyHangHoa.Views.UnitView"
             x:Name="RootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             xmlns:helpers="clr-namespace:QuanLyHangHoa.Helpers"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}" MaxWidth="1600" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search -->
                <RowDefinition Height="*"/>    <!-- Table -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CubeOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="ĐƠN VỊ TÍNH" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Quản lý đơn vị đo lường sản phẩm và quy cách đóng gói" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding OpenAddUnitDialogCommand}" Style="{StaticResource PrimaryButton}" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="THÊM MỚI" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}" Margin="{StaticResource Margin.Bottom.md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>       <!-- Mã đơn vị -->
                        <ColumnDefinition Width="*"/>         <!-- Tên đơn vị -->
                        <ColumnDefinition Width="180"/>       <!-- Trạng thái -->
                        <ColumnDefinition Width="Auto"/>      <!-- Nút hành động -->
                    </Grid.ColumnDefinitions>

                    <!-- Code -->
                    <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="MÃ ĐƠN VỊ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" materialDesign:HintAssist.Hint="Tìm theo mã..." 
                                 Height="32" Margin="0" VerticalContentAlignment="Center"
                                 Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="TÊN ĐƠN VỊ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" materialDesign:HintAssist.Hint="Tìm theo tên..." 
                                 Height="32" Margin="0" VerticalContentAlignment="Center"
                                 Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SearchStatus, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource AppRefreshButton}" 
                                Command="{Binding RefreshCommand}"
                                ToolTip="Làm mới bộ lọc"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AppExcelButton}" 
                                Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Data Table -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Table Header Border -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>
                    
                    <!-- Table Header Border -->                
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                               AlternationCount="10000" EnableRowVirtualization="False"
                               AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                               RowHeight="52" BorderThickness="0" Background="Transparent">
                        <DataGrid.Columns>
                            
                            <!-- Unit Code Column with Filter Icon -->
                            <DataGridTemplateColumn Width="180" SortMemberPath="UnitCode">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="MÃ ĐƠN VỊ" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitCode}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource AppPrimaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Display Name Column with Filter Icon -->
                            <DataGridTemplateColumn Width="*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TÊN ĐƠN VỊ TÍNH" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="12,0" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Status Column with Filter Icon -->
                            <!-- Status Column -->
                            <DataGridTemplateColumn Width="130" SortMemberPath="IsActive"
                                                    CellTemplate="{StaticResource BooleanStatusBadgeTemplate}">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TRẠNG THÁI" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                            </DataGridTemplateColumn>

                             <!-- Actions Column -->
                             <DataGridTemplateColumn Header="THAO TÁC" Width="130" Visibility="{Binding Data.CanManage, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Chỉnh sửa"
                                                    Command="{Binding DataContext.EditUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xoá đơn vị"
                                                    Command="{Binding DataContext.DeleteUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="2" VerticalAlignment="Bottom" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Left">
                            <Run Text="Hiện có "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=" đơn vị tính trong hệ thống · "/>
                            <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                            <Run Text=" Hoạt động · "/>
                            <Run Text="{Binding InactiveCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}"/>
                            <Run Text=" Dừng"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
