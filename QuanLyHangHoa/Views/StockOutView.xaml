<UserControl x:Class="QuanLyHangHoa.Views.StockOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.DataContext>
        <vm:StockOutViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowUpBox" Width="28" Height="28" VerticalAlignment="Center" Foreground="#E91E63"/>
                    <TextBlock Text="PHIẾU XUẤT KHO" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#333333"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="HỦY BỎ" Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" Height="40" Margin="0,0,12,0"/>
                    <Button Content="XUẤT KHO" Command="{Binding SaveStockOutCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E91E63" BorderBrush="#E91E63" materialDesign:ButtonAssist.CornerRadius="8" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Document Info Card -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="20">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN XUẤT KHO" FontWeight="Bold" FontSize="16" Foreground="#E91E63" Margin="0,0,0,20"/>

                    <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Mã phiếu" IsReadOnly="True" Margin="0,0,0,16" Text="{Binding DocumentCode}"/>
                    
                    <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" materialDesign:HintAssist.Hint="Kho xuất" Margin="0,0,0,16" IsEnabled="False" SelectedIndex="0">
                        <ComboBoxItem Content="Kho chính (Default)"/>
                    </ComboBox>

                    <ComboBox Style="{StaticResource MaterialDesignFloatingHintComboBox}" materialDesign:HintAssist.Hint="Khách hàng" Margin="0,0,0,16"
                              ItemsSource="{Binding AvailableCustomers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedCustomer}"/>

                    <DatePicker Style="{StaticResource MaterialDesignFloatingHintDatePicker}" materialDesign:HintAssist.Hint="Ngày xuất" Margin="0,0,0,16" SelectedDate="{Binding ExportDate}"/>

                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Lý do xuất / Ghi chú" Height="100" TextWrapping="Wrap" VerticalAlignment="Top" AcceptsReturn="True" Margin="0,8,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Grid Card -->
            <materialDesign:Card Grid.Column="1" Margin="12,0,0,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16,12" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <Grid>
                            <TextBlock Text="DANH SÁCH HÀNG XUẤT" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Content="CHỌN SẢN PHẨM" Command="{Binding AddLineCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="8,0" FontSize="12"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" 
                              Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Sản phẩm" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DisplayName" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price, StringFormat='N0'}" Width="120"/>
                            
                            <DataGridTemplateColumn Header="Số lượng" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" HorizontalContentAlignment="Right" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Serial Numbers" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Chọn Serial" Style="{StaticResource MaterialDesignFlatButton}" Height="30" Padding="4,0" FontSize="11" Foreground="#FF9800"
                                                Command="{Binding DataContext.OpenSerialInputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="Red" Width="24" Height="24" Padding="0"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Padding="16" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Tổng tiền xuất:" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#666666"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat='N0'}" FontWeight="Bold" FontSize="18" Foreground="#E91E63"/>
                            <TextBlock Text=" VNĐ" VerticalAlignment="Bottom" Margin="4,0,0,2" FontSize="12" Foreground="#666666"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
