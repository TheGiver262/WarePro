<UserControl x:Class="QuanLyHangHoa.Views.StockCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <UserControl.DataContext>
        <vm:StockCountViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <materialDesign:Card Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardCheck" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="KIỂM KÊ KHO" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Chế độ kiểm kê chuẩn" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar: Session Info (RIGHT) -->
                <materialDesign:Card Grid.Column="1" Margin="{StaticResource Margin.Left.md}" Style="{StaticResource AppCard}" Padding="0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource AppSurfaceBrush}" Padding="{StaticResource Spacing.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource Radius.lg}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="THÔNG TIN PHIÊN" Foreground="{StaticResource AppPrimaryBrush}" Style="{StaticResource TypographyLabel}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Padding="{StaticResource Spacing.md}">
                            <StackPanel>
                                <TextBox materialDesign:HintAssist.Hint="Mã phiên" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding SessionCode}" Margin="{StaticResource Margin.Bottom.md}"
                                         IsReadOnly="True"/>

                                <ComboBox materialDesign:HintAssist.Hint="Kho hàng" 
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          SelectedValue="{Binding WarehouseId}"
                                          SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                          Margin="{StaticResource Margin.Bottom.md}">
                                    <ComboBoxItem Content="Kho tổng" IsSelected="True" Tag="1"/>
                                </ComboBox>

                                <DatePicker materialDesign:HintAssist.Hint="Ngày kiểm kê" 
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            SelectedDate="{Binding CountDate}"
                                            Margin="{StaticResource Margin.Bottom.md}"/>

                                <Border Background="{StaticResource AppBackgroundBrush}" Padding="{StaticResource Spacing.sm}" CornerRadius="{StaticResource Radius.md}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppErrorBrush}" Style="{StaticResource TypographyCaption}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Padding="{StaticResource Spacing.md}" Background="{StaticResource AppBackgroundBrush}" CornerRadius="0,0,12,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                            <Button Content="CHỐT KIỂM KÊ" Command="{Binding SaveStockCountCommand}"
                                    Style="{StaticResource AppPrimaryButton}"
                                    Height="48"/>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Main: Count Lines (LEFT) -->
                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.md}" Style="{StaticResource AppCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Padding="{StaticResource Spacing.md}" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                                    <TextBlock Text="DANH SÁCH SẢN PHẨM KIỂM KÊ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="12,0,0,0" Foreground="{StaticResource AppPrimaryBrush}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Content="+ THÊM DÒNG" 
                                        Command="{Binding AddLineCommand}"
                                        Style="{StaticResource AppPrimaryButton}"
                                        Height="32" Padding="12,0" FontSize="12"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" SelectionMode="Single" Margin="0"
                                  BorderThickness="0" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName"
                                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" Padding="{StaticResource Spacing.sm}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="SỐ LƯỢNG THỰC TẾ" Binding="{Binding CountedQuantity}" 
                                                   ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"
                                                   Width="200"/>

                                <DataGridTemplateColumn Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{StaticResource AppErrorBrush}" Width="32" Height="32">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
