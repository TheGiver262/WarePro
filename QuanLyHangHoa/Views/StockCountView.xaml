<UserControl x:Class="QuanLyHangHoa.Views.StockCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content Area (Grid) -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="KIỂM KÊ KHO" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Đối soát số lượng thực tế tại kho và cập nhật hệ thống" Style="{StaticResource TypographyCaption}" Opacity="0.7" VerticalAlignment="Center"/>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryStatusBadgeTemplate}" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Visibility="{Binding IsCreateNewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Nút Tạo phiên mới hiển thị ở Header -->
                <Button Grid.Column="1" Command="{Binding ShowCreateNewCommand}" 
                        Style="{StaticResource PrimaryButton}" Height="32" VerticalAlignment="Center"
                        Visibility="{Binding IsHistoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="TẠO PHIÊN MỚI" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 1: Content Area -->
            <Grid Grid.Row="1">
                <!-- PANEL 1: Lịch sử kiểm kê (Màn hình chính) -->
                <Grid Visibility="{Binding IsHistoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Past Sessions List -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,16,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding PastSessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" RowHeight="50"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding SessionCode}" Width="160" ElementStyle="{DynamicResource AppDataGridTextBold}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                                <TextBlock Text="MÃ PHIÊN" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Binding="{Binding Warehouse.DisplayName}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                                <TextBlock Text="KHO" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Binding="{Binding CountDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" ElementStyle="{DynamicResource AppDataGridTextCenter}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                                <TextBlock Text="NGÀY THỰC HIỆN" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>

                                    <!-- Status Badge -->
                                    <DataGridTemplateColumn Width="130">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                                <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Style="{StaticResource ProMaxBadgeBorderStyle}"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBgBrushConverter}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                                                               Style="{StaticResource ProMaxBadgeTextBlockStyle}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToFgBrushConverter}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Footer -->
                            <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Run Text="Hiện có "/>
                                    <Run Text="{Binding PastSessions.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Run Text=" phiên kiểm kê trong hệ thống"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Right Column: Detail Panel of Selected Session -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Style="{StaticResource AppCard}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title / Action -->
                                    <RowDefinition Height="Auto"/> <!-- Info summary -->
                                    <RowDefinition Height="*"/>    <!-- DataGrid of lines -->
                                </Grid.RowDefinitions>

                                <!-- Title / Action -->
                                <Border Grid.Row="0" Padding="16,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}" Width="20" Height="20"/>
                                            <TextBlock Text="CHI TIẾT PHIÊN" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="12,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <!-- Nút Lưu khi ở trạng thái nháp -->
                                            <Button Command="{Binding SaveEditCommand}" Height="30" Padding="8,0" FontSize="11" Margin="0,0,8,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSession.Status}" Value="nháp">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                 </Button.Style>
                                                 <StackPanel Orientation="Horizontal">
                                                     <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                     <TextBlock Text="LƯU" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                            </Button>

                                            <!-- Nút Chốt khi ở trạng thái nháp -->
                                            <Button Command="{Binding CommitSessionCommand}" Height="30" Padding="8,0" FontSize="11" Margin="0,0,8,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSession.Status}" Value="nháp">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                 </Button.Style>
                                                 <StackPanel Orientation="Horizontal">
                                                     <materialDesign:PackIcon Kind="ContentSaveCheck" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                     <TextBlock Text="CHỐT" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                            </Button>

                                            <!-- Nút Xử lý chênh lệch khi ở trạng thái đã kiểm kê -->
                                            <Button Command="{Binding ProcessSessionCommand}" CommandParameter="{Binding SelectedSession}" Height="30" Padding="8,0" FontSize="11">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSession.Status}" Value="đã kiểm kê">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                 </Button.Style>
                                                 <StackPanel Orientation="Horizontal">
                                                     <materialDesign:PackIcon Kind="CheckAll" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                     <TextBlock Text="XỬ LÝ CHÊNH LỆCH" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                            </Button>

                                            <!-- Text Đã xử lý chênh lệch khi đã hoàn thành -->
                                            <Border Padding="8,4" CornerRadius="4" Background="{StaticResource SuccessBgBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSession.Status}" Value="hoàn thành">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                 </Border.Style>
                                                 <TextBlock Text="ĐÃ XỬ LÝ CHÊNH LỆCH" Style="{StaticResource TypographyLabelBold}" Foreground="{StaticResource SuccessTextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Info Summary -->
                                <Border Grid.Row="1" Padding="16" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedSession.SessionCode, FallbackValue='Chọn một phiên để xem chi tiết'}" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppTertiaryBrush}" Margin="0,0,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0 -->
                                            <TextBlock Grid.Column="0" Text="Người tạo: " Style="{StaticResource TypographyCaption}" Opacity="0.7" Margin="0,0,8,4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedSession.Creator.FullName, FallbackValue='-'}" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                            <TextBlock Grid.Column="2" Text="Trạng thái: " Style="{StaticResource TypographyCaption}" Opacity="0.7" Margin="16,0,8,4"/>
                                            <Border Grid.Column="3" Margin="0,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Style="{StaticResource ProMaxBadgeBorderStyle}"
                                                    Background="{Binding SelectedSession.Status, Converter={StaticResource StatusToBgBrushConverter}}">
                                                <TextBlock Text="{Binding SelectedSession.Status, Converter={StaticResource StatusToTextConverter}}"
                                                           Style="{StaticResource ProMaxBadgeTextBlockStyle}"
                                                           Foreground="{Binding SelectedSession.Status, Converter={StaticResource StatusToFgBrushConverter}}"/>
                                            </Border>

                                            <!-- Row 1 -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày tạo: " Style="{StaticResource TypographyCaption}" Opacity="0.7" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSession.CountDate, StringFormat='{}{0:dd/MM/yyyy}', FallbackValue='-'}" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold"/>

                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Ngày chốt: " Style="{StaticResource TypographyCaption}" Opacity="0.7" Margin="16,0,8,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedSession.PostedAt, StringFormat='{}{0:dd/MM/yyyy}', FallbackValue='-'}" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- DataGrid of lines -->
                                <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedSessionLines}" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" RowHeight="48">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MÃ SP" Binding="{Binding Product.ProductCode}" Width="90" IsReadOnly="True" ElementStyle="{DynamicResource AppDataGridTextBold}"/>
                                        <DataGridTextColumn Header="TÊN SẢN PHẨM" Binding="{Binding Product.DisplayName}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                                        <DataGridTextColumn Header="DANH MỤC" Binding="{Binding Product.Category.DisplayName}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                                        <DataGridTextColumn Header="TỒN HT" Binding="{Binding SystemQuantity, StringFormat='N0'}" Width="80" IsReadOnly="True" ElementStyle="{DynamicResource AppDataGridTextRight}"/>
                                        
                                        <DataGridTemplateColumn Width="95">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="TỒN TT" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <!-- TextBox hiển thị khi Editable == True -->
                                                        <TextBox Text="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CountedQuantityConverter}}" 
                                                                 Style="{StaticResource AppTextBoxStyle}" Height="34" Margin="4,2"
                                                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="1"
                                                                 HorizontalContentAlignment="Right"
                                                                 Visibility="{Binding DataContext.IsSelectedSessionEditable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <!-- TextBlock hiển thị khi Editable == False -->
                                                        <TextBlock Text="{Binding CountedQuantity, Converter={StaticResource CountedQuantityConverter}}" 
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0"
                                                                   Visibility="{Binding DataContext.IsSelectedSessionEditable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="LỆCH" Binding="{Binding VarianceQuantity, StringFormat='N0'}" Width="70" IsReadOnly="True" ElementStyle="{DynamicResource AppDataGridTextRight}"/>

                                        <DataGridTemplateColumn Header="SERIAL" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="SERIAL" FontSize="11" Height="28" Padding="6,0" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.OpenSessionLineSerialWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding ShowSerialButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>

                <!-- PANEL 2: Tạo phiên kiểm kê mới -->
                <Grid Visibility="{Binding IsCreateNewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                        <RowDefinition Height="Auto"/> <!-- Session Info Card -->
                        <RowDefinition Height="*"/>    <!-- DataGrid Card -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Action Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="HỦY PHIÊN" Style="{StaticResource TypographyButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="LƯU NHÁP" Style="{StaticResource TypographyButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveStockCountCommand}" Style="{StaticResource PrimaryButton}" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheck" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="CHỐT KIỂM KÊ" Style="{StaticResource TypographyButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Row 1: Session Info Card -->
                    <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource AppCard}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="MÃ PHIÊN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                <TextBox Width="140" Height="42" Style="{StaticResource AppTextBoxStyle}" IsReadOnly="True"
                                         materialDesign:HintAssist.Hint="Tự động"
                                         Text="{Binding SessionCode}" Background="{StaticResource SurfaceMutedBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                <TextBlock Text="KHO KIỂM KÊ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                <ComboBox Width="180" Height="42" Style="{StaticResource AppComboBoxStyle}" 
                                          ItemsSource="{Binding AvailableWarehouses}"
                                          SelectedValue="{Binding WarehouseId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,24,0">
                                <TextBlock Text="LỌC DANH MỤC" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                <ComboBox Width="180" Height="42" Style="{StaticResource AppComboBoxStyle}" 
                                          ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="DisplayName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,24,0">
                                <TextBlock Text="NGÀY THỰC HIỆN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                <DatePicker Width="160" Height="42" Style="{StaticResource AppDatePickerStyle}" SelectedDate="{Binding CountDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,24,0" VerticalAlignment="Bottom">
                                 <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerTextBrush}" 
                                           Style="{StaticResource TypographyCaption}" Margin="0,0,0,12"/>
                            </StackPanel>

                            <Button Grid.Column="5" Command="{Binding AddLineCommand}" Style="{StaticResource PrimaryButton}" Height="42" VerticalAlignment="Bottom" Padding="16,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="THÊM DÒNG" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Row 2: Count Lines -->
                    <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" 
                                      AlternationCount="10000" EnableRowVirtualization="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      RowHeight="54">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Width="60" CanUserSort="False"
                                                        Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowIndexConverter}}"
                                                        ElementStyle="{DynamicResource AppDataGridTextCenter}"/>

                                    <DataGridTemplateColumn Width="*">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{StaticResource AppComboBoxStyle}" Height="38" Margin="8,4"
                                                          materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                          Background="{StaticResource SurfaceMutedBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="DANH MỤC" Binding="{Binding CategoryName}" Width="130" IsReadOnly="True"
                                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>

                                    <DataGridTextColumn Header="TỒN HT" Binding="{Binding SystemQuantity, StringFormat='N0'}" Width="90" IsReadOnly="True"
                                                        ElementStyle="{DynamicResource AppDataGridTextRight}"/>

                                    <DataGridTemplateColumn Width="150">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="SỐ LƯỢNG THỰC TẾ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CountedQuantityConverter}}" 
                                                         Style="{StaticResource AppTextBoxStyle}" Height="38" Margin="8,4"
                                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                         HorizontalContentAlignment="Center"
                                                         Background="{StaticResource SurfaceMutedBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="SERIAL" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="SERIAL" FontSize="11" Height="28" Padding="8,0" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.OpenSerialWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding ShowSerialButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xoá dòng"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Footer -->
                            <Border Grid.Row="2" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" HorizontalAlignment="Left" Style="{StaticResource TypographyCaption}">
                                    <Run Text="Hiện có "/>
                                    <Run Text="{Binding Lines.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Run Text=" dòng kiểm kê trong phiên"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
