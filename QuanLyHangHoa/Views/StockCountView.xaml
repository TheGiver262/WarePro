<UserControl x:Class="QuanLyHangHoa.Views.StockCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- TabControl -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="KIỂM KÊ KHO" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Đối soát số lượng thực tế tại kho và cập nhật hệ thống" Style="{StaticResource TypographyCaption}" Opacity="0.7" VerticalAlignment="Center"/>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryStatusBadgeTemplate}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Row 1: Content (TabControl) -->
            <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="Standard">
                <!-- Tab Item 1: Tạo phiên mới -->
                <TabItem Header="TẠO PHIÊN MỚI">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                            <RowDefinition Height="Auto"/> <!-- Session Info Card -->
                            <RowDefinition Height="*"/>    <!-- DataGrid Card -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Action Buttons inside tab -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                            <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="HỦY PHIÊN" Style="{StaticResource TypographyButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveStockCountCommand}" Style="{StaticResource PrimaryButton}" Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveCheck" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="CHỐT KIỂM KÊ" Style="{StaticResource TypographyButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Row 1: Session Info Card -->
                        <materialDesign:Card Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}" Style="{StaticResource AppCard}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="MÃ PHIÊN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <TextBox Width="140" Height="42" Style="{StaticResource AppTextBoxStyle}" IsReadOnly="True"
                                             materialDesign:HintAssist.Hint="Tự động"
                                             Text="{Binding SessionCode}" Background="{StaticResource SurfaceMutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                    <TextBlock Text="KHO KIỂM KÊ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <ComboBox Width="180" Height="42" Style="{StaticResource AppComboBoxStyle}" 
                                              SelectedValue="{Binding WarehouseId}" SelectedValuePath="Id" DisplayMemberPath="DisplayName">
                                        <ComboBoxItem Content="Kho tổng mặc định" IsSelected="True"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                                    <TextBlock Text="NGÀY THỰC HIỆN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,6"/>
                                    <DatePicker Width="160" Height="42" Style="{StaticResource AppDatePickerStyle}" SelectedDate="{Binding CountDate}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="0,0,24,0" VerticalAlignment="Bottom">
                                     <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerTextBrush}" 
                                               Style="{StaticResource TypographyCaption}" Margin="0,0,0,12"/>
                                </StackPanel>

                                <Button Grid.Column="4" Command="{Binding AddLineCommand}" Style="{StaticResource PrimaryButton}" Height="42" VerticalAlignment="Bottom" Padding="16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="THÊM DÒNG" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Row 2: Count Lines -->
                        <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" 
                                          AlternationCount="10000" EnableRowVirtualization="False"
                                          RowHeight="54" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Width="60" CanUserSort="False"
                                                            Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowIndexConverter}}"
                                                            ElementStyle="{DynamicResource AppDataGridTextCenter}"/>

                                        <DataGridTemplateColumn Width="*">
                                            <DataGridTemplateColumn.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="PackageVariant" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                                    <TextBlock Text="SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                                </StackPanel>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="DisplayName"
                                                              Style="{StaticResource AppComboBoxStyle}" Height="38" Margin="8,4"
                                                              materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                              Background="{StaticResource SurfaceMutedBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="200">
                                            <DataGridTemplateColumn.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Numeric" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                                    <TextBlock Text="SỐ LƯỢNG THỰC TẾ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                                </StackPanel>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                                             Style="{StaticResource AppTextBoxStyle}" Height="38" Margin="8,4"
                                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                             HorizontalContentAlignment="Center"
                                                             Background="{StaticResource SurfaceMutedBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="THAO TÁC" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xoá dòng"
                                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Footer -->
                                <Border Grid.Row="2" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                    <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}Hiện có {0} dòng kiểm kê trong phiên">
                                                <Binding Path="Lines.Count"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- Tab Item 2: Lịch sử kiểm kê -->
                <TabItem Header="LỊCH SỬ KIỂM KÊ">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Past Sessions List -->
                        <materialDesign:Card Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,16,0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" ItemsSource="{Binding PastSessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" RowHeight="50" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MÃ PHIÊN" Binding="{Binding SessionCode}" Width="160" ElementStyle="{DynamicResource AppDataGridTextBold}"/>
                                        <DataGridTextColumn Header="KHO" Binding="{Binding Warehouse.DisplayName}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                                        <DataGridTextColumn Header="NGÀY THỰC HIỆN" Binding="{Binding CountDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" ElementStyle="{DynamicResource AppDataGridTextCenter}"/>

                                        <!-- Status Badge -->
                                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource ProMaxBadgeBorderStyle}">
                                                                <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="hoàn thành">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ProMaxBadgeTextBlockStyle}">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="hoàn thành">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Right Column: Detail Panel of Selected Session -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <materialDesign:Card Style="{StaticResource AppCard}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Title / Action -->
                                        <RowDefinition Height="Auto"/> <!-- Info summary -->
                                        <RowDefinition Height="*"/>    <!-- DataGrid of lines -->
                                    </Grid.RowDefinitions>

                                    <!-- Title / Action -->
                                    <Border Grid.Row="0" Padding="16,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="FileDocumentOutline" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}" Width="20" Height="20"/>
                                                <TextBlock Text="CHI TIẾT PHIÊN" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="12,0,0,0"/>
                                            </StackPanel>

                                            <Button Command="{Binding ProcessSessionCommand}" CommandParameter="{Binding SelectedSession}" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="8,0" FontSize="11">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSession.Status}" Value="đã kiểm kê">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CheckAll" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="XỬ LÝ CHÊNH LỆCH" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Info Summary -->
                                    <Border Grid.Row="1" Padding="16" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedSession.SessionCode, FallbackValue='Chọn một phiên để xem chi tiết'}" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppTertiaryBrush}" Margin="0,0,0,8"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Row 0 -->
                                                <TextBlock Grid.Column="0" Text="Người tạo: " Style="{StaticResource TypographyCaption}" Opacity="0.7" Margin="0,0,8,4"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedSession.Creator.FullName, FallbackValue='-'}" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                                <TextBlock Grid.Column="2" Text="Trạng thái: " Style="{StaticResource TypographyCaption}" Opacity="0.7" Margin="16,0,8,4"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SelectedSession.Status, FallbackValue='-'}" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                                <!-- Row 1 -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày tạo: " Style="{StaticResource TypographyCaption}" Opacity="0.7" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSession.CountDate, StringFormat='{}{0:dd/MM/yyyy}', FallbackValue='-'}" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold"/>

                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Ngày chốt: " Style="{StaticResource TypographyCaption}" Opacity="0.7" Margin="16,0,8,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedSession.PostedAt, StringFormat='{}{0:dd/MM/yyyy}', FallbackValue='-'}" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- DataGrid of lines -->
                                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedSessionLines}" AutoGenerateColumns="False" 
                                              CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" RowHeight="48" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="MÃ SP" Binding="{Binding Product.ProductCode}" Width="100" ElementStyle="{DynamicResource AppDataGridTextBold}"/>
                                            <DataGridTextColumn Header="TÊN SẢN PHẨM" Binding="{Binding Product.DisplayName}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                                            <DataGridTextColumn Header="TỒN TT" Binding="{Binding CountedQuantity, StringFormat='N0'}" Width="80" ElementStyle="{DynamicResource AppDataGridTextRight}"/>
                                            <DataGridTextColumn Header="TỒN HT" Binding="{Binding SystemQuantity, StringFormat='N0'}" Width="80" ElementStyle="{DynamicResource AppDataGridTextRight}"/>
                                            <DataGridTextColumn Header="LỆCH" Binding="{Binding VarianceQuantity, StringFormat='N0'}" Width="80" ElementStyle="{DynamicResource AppDataGridTextRight}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </materialDesign:Card>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
