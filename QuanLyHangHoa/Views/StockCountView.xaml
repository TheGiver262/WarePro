<UserControl x:Class="QuanLyHangHoa.Views.StockCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <UserControl.DataContext>
        <vm:StockCountViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,24" UniformCornerRadius="12" Background="{StaticResource PrimaryIndigoBrush}" materialDesign:ElevationAssist.Elevation="Dp2" Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="White" Width="48" Height="48" CornerRadius="12" Opacity="0.2"/>
                        <Border Width="48" Height="48" CornerRadius="12">
                            <materialDesign:PackIcon Kind="ClipboardCheck" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="KIỂM KÊ KHO" FontSize="20" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar: Session Info (RIGHT) -->
                <materialDesign:Card Grid.Column="1" Margin="12,0,0,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource PrimaryIndigoBrush}" Padding="16,12" CornerRadius="12,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Thông tin phiên kiểm kê" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Padding="20">
                            <StackPanel>
                                <TextBox materialDesign:HintAssist.Hint="Mã phiên" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding SessionCode}" Margin="0,0,0,16"
                                         IsReadOnly="True"/>

                                <ComboBox materialDesign:HintAssist.Hint="Kho hàng" 
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          SelectedValue="{Binding WarehouseId}"
                                          SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,16">
                                    <ComboBoxItem Content="Kho tổng" IsSelected="True" Tag="1"/>
                                </ComboBox>

                                <DatePicker materialDesign:HintAssist.Hint="Ngày kiểm kê" 
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            SelectedDate="{Binding CountDate}"
                                            Margin="0,0,0,16"/>

                                <TextBlock Text="{Binding StatusMessage}" Foreground="#EF5350" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Padding="20" Background="#F9FAFB" CornerRadius="0,0,12,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                            <Button Content="CHỐT KIỂM KÊ" Command="{Binding SaveStockCountCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource PrimaryIndigoBrush}" BorderBrush="{StaticResource PrimaryIndigoBrush}"
                                    Height="44" materialDesign:ButtonAssist.CornerRadius="8"/>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Main: Count Lines (LEFT) -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Padding="20,16" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                                    <TextBlock Text="DANH SÁCH SẢN PHẨM KIỂM KÊ" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Content="THÊM DÒNG" 
                                        Command="{Binding AddLineCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="{StaticResource PrimaryIndigoBrush}" Foreground="{StaticResource PrimaryIndigoBrush}"
                                        Height="32" Padding="12,0" FontSize="12" materialDesign:ButtonAssist.CornerRadius="6"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" SelectionMode="Single" Margin="0"
                                  Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Sản phẩm" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName"
                                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="8,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <materialDesign:DataGridTextColumn Header="Số lượng thực tế" Binding="{Binding CountedQuantity}" 
                                                                  ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"
                                                                  Width="150"/>

                                <DataGridTemplateColumn Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#EF5350" Width="32" Height="32">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
