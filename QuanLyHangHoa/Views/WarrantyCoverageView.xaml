<UserControl x:Class="QuanLyHangHoa.Views.WarrantyCoverageView"
             x:Name="RootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:WarrantyCoverageViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QuanLyHangHoa;component/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- Main Content -->
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Search -->
                <RowDefinition Height="*"/>    <!-- Row 2: Data Table -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="QUYỀN BẢO HÀNH" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Tra cứu, thiết lập các gói và điều kiện bảo hành của sản phẩm" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}" Margin="{StaticResource Margin.Bottom.md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Serial Search -->
                    <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="SỐ SERIAL / IMEI" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" Margin="0" materialDesign:HintAssist.Hint="Tìm số serial..." 
                                  Text="{Binding SearchSerial, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Customer Search -->
                    <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" Margin="0" materialDesign:HintAssist.Hint="Tìm khách hàng..." 
                                  Text="{Binding SearchCustomer, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Product Search -->
                    <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="SẢN PHẨM" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" Margin="0" materialDesign:HintAssist.Hint="Tìm sản phẩm..." 
                                  Text="{Binding SearchProduct, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="3" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="40" Margin="0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding StatusFilterOptions}" 
                                  SelectedItem="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Command="{Binding ResetFiltersCommand}" Style="{StaticResource ProMaxIconButtonStyle}" 
                                Height="40" Width="40" ToolTip="Reset bộ lọc">
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Data Table -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Coverages}" SelectedItem="{Binding SelectedCoverage}"
                               AlternationCount="10000" EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                               AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                               BorderThickness="0" RowHeight="56" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="160" SortMemberPath="ProductSerial.SerialNumber">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="SERIAL / IMEI" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductSerial.SerialNumber}" VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*" SortMemberPath="ProductSerial.Product.DisplayName">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="SẢN PHẨM" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductSerial.Product.DisplayName}" VerticalAlignment="Center" Margin="12,0" FontWeight="Medium"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="180" SortMemberPath="Customer.DisplayName">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Customer.DisplayName}" VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding WarrantyStartDate, StringFormat=dd/MM/yyyy}" Width="110" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="BẮT ĐẦU" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Binding="{Binding WarrantyEndDate, StringFormat=dd/MM/yyyy}" Width="110" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="KẾT THÚC" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="120" SortMemberPath="EffectiveCoverageStatus">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"
                                                Background="{Binding EffectiveCoverageStatus, Converter={StaticResource StatusToBgBrushConverter}}">
                                            <TextBlock Text="{Binding EffectiveCoverageStatus, Converter={StaticResource StatusToTextConverter}}"
                                                       Foreground="{Binding EffectiveCoverageStatus, Converter={StaticResource StatusToFgBrushConverter}}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Chỉnh sửa"
                                                    Command="{Binding DataContext.EditCoverageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xoá quyền bảo hành"
                                                    Command="{Binding DataContext.DeleteCoverageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Left">
                            <Run Text="Hiện có "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=" quyền bảo hành trong hệ thống · "/>
                            <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                            <Run Text=" Hoạt động · "/>
                            <Run Text="{Binding ExpiredCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextDisabledBrush}"/>
                            <Run Text=" Hết hạn · "/>
                            <Run Text="{Binding VoidedCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}"/>
                            <Run Text=" Bị hủy"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ========================================== -->
        <!-- SLIDING OVERLAY PANEL (DRAWER)             -->
        <!-- ========================================== -->
        <Grid Visibility="{Binding IsDetailPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Semi-transparent Backdrop with Click-to-Close -->
            <Border Background="#40000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Drawer Container -->
            <Border HorizontalAlignment="Right" Width="420" Margin="0"
                    Background="{StaticResource AppSurfaceBrush}" 
                    BorderBrush="{StaticResource AppBorderBrush}" 
                    BorderThickness="1,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#20000000" ShadowDepth="0" Direction="0" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Content -->
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceMutedBrush}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldCheck" Width="20" Height="20" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="CẬP NHẬT QUYỀN BẢO HÀNH" Style="{StaticResource TypographyH3}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- Close Button -->
                            <Button HorizontalAlignment="Right" Style="{StaticResource ProMaxIconButtonStyle}" Command="{Binding CloseDetailCommand}">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Form Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Serial Number -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="SỐ SERIAL/IMEI" Style="{StaticResource DetailFormLabel}"/>
                                <TextBox Style="{StaticResource AppTextBoxStyle}" Height="38" Text="{Binding SerialNumber}" IsReadOnly="True" Background="{StaticResource SurfaceMutedBrush}"/>
                            </StackPanel>

                            <!-- Start Date -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="NGÀY BẮT ĐẦU" Style="{StaticResource DetailFormLabel}"/>
                                <DatePicker Style="{StaticResource AppDatePickerStyle}" Height="38" SelectedDate="{Binding StartDate}"/>
                            </StackPanel>

                            <!-- End Date -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="NGÀY KẾT THÚC" Style="{StaticResource DetailFormLabel}"/>
                                <DatePicker Style="{StaticResource AppDatePickerStyle}" Height="38" SelectedDate="{Binding EndDate}"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="TRẠNG THÁI" Style="{StaticResource DetailFormLabel}"/>
                                <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="38" SelectedValuePath="Content" SelectedValue="{Binding Status}">
                                    <ComboBoxItem Content="Active"/>
                                    <ComboBoxItem Content="Expired"/>
                                    <ComboBoxItem Content="Voided"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Command="{Binding SaveCoverageCommand}" Style="{StaticResource PrimaryButton}" Height="38" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="LƯU THAY ĐỔI" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding DeleteSelectedCoverageCommand}" Style="{StaticResource DangerButton}" Height="38">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="XÓA QUYỀN BẢO HÀNH" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
