<UserControl x:Class="QuanLyHangHoa.Views.AppUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800" Background="White">
    
    <UserControl.DataContext>
        <vm:AppUserViewModel />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN TRỊ TÀI KHOẢN NGƯỜI DÙNG" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>
        
        <!-- Khu nhập thông tin -->
        <Border Grid.Row="0" Margin="0,0,0,20" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15" Background="#F8F9F9">
            <WrapPanel>
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="250" Margin="10" 
                         materialDesign:HintAssist.Hint="Họ và Tên"
                         Text="{Binding CurrentInputUser.FullName}"/>
                         
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="200" Margin="10" 
                         materialDesign:HintAssist.Hint="Tên đăng nhập"
                         Text="{Binding CurrentInputUser.Username}"/>
                         
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="200" Margin="10" 
                         materialDesign:HintAssist.Hint="Mật khẩu (để trống nếu không đổi)"
                         Text="{Binding CurrentInputUser.PasswordHash}"/>

                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" Width="150" Margin="10"
                          materialDesign:HintAssist.Hint="Quyền hạn"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding CurrentInputUser.RoleCode}">
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Manager"/>
                    <ComboBoxItem Content="Staff"/>
                </ComboBox>

                <CheckBox Content="Đang hoạt động" Margin="10" VerticalAlignment="Center"
                          IsChecked="{Binding CurrentInputUser.IsActive}"/>
            </WrapPanel>
        </Border>

        <!-- Thanh nút công cụ Control Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,20">
            <Button Content="LƯU THÔNG TIN" Command="{Binding SaveUserCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#27AE60" BorderBrush="#27AE60" Width="180" Margin="0,0,10,0"/>
            <Button Content="LÀM MỚI" Command="{Binding ClearInputCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="120" Margin="0,0,10,0"/>
            
            <Button Content="VÔ HIỆU HÓA" Command="{Binding DeactivateUserCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Background="#FDF2F2" BorderBrush="#E74C3C" Foreground="#E74C3C" Width="180"/>
        </StackPanel>

        <!-- Bảng Danh sách -->
        <DataGrid Grid.Row="2" Margin="10,0,10,0" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" FontWeight="Bold"/>
                <DataGridTextColumn Header="Quyền hạn" Binding="{Binding RoleCode}" />
                <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" />
                <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy'}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
