<UserControl x:Class="QuanLyHangHoa.Views.AppUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    
    <!-- DataContext is set by parent (MainViewModel) -->

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search -->
                <RowDefinition Height="*"/>    <!-- Table -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountSettings" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="QUẢN TRỊ NGƯỜI DÙNG" Style="{StaticResource TypographyH2}"/>
                        <TextBlock Text="Thiết lập tài khoản, phân quyền và bảo mật hệ thống" Style="{StaticResource TypographyCaption}"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenAddUserDialogCommand}" Style="{StaticResource AppPrimaryButton}" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="THÊM NGƯỜI DÙNG" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row (Aligned Multi-field) -->
            <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" 
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Margin="{StaticResource Margin.Bottom.md}" Padding="16,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>     <!-- Name -->
                        <ColumnDefinition Width="*"/>     <!-- Username -->
                        <ColumnDefinition Width="*"/>     <!-- Role -->
                        <ColumnDefinition Width="*"/>     <!-- Date -->
                    </Grid.ColumnDefinitions>

                    <!-- Name -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Họ và tên" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SearchTextBoxStyle}" 
                                 Height="50" materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                 Text="{Binding SearchFullName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,10,0"
                                 materialDesign:HintAssist.IsFloating="False"
                                 materialDesign:HintAssist.Hint="Tìm theo tên..."/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Tên tài khoản" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SearchTextBoxStyle}" 
                                 Height="50" materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                 Text="{Binding SearchUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0,10,0"
                                 materialDesign:HintAssist.IsFloating="False"
                                 materialDesign:HintAssist.Hint="Tìm theo username..."/>
                    </StackPanel>

                    <!-- Role -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Vai trò" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                  Margin="0" Height="50" Padding="12,0"
                                  materialDesign:HintAssist.IsFloating="False"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                  ItemsSource="{Binding Roles}" 
                                  SelectedItem="{Binding SearchRole, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <!-- Date -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Top">
                        <TextBlock Text="Ngày tạo" Style="{StaticResource TypographyCaption}" Margin="0,0,0,6"/>
                        <DatePicker Style="{StaticResource AppDatePickerStyle}" 
                                    Margin="0" Height="50" Padding="12,0"
                                    materialDesign:HintAssist.IsFloating="False"
                                    materialDesign:TextFieldAssist.TextFieldCornerRadius="{StaticResource Radius.sm}"
                                    materialDesign:HintAssist.Hint=""
                                    SelectedDate="{Binding SearchDate, UpdateSourceTrigger=PropertyChanged}"
                                    Language="vi-VN"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Content Area -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="48" BorderThickness="0" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="60" 
                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowIndexConverter}}"
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                            
                            <DataGridTemplateColumn Width="*" SortMemberPath="FullName">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="HỌ VÀ TÊN" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Sort" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <materialDesign:PackIcon Kind="AccountCircle" Foreground="{StaticResource AppTertiaryBrush}" Width="24" Height="24" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Binding="{Binding Username}" Width="150" 
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TÀI KHOẢN" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Sort" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="170" SortMemberPath="RoleCode">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="VAI TRÒ" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Sort" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,4" CornerRadius="6" Background="#F0F9FF" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleCode}" FontSize="12" FontWeight="Bold" Foreground="#0369A1"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat=\{0:dd/MM/yyyy\}}" Width="130" 
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="NGÀY TẠO" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Sort" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="ĐỔI MK" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="{Binding MustChangePassword, Converter={StaticResource BooleanToIconConverter}, ConverterParameter=Icon}" 
                                                                 Foreground="{Binding MustChangePassword, Converter={StaticResource BooleanToIconConverter}, ConverterParameter=Color}"
                                                                 Width="20" Height="20" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                                      IsChecked="{Binding IsActive, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      ToolTip="Bật/Tắt trạng thái hoạt động"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="38" Height="38" ToolTip="Chỉnh sửa"
                                                    Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="AccountEditOutline" Width="22" Height="22" Foreground="{StaticResource AppTertiaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="38" Height="38" ToolTip="Xoá người dùng"
                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="22" Height="22" Foreground="{StaticResource DangerTextBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="1" Padding="20,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Hiện có {0} người dùng trong hệ thống">
                                    <Binding Path="Users.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Overlay Edit Panel (Appears when editing) -->
        <Border Background="#40000000" Visibility="{Binding IsEditPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource AppSurfaceBrush}" Padding="20,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountEdit" Foreground="{StaticResource AppPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="CHỈNH SỬA NGƯỜI DÙNG" Style="{StaticResource TypographyH3}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Họ và tên" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="50" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.IsFloating="False"
                                     materialDesign:HintAssist.Hint="Nhập họ và tên"
                                     Text="{Binding CurrentInputUser.FullName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Tên tài khoản" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="50" VerticalContentAlignment="Center"
                                     IsEnabled="False" Background="#F3F4F6"
                                     materialDesign:HintAssist.IsFloating="False"
                                     Text="{Binding CurrentInputUser.Username}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Vai trò" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="50" VerticalContentAlignment="Center"                                     
                                      materialDesign:HintAssist.IsFloating="False"
                                      ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding CurrentInputUser.RoleCode}"/>
                        </StackPanel>
                        
                        <TextBlock Text="Lưu ý: Tên tài khoản là duy nhất và không thể thay đổi sau khi tạo." 
                                   Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" FontStyle="Italic" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource AppBackgroundBrush}" Padding="24,16" CornerRadius="0,0,12,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="HUỶ" Width="100" Height="40" Margin="0,0,12,0"
                                    Command="{Binding ClearInputCommand}"/>
                            <Button Style="{StaticResource AppPrimaryButton}" Content="LƯU THAY ĐỔI" Width="140" Height="40"
                                    Command="{Binding SaveUserCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Border>
    </Grid>
</UserControl>
