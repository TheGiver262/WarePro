<UserControl x:Class="QuanLyHangHoa.Views.StockTransferView"
             x:Name="RootStockTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- ═══════════════════════════════════════════ -->
        <!-- LIST VIEW                                   -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Margin="{StaticResource PagePadding}" Visibility="{Binding IsListViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Filter Section -->
                <RowDefinition Height="*"/>    <!-- Data Table -->
                <RowDefinition Height="Auto"/> <!-- Footer Stats -->
            </Grid.RowDefinitions>

            <!-- Row 0: List Header -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="32" Height="32" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="CHUYỂN KHO NỘI BỘ" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Điều chuyển hàng hóa giữa các kho trong hệ thống" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CreateNewCommand}" Style="{StaticResource PrimaryButton}" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="TẠO PHIẾU MỚI" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Filter Section -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Margin="{StaticResource SectionBottomMargin}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="TÌM KIẾM" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" materialDesign:HintAssist.Hint="Mã phiếu, ghi chú..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="40"
                                  ItemsSource="{Binding AvailableStatuses}"
                                  SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Tất cả trạng thái"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Command="{Binding LoadDataCommand}" 
                                Style="{StaticResource AppRefreshButton}" 
                                Height="40" Margin="0,0,8,0"
                                ToolTip="Tải dữ liệu"/>
                        <Button Style="{StaticResource AppRefreshButton}" 
                                Command="{Binding ResetFilterCommand}"
                                Height="40"
                                Margin="0,0,8,0"
                                ToolTip="Làm mới bộ lọc"/>
                        <Button Style="{StaticResource AppExcelButton}" 
                                Command="{Binding ExportExcelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Data Table -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <DataGrid ItemsSource="{Binding StockTransferList}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False"
                          IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ PHIẾU" Binding="{Binding DocumentCode}" Width="150" ElementStyle="{DynamicResource AppDataGridTextBold}"/>
                        <DataGridTextColumn Header="KHO ĐI" Binding="{Binding FromWarehouse.DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="KHO ĐẾN" Binding="{Binding ToWarehouse.DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="NGÀY CHUYỂN" Binding="{Binding TransferDate, StringFormat='dd/MM/yyyy'}" Width="120" ElementStyle="{DynamicResource AppDataGridTextCenter}"/>
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130" CellTemplate="{StaticResource InventoryStatusBadgeTemplate}"/>
                        <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button ToolTip="Xem chi tiết" Style="{StaticResource ProMaxIconButtonStyle}"
                                                Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20" Foreground="{StaticResource AppPrimaryBrush}"/>
                                        </Button>
                                        <Button ToolTip="Chỉnh sửa" Style="{StaticResource ProMaxIconButtonStyle}" Margin="4,0"
                                                Command="{Binding DataContext.EditDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" Foreground="{StaticResource AppSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Row 3: Footer Stats -->
            <Border Grid.Row="3" Padding="16,12" Background="{StaticResource SurfaceMutedBrush}" Margin="0,16,0,0" CornerRadius="8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.6"/>
                            <TextBlock Text="TỔNG PHIẾU:" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Opacity="0.6"/>
                            <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center" Style="{StaticResource TypographyStatNumber}" Margin="8,0,0,0" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileClockOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#F59E0B"/>
                            <TextBlock Text="PHIẾU NHÁP:" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Opacity="0.6"/>
                            <TextBlock Text="{Binding DraftCount}" VerticalAlignment="Center" Style="{StaticResource TypographyStatNumber}" Margin="8,0,0,0" FontSize="16" Foreground="#F59E0B"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- DETAIL VIEW                                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Margin="{StaticResource PagePadding}" Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Document Info -->
                <RowDefinition Height="*"/>    <!-- Items List -->
            </Grid.RowDefinitions>

            <!-- Row 0: Detail Header -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackToListCommand}" Style="{StaticResource ProMaxIconButtonStyle}" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="32" Height="32" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="CHI TIẾT PHIẾU CHUYỂN KHO" Style="{StaticResource TypographyH1}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DocumentCode, StringFormat='Phiếu: {0}'}" Style="{StaticResource TypographyCaption}" Opacity="0.7" VerticalAlignment="Center"/>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryStatusBadgeTemplate}" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,12,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="LƯU NHÁP" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ConfirmAndPostCommand}" Style="{StaticResource PrimaryButton}" Height="36" 
                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckDecagramOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="GHI SỔ" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Info Card -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Background="{StaticResource SurfaceMutedBrush}" Margin="{StaticResource SectionBottomMargin}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="MÃ PHIẾU" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DetailFormTextBoxStyle}" IsReadOnly="True" Width="140"
                                 materialDesign:TextFieldAssist.HasClearButton="False"
                                 Text="{Binding DocumentCode}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="KHO ĐI" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Width="180" Style="{StaticResource DetailFormComboBoxStyle}" IsEnabled="{Binding CanEdit}"
                                  ItemsSource="{Binding AvailableWarehouses}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedFromWarehouse}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,24,0">
                        <TextBlock Text="KHO ĐẾN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Width="180" Style="{StaticResource DetailFormComboBoxStyle}" IsEnabled="{Binding CanEdit}"
                                  ItemsSource="{Binding AvailableWarehouses}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedToWarehouse}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,24,0">
                        <TextBlock Text="NGÀY CHUYỂN" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <DatePicker Width="140" Style="{StaticResource DetailFormDatePickerStyle}" IsEnabled="{Binding CanEdit}" SelectedDate="{Binding TransferDate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,24,0">
                        <TextBlock Text="GHI CHÚ" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DetailFormTextBoxStyle}" Text="{Binding Notes}" IsReadOnly="{Binding CanEdit, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                    <Button Grid.Column="5" Command="{Binding AddLineCommand}" Style="{StaticResource PrimaryButton}" Height="42" VerticalAlignment="Bottom" Padding="16,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="THÊM DÒNG" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Items List -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Lines}" 
                                AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False"
                                BorderThickness="0" Background="Transparent" RowHeight="54"
                                IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="DisplayName" Style="{StaticResource AppComboBoxStyle}" Margin="8,4" BorderThickness="0" Height="36"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="ĐƠN VỊ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableUnits}" 
                                                  SelectedItem="{Binding SelectedUnit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="DisplayName" Style="{StaticResource AppComboBoxStyle}" Margin="8,4" BorderThickness="0" Height="36"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="SỐ LƯỢNG" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" 
                                                  Style="{StaticResource AppTextBoxStyle}" Margin="8,4" Height="36"
                                                  IsReadOnly="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="180">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="SERIAL" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,4" Visibility="{Binding IsSerialRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Serial detail list (wrapped) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TypographyCaption}">
                                                            <Setter Property="Text" Value="{Binding SerialDetail}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SerialNumbers.Count}" Value="0">
                                                                    <Setter Property="Text" Value="Chưa có Serial"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSerialComplete}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <!-- Serial summary count if complete -->
                                                <TextBlock Text="{Binding SerialSummary}" Style="{StaticResource TypographyCaption}" Opacity="0.6" Margin="0,2,0,0"
                                                           Visibility="{Binding IsSerialComplete, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Edit button -->
                                            <Button Grid.Column="1" Style="{StaticResource ProMaxIconButtonStyle}"
                                                    Command="{Binding DataContext.OpenSerialInputCommand, ElementName=RootStockTransferView}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" Width="32" Height="32" Padding="0">
                                                <materialDesign:PackIcon Kind="BarcodeScan" Width="18" Height="18">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSerialComplete}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="THAO TÁC" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ProMaxIconButtonStyle}" Margin="4" HorizontalAlignment="Center"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}Hiện có {0} dòng hàng trong phiếu">
                                        <Binding Path="Lines.Count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
