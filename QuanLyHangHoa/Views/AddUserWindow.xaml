<Window x:Class="QuanLyHangHoa.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thêm người dùng mới" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.lg}" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="THÊM NGƯỜI DÙNG" Style="{StaticResource TypographyH1}"/>
                    <TextBlock Text="Điền thông tin để tạo tài khoản mới" Style="{StaticResource TypographyCaption}"/>
                </StackPanel>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Họ và tên" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource DetailFormTextBoxStyle}" 
                          materialDesign:HintAssist.Hint="Nhập họ và tên đầy đủ"
                          materialDesign:HintAssist.IsFloating="False"
                          Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,20"/>

                <TextBlock Text="Tên tài khoản" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource DetailFormTextBoxStyle}" 
                          materialDesign:HintAssist.Hint="Nhập username đăng nhập"
                          materialDesign:HintAssist.IsFloating="False"
                          Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,20"/>

                <TextBlock Text="Vai trò" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                <ComboBox Style="{StaticResource DetailFormComboBoxStyle}" 
                          materialDesign:HintAssist.Hint="Chọn vai trò"
                          materialDesign:HintAssist.IsFloating="False"
                          Margin="0,0,0,20"
                          ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding RoleCode}"/>

                <TextBlock Text="* Mật khẩu mặc định sẽ giống tên tài khoản" 
                           Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" FontStyle="Italic" Margin="0,0,0,12"/>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" 
                        Margin="0,0,8,0" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Height="32">
                    <TextBlock Text="HUỶ BỎ" Style="{StaticResource TypographyButtonText}"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" 
                        Margin="8,0,0,0" Command="{Binding ConfirmCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Height="32">
                    <TextBlock Text="XÁC NHẬN" Style="{StaticResource TypographyButtonText}"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
