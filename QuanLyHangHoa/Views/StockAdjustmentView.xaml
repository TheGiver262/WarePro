<UserControl x:Class="QuanLyHangHoa.Views.StockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <UserControl.DataContext>
        <vm:StockAdjustmentViewModel />
    </UserControl.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section (Transparent) -->
            <Grid Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Tune" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <TextBlock Text="ĐIỀU CHỈNH KHO" Style="{StaticResource TypographyH2}" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.sm}"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row (Integrated Search) -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" Height="40" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="{StaticResource Padding.sm}" Foreground="{StaticResource AppSecondaryBrush}"/>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 materialDesign:HintAssist.Hint="Tìm kiếm sản phẩm hoặc mã phiếu điều chỉnh..." 
                                 FontSize="14" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Content="TÌM KIẾM" Command="{Binding LoadDataCommand}" Style="{StaticResource AppSecondaryButton}" Margin="{StaticResource Margin.Left.sm}" Height="40"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar: Document Info (RIGHT) -->
                <materialDesign:Card Grid.Column="1" Margin="{StaticResource Margin.Left.lg}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.lg}">
                            <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="THÔNG TIN CHỨNG TỪ" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Left.sm}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Mã chứng từ (Tự động)" 
                                     Text="{Binding DocumentCode}" Margin="{StaticResource Margin.Bottom.md}"
                                     IsReadOnly="True"/>

                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Kho hàng điều chỉnh" 
                                      SelectedValue="{Binding WarehouseId}"
                                      SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                      Margin="{StaticResource Margin.Bottom.md}">
                                <ComboBoxItem Content="Kho tổng" IsSelected="True" Tag="1"/>
                            </ComboBox>

                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Lý do / Ghi chú" 
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding ReasonCode, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="{StaticResource Margin.Bottom.md}"/>

                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerTextBrush}" 
                                       Style="{StaticResource TypographyCaption}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="{StaticResource Margin.Top.lg}">
                            <Button Content="LƯU PHIẾU ĐIỀU CHỈNH" Command="{Binding SaveAdjustmentCommand}"
                                    Style="{StaticResource AppPrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Main: Adjustment Lines (LEFT) -->
                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.lg}" Style="{StaticResource AppCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Padding="{StaticResource Spacing.md}" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                                    <TextBlock Text="DANH SÁCH SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Left.md}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Content="THÊM DÒNG" 
                                        Command="{Binding AddLineCommand}"
                                        Style="{StaticResource AppSecondaryButton}"
                                        Height="32" Padding="12,0" FontSize="12"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName"
                                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="{StaticResource Spacing.sm}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="HƯỚNG" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding Direction, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="{StaticResource Spacing.sm}">
                                                <ComboBoxItem Content="Nhập (+)" Tag="In"/>
                                                <ComboBoxItem Content="Xuất (-)" Tag="Out"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding Quantity}" 
                                                   ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"
                                                   Width="120" FontWeight="Bold"/>

                                <DataGridTemplateColumn Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{StaticResource DangerTextBrush}" Width="32" Height="32">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
