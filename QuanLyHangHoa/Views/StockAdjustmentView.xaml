<UserControl x:Class="QuanLyHangHoa.Views.StockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- List View Section -->
        <Grid Visibility="{Binding IsListViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Filter/Stats -->
                <RowDefinition Height="*"/>    <!-- Row 2: List -->
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SwapVerticalBold" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="ĐIỀU CHỈNH KHO" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="Quản lý phiếu điều chỉnh số lượng và xử lý chênh lệch tồn kho" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding CreateNewCommand}" Style="{StaticResource PrimaryButton}" Height="42">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="TẠO PHIẾU MỚI" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filter & Stats Section -->
            <Grid Grid.Row="1" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Card -->
                <materialDesign:Card Style="{StaticResource AppCard}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="MÃ PHIẾU" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" materialDesign:HintAssist.Hint="Tìm theo mã..."
                                     Text="{Binding SearchDocumentCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="TỪ NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                            <DatePicker Style="{StaticResource AppDatePickerStyle}" Height="40"
                                        SelectedDate="{Binding FilterFromDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                            <DatePicker Style="{StaticResource AppDatePickerStyle}" Height="40"
                                        SelectedDate="{Binding FilterToDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource AppRefreshButton}" 
                                    Command="{Binding LoadDataCommand}"
                                    ToolTip="Tìm kiếm / Tải dữ liệu"
                                    Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource AppRefreshButton}" 
                                    Command="{Binding ResetFilterCommand}"
                                    ToolTip="Làm mới bộ lọc"
                                    Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource AppExcelButton}" 
                                    Command="{Binding ExportExcelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Stats Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                    <materialDesign:Card Style="{StaticResource AppCard}" Background="{StaticResource SurfaceMutedBrush}" Padding="20,12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="DỰ THẢO" Style="{StaticResource TypographyLabel}" Opacity="0.6"/>
                            <TextBlock Text="{Binding DraftCount}" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppSecondaryBrush}"/>
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Style="{StaticResource AppCard}" Background="{StaticResource SurfaceMutedBrush}" Padding="20,12">
                        <StackPanel>
                            <TextBlock Text="ĐÃ GHI SỔ" Style="{StaticResource TypographyLabel}" Opacity="0.6"/>
                            <TextBlock Text="{Binding PostedCount}" Style="{StaticResource TypographyH2}" Foreground="{StaticResource AppSuccessBrush}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>

            <!-- DataGrid Section -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <DataGrid ItemsSource="{Binding AdjustmentList}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ PHIẾU" Binding="{Binding DocumentCode}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="NGÀY" Binding="{Binding PostedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                        <DataGridTextColumn Header="KHO" Binding="{Binding Warehouse.DisplayName}" Width="150"/>
                        
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryStatusBadgeTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="LÝ DO" Binding="{Binding ReasonCode}" Width="120"/>
                        <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Notes}" Width="*"/>

                        <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xem chi tiết"
                                                Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20" Foreground="{StaticResource AppTertiaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Chỉnh sửa" Margin="8,0,0,0"
                                                Command="{Binding DataContext.EditDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" Foreground="{StaticResource AppSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>

        <!-- Detail View Section -->
        <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Info Card -->
                <RowDefinition Height="Auto"/> <!-- Add Line Button -->
                <RowDefinition Height="*"/>    <!-- Lines Card -->
            </Grid.RowDefinitions>

            <!-- Detail Header -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding BackToListCommand}" Style="{StaticResource ProMaxIconButtonStyle}" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DocumentCode}" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppTertiaryBrush}"/>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryStatusBadgeTemplate}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Chi tiết phiếu điều chỉnh hàng hóa" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" IsEnabled="{Binding IsEditMode}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="LƯU NHÁP" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ConfirmAndPostCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsEditMode}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="GHI SỔ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Document Info Card -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="20" Margin="{StaticResource SectionBottomMargin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="KHO ĐIỀU CHỈNH" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="42"
                                  ItemsSource="{Binding AvailableWarehouses}"
                                  SelectedValue="{Binding WarehouseId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsEditMode}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="LÝ DO ĐIỀU CHỈNH" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="42"
                                  ItemsSource="{Binding AvailableReasons}"
                                  SelectedItem="{Binding ReasonCode}"
                                  IsEnabled="{Binding IsEditMode}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GHI CHÚ / CHI TIẾT" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="42" materialDesign:HintAssist.Hint="Nhập ghi chú thêm..."
                                 Text="{Binding Notes}" IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
            <Button Grid.Row="2" Command="{Binding AddLineCommand}" Style="{StaticResource SecondaryButton}" Height="36"
                    HorizontalAlignment="Left" Margin="0,12,0,12"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="THÊM DÒNG SẢN PHẨM" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                </StackPanel>
            </Button>

            <!-- Lines Section -->
            <materialDesign:Card Grid.Row="3" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Lines DataGrid -->
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" 
                               CanUserAddRows="False" SelectionMode="Single" Style="{StaticResource AppDataGridStyle}"
                               RowHeight="60">dRows="False" SelectionMode="Single" Style="{StaticResource AppDataGridStyle}"
                              RowHeight="60">
                        <DataGrid.Columns>
                            <!-- Product Selection -->
                            <DataGridTemplateColumn Header="SẢN PHẨM" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DisplayName"
                                                  Style="{StaticResource AppComboBoxStyle}" Height="40" Margin="4"
                                                  materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                  IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Unit Selection -->
                            <DataGridTemplateColumn Header="ĐƠN VỊ" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableUnits}"
                                                  SelectedItem="{Binding SelectedUnit, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DisplayName"
                                                  Style="{StaticResource AppComboBoxStyle}" Height="40" Margin="4"
                                                  materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                  IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Direction -->
                            <DataGridTemplateColumn Header="HƯỚNG" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Direction, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag" Style="{StaticResource AppComboBoxStyle}" Height="40" Margin="4"
                                                  materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                  IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ComboBoxItem Content="Nhập (+)" Tag="In"/>
                                            <ComboBoxItem Content="Xuất (-)" Tag="Out"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quantity -->
                            <DataGridTemplateColumn Header="SỐ LƯỢNG" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource AppTextBoxStyle}" Height="40" Margin="4"
                                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                 HorizontalContentAlignment="Center"
                                                 IsReadOnly="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Serial Selection -->
                            <DataGridTemplateColumn Header="SERIAL" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableSerials}"
                                                  SelectedItem="{Binding SelectedSerial, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="SerialNumber"
                                                  Style="{StaticResource AppComboBoxStyle}" Height="40" Margin="4"
                                                  materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0"
                                                  Visibility="{Binding IsSerialTracked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Remove Button -->
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ProMaxIconButtonStyle}" ToolTip="Xoá dòng"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" Foreground="{StaticResource AppErrorBrush}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary Footer -->
                    <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Style="{StaticResource TypographyCaption}" Opacity="0.6" VerticalAlignment="Center">
                                <Run Text="Tổng số mặt hàng: "/>
                                <Run Text="{Binding Lines.Count, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Text="Mã phiếu: " Style="{StaticResource TypographyCaption}" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DocumentCode}" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
