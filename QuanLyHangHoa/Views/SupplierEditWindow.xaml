<Window x:Class="QuanLyHangHoa.Views.SupplierEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}" Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.lg}" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="Domain" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource TypographyH2}"/>
                    <TextBlock Text="Cập nhật thông tin đối tác cung cấp hàng" Style="{StaticResource TypographyCaption}"/>
                </StackPanel>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Mã nhà cung cấp" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource AppTextBoxStyle}" 
                             materialDesign:HintAssist.Hint="Nhập mã (ví dụ: SUP001)"
                             materialDesign:HintAssist.IsFloating="False"
                             Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}"
                             Height="45" Margin="0,0,0,16"
                             IsReadOnly="{Binding IsEditMode}"/>

                    <TextBlock Text="Tên nhà cung cấp" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource AppTextBoxStyle}" 
                             materialDesign:HintAssist.Hint="Nhập tên hiển thị"
                             materialDesign:HintAssist.IsFloating="False"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Height="45" Margin="0,0,0,16"/>

                    <TextBlock Text="Số điện thoại" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource AppTextBoxStyle}" 
                             materialDesign:HintAssist.Hint="Nhập số điện thoại"
                             materialDesign:HintAssist.IsFloating="False"
                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             Height="45" Margin="0,0,0,16"/>

                    <TextBlock Text="Email" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource AppTextBoxStyle}" 
                             materialDesign:HintAssist.Hint="example@domain.com"
                             materialDesign:HintAssist.IsFloating="False"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="45" Margin="0,0,0,16"/>

                    <TextBlock Text="Địa chỉ" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource AppTextBoxStyle}" 
                             materialDesign:HintAssist.Hint="Nhập địa chỉ"
                             materialDesign:HintAssist.IsFloating="False"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             Height="45" Margin="0,0,0,16"/>

                    <CheckBox Content="Hoạt động" 
                              IsChecked="{Binding IsActive}"
                              Style="{StaticResource MaterialDesignCheckBox}"
                              Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="HUỶ BỎ" Style="{StaticResource MaterialDesignFlatButton}" 
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Grid.Column="1" Content="XÁC NHẬN" Style="{StaticResource AppPrimaryButton}" 
                        Margin="8,0,0,0" Click="Confirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
