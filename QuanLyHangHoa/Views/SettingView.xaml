<UserControl x:Class="QuanLyHangHoa.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}" Margin="{StaticResource Margin.Bottom.lg}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Settings" Width="28" Height="28" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="CẤU HÌNH HỆ THỐNG" Style="{StaticResource TypographyH2}" Margin="{StaticResource Margin.Left.md}" VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        
                        <TextBlock Text="THÔNG TIN CỬA HÀNG" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppTertiaryBrush}" Margin="{StaticResource Margin.Bottom.lg}"/>
                        
                        <TextBox Text="{Binding StoreName}" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 materialDesign:HintAssist.Hint="Tên cửa hàng / Công ty" FontSize="14" Margin="{StaticResource Margin.Bottom.md}"/>
                        
                        <TextBox Text="{Binding StoreAddress}" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 materialDesign:HintAssist.Hint="Địa chỉ liên hệ" FontSize="14" Margin="{StaticResource Margin.Bottom.md}"/>
                        
                        <TextBox Text="{Binding StorePhone}" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 materialDesign:HintAssist.Hint="Số điện thoại" FontSize="14" Margin="{StaticResource Margin.Bottom.lg}"/>

                        <Separator Margin="{StaticResource Margin.Bottom.lg}" Background="{StaticResource AppBorderBrush}"/>

                        <TextBlock Text="CẤU HÌNH HÓA ĐƠN" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppTertiaryBrush}" Margin="{StaticResource Margin.Bottom.lg}"/>
                        
                        <TextBox Text="{Binding InvoiceFooter}" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 materialDesign:HintAssist.Hint="Lời chúc / Ghi chú chân trang hóa đơn" 
                                 Height="100" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" Margin="{StaticResource Margin.Bottom.lg}"/>

                        <Button Content="LƯU CẤU HÌNH" Command="{Binding SaveSettingsCommand}" 
                                Style="{StaticResource AppPrimaryButton}"
                                Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
