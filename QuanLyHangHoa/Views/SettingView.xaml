<UserControl x:Class="QuanLyHangHoa.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="16,8" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Settings" Width="28" Height="28" Foreground="{StaticResource PrimaryIndigoBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="CẤU HÌNH HỆ THỐNG" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="32">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        
                        <TextBlock Text="Thông tin cửa hàng" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="0,0,0,24"/>
                        
                        <TextBox Text="{Binding StoreName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 materialDesign:HintAssist.Hint="Tên cửa hàng / Công ty" FontSize="14" Margin="0,0,0,20"/>
                        
                        <TextBox Text="{Binding StoreAddress}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 materialDesign:HintAssist.Hint="Địa chỉ" FontSize="14" Margin="0,0,0,20"/>
                        
                        <TextBox Text="{Binding StorePhone}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 materialDesign:HintAssist.Hint="Số điện thoại" FontSize="14" Margin="0,0,0,32"/>

                        <Separator Margin="0,0,0,32"/>

                        <TextBlock Text="Cấu hình hóa đơn" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="0,0,0,24"/>
                        
                        <TextBox Text="{Binding InvoiceFooter}" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 materialDesign:HintAssist.Hint="Lời chúc / Ghi chú chân trang hóa đơn" 
                                 Height="100" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" Margin="0,0,0,32"/>

                        <Button Content="LƯU CẤU HÌNH" Command="{Binding SaveSettingsCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" Height="48" materialDesign:ButtonAssist.CornerRadius="12"
                                Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
