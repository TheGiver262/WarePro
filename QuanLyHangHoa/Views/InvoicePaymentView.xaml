<UserControl x:Class="QuanLyHangHoa.Views.InvoicePaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding ModeTitle}" FontSize="24" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Hoa don ban" Command="{Binding SwitchToSalesCommand}" Background="#2563EB" Foreground="White" Padding="14,8" Margin="0,0,8,0" BorderThickness="0"/>
                <Button Content="Hoa don mua" Command="{Binding SwitchToPurchaseCommand}" Background="#7C3AED" Foreground="White" Padding="14,8" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="InvoiceId" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding InvoiceIdText, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="So tien" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Phuong thuc" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,14,0">
                    <TextBlock Text="Ghi chu" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <Button Grid.Column="4" Content="Ghi nhan" Command="{Binding SavePaymentCommand}" Background="#10B981" Foreground="White" Padding="18,10" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="8" Padding="18">
            <StackPanel>
                <TextBlock Text="Luu y" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Moi lan ghi nhan se tao mot dong InvoicePayment va cap nhat PaidAmount/PaymentStatus cua hoa don." Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="InvoiceId lay tu bang hoa don ban/mua trong du lieu hien tai. He thong khong cho thanh toan vuot tong tien hoa don." Foreground="#D1D5DB" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
