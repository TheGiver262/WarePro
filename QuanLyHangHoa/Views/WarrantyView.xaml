<UserControl x:Class="QuanLyHangHoa.Views.WarrantyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Trái: Khung Tìm HĐ & List Món Hàng cũ -->
            <ColumnDefinition Width="4*"/>
            <!-- Phải: Thông tin làm phiếu -->
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- KHUNG TÌM KIẾM TRÁI -->
        <Border Grid.Column="0" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="TRA CỨU HOÁ ĐƠN CŨ" FontWeight="Bold" FontSize="18" Foreground="#8E44AD" Margin="0,0,0,15"/>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             materialDesign:HintAssist.Hint="Mã hoá đơn gốc (ID)..." 
                             Text="{Binding SearchInvoiceId}" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="TÌM" Command="{Binding SearchInvoiceCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </Grid>

                <TextBlock Text="Sản phẩm đã mua:" Margin="0,15,0,5" FontWeight="SemiBold"/>
                <DataGrid ItemsSource="{Binding FoundInvoice.InvoiceDetails}" SelectedItem="{Binding SelectedInvoiceDetail, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="250"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên Hàng" Binding="{Binding Product.Name}" Width="*"/>
                        <DataGridTextColumn Header="Hạn (TH)" Binding="{Binding Product.WarrantyMonths}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="THÊM VÀO BIÊN BẢN LỖI ➡" Margin="0,15,0,0" 
                        Command="{Binding AddToBrokenListCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#8E44AD" BorderBrush="#8E44AD"/>
            </StackPanel>
        </Border>

        <!-- KHUNG LẬP PHIẾU BẢO HÀNH PHẢI -->
        <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15" Background="#FDFEFE">
            <StackPanel>
                <TextBlock Text="LẬP PHIẾU BẢO HÀNH" FontWeight="Bold" FontSize="18" Foreground="#8E44AD" Margin="0,0,0,15"/>

                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         materialDesign:HintAssist.Hint="Tên khách hàng đem máy/hàng bảo hành" 
                         Text="{Binding CustomerName}" Margin="0,0,0,15" FontSize="16"/>

                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         materialDesign:HintAssist.Hint="Tình trạng lúc nhận (Nước vô, trầy nhẹ, đứt dây...)" 
                         Text="{Binding Condition}" Margin="0,0,0,15" FontSize="16"/>

                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         materialDesign:HintAssist.Hint="Đường dẫn file ảnh minh chứng bằng hình chụp (VD: D:\loi.jpg)" 
                         Text="{Binding ImagePath}" Margin="0,0,0,15" FontSize="14"/>

                <TextBlock Text="Sản phẩm lỗi tiếp nhận:" Margin="0,15,0,5" FontWeight="SemiBold"/>
                <DataGrid ItemsSource="{Binding BrokenItems}"
                          AutoGenerateColumns="False" CanUserAddRows="False" Height="200"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên SP" Binding="{Binding Product.Name}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="BH (tháng)" Binding="{Binding Product.WarrantyMonths}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Ghi chú thêm" Binding="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="HOÀN TẤT BIÊN NHẬN (LƯU)" Height="60" FontSize="18" FontWeight="Bold" Margin="0,20,0,0"
                        Command="{Binding CreateWarrantyCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#9B59B6" BorderBrush="#9B59B6"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
