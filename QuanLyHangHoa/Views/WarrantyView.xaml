<UserControl x:Class="QuanLyHangHoa.Views.WarrantyView"
             x:Name="RootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:WarrantyViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QuanLyHangHoa;component/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- Main Content (List, Search & Stats) -->
        <Grid Margin="{StaticResource PagePadding}" MaxWidth="1600" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="WrenchOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="QUẢN LÝ BẢO HÀNH" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Theo dõi tình trạng tiếp nhận, sửa chữa và trả máy" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CreateWarrantyCommand}" Style="{StaticResource PrimaryButton}" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="TẠO PHIẾU BẢO HÀNH" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Summary Stats -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,12,0" Padding="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewList" Foreground="{StaticResource AppPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="TỔNG TIẾP NHẬN" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalWarrantyCount}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="12,0" Padding="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tools" Foreground="{StaticResource AppWarningBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="ĐANG SỬA CHỮA" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RepairingCount}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppWarningBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="12,0" Padding="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckDecagram" Foreground="{StaticResource AppSuccessBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="CHỜ TRẢ KHÁCH" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CompletedCount}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppSuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Margin="12,0,0,0" Padding="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarAlert" Foreground="{StaticResource AppErrorBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="QUÁ HẠN HẸN" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OverdueCount}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppErrorBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Filter Section -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Margin="{StaticResource Margin.Bottom.md}" Padding="{StaticResource Spacing.md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>     <!-- Mã phiếu -->
                        <ColumnDefinition Width="1.5*"/>     <!-- Serial/IMEI -->
                        <ColumnDefinition Width="1.5*"/>     <!-- Khách hàng -->
                        <ColumnDefinition Width="160"/>       <!-- Trạng thái -->
                        <ColumnDefinition Width="160"/>       <!-- Từ ngày -->
                        <ColumnDefinition Width="160"/>       <!-- Đến ngày -->
                        <ColumnDefinition Width="Auto"/>      <!-- Nút hành động -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Claim Code -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="MÃ PHIẾU" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" Margin="0" materialDesign:HintAssist.Hint="Tìm mã phiếu..." 
                                 Text="{Binding SearchClaimCode, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Serial -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="SỐ SERIAL / IMEI" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" Margin="0" materialDesign:HintAssist.Hint="Tìm số serial..." 
                                 Text="{Binding SearchSerial, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Customer -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="40" Margin="0" materialDesign:HintAssist.Hint="Tìm khách hàng..." 
                                 Text="{Binding SearchCustomer, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" Height="40" Margin="0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding StatusList}" 
                                  SelectedItem="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- From Date -->
                    <StackPanel Grid.Column="4" Margin="0,0,12,0">
                        <TextBlock Text="TỪ NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <DatePicker SelectedDate="{Binding SearchFromDate, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource AppDatePickerStyle}"
                                    Height="40" Margin="0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Grid.Column="5" Margin="0,0,12,0">
                        <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                        <DatePicker SelectedDate="{Binding SearchToDate, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource AppDatePickerStyle}"
                                    Height="40" Margin="0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Command="{Binding ResetFilterCommand}" 
                                Style="{StaticResource ProMaxIconButtonStyle}" Width="40" Height="40"
                                ToolTip="Reset bộ lọc">
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 3: Main Content -->
            <materialDesign:Card Grid.Row="3" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Warranties}" SelectedItem="{Binding SelectedWarranty}"
                              AlternationCount="10000" EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              BorderThickness="0" RowHeight="56" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="MÃ PHIẾU" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClaimCode}" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.md}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="2*">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="SẢN PHẨM / SERIAL" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductSerial.Product.DisplayName}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding ProductSerial.SerialNumber}" Style="{StaticResource TypographyDataMono}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="*" Binding="{Binding CustomerName}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="KHÁCH HÀNG" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TRẠNG THÁI" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource StatusToBgBrushConverter}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" 
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToFgBrushConverter}}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="120" Binding="{Binding ReceivedDate, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="NGÀY NHẬN" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="120" Binding="{Binding ExpectedReturnDate, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="HẸN TRẢ" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="THAO TÁC" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}"
                                                    ToolTip="Xem chi tiết" 
                                                    Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" Foreground="{StaticResource AppPrimaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}"
                                                    ToolTip="Chỉnh sửa" 
                                                    Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}"
                                                    ToolTip="In phiếu" 
                                                    Command="{Binding DataContext.PrintWarrantyCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PrinterOutline" Width="18" Height="18" Foreground="{StaticResource AppTertiaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource ProMaxIconButtonStyle}"
                                                    ToolTip="Xóa"
                                                    Command="{Binding DataContext.DeleteWarrantyCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Foreground="{StaticResource AppErrorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Left">
                            <Run Text="Hiện có "/>
                            <Run Text="{Binding TotalWarrantyCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=" phiếu bảo hành trong hệ thống · "/>
                            <Run Text="{Binding OpenCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource WarningTextBrush}"/>
                            <Run Text=" Đang xử lý · "/>
                            <Run Text="{Binding ManufacturerWaitCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource WarningTextBrush}"/>
                            <Run Text=" Gửi hãng · "/>
                            <Run Text="{Binding ReadyCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                            <Run Text=" Chờ trả khách · "/>
                            <Run Text="{Binding ClosedCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                            <Run Text=" Đã trả khách · "/>
                            <Run Text="{Binding RejectedCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}"/>
                            <Run Text=" Từ chối"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ========================================== -->
        <!-- SLIDING OVERLAY PANEL (DRAWER)             -->
        <!-- ========================================== -->
        <Grid Visibility="{Binding IsDetailPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Semi-transparent Backdrop with Click-to-Close -->
            <Border Background="#40000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Drawer Container -->
            <Border HorizontalAlignment="Right" Width="480" Margin="0"
                    Background="{StaticResource AppSurfaceBrush}" 
                    BorderBrush="{StaticResource AppBorderBrush}" 
                    BorderThickness="1,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#20000000" ShadowDepth="0" Direction="0" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Content (Scrollable) -->
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceMutedBrush}">
                        <Grid>
                            <!-- Resolution Mode Title -->
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wrench" Width="20" Height="20" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="XỬ LÝ PHIẾU BẢO HÀNH" Style="{StaticResource TypographyH3}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- Close Button -->
                            <Button HorizontalAlignment="Right" Style="{StaticResource ProMaxIconButtonStyle}" Command="{Binding CloseDetailCommand}">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Form Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            
                            <!-- Resolution Mode UI -->
                            <StackPanel>
                                
                                <!-- Read-Only Ticket Summary Details -->
                                <Border CornerRadius="{StaticResource Radius.md}" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" 
                                        Background="{StaticResource SurfaceMutedBrush}" Padding="16" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Claim Code -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã phiếu bảo hành:" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedWarranty.ClaimCode}" Style="{StaticResource TypographyBodyBold}" Margin="0,0,0,8"/>

                                        <!-- Product Display Name -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sản phẩm tiếp nhận:" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedWarranty.ProductSerial.Product.DisplayName}" Style="{StaticResource TypographyBody}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <!-- Product Serial -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Số Serial/IMEI gốc:" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedWarranty.ProductSerial.SerialNumber}" Style="{StaticResource TypographyDataMono}" Margin="0,0,0,8"/>

                                        <!-- Customer Name -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tên khách hàng:" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedWarranty.CustomerName}" Style="{StaticResource TypographyBody}" Margin="0,0,0,8"/>

                                        <!-- Receive Date -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ngày tiếp nhận:" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedWarranty.ReceivedDate, StringFormat='dd/MM/yyyy'}" Style="{StaticResource TypographyBody}" Margin="0,0,0,8"/>

                                        <!-- Current Status -->
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Trạng thái hiện tại:" Style="{StaticResource TypographyLabel}" Margin="0,0,0,8" VerticalAlignment="Center"/>
                                        <Border Grid.Row="5" Grid.Column="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8"
                                                Background="{Binding SelectedWarranty.Status, Converter={StaticResource StatusToBgBrushConverter}}">
                                            <TextBlock Text="{Binding SelectedWarranty.Status, Converter={StaticResource StatusToTextConverter}}" 
                                                       Foreground="{Binding SelectedWarranty.Status, Converter={StaticResource StatusToFgBrushConverter}}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Problem Description -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Chi tiết mô tả lỗi:" Style="{StaticResource TypographyLabel}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedWarranty.ProblemDescription}" Style="{StaticResource TypographyBody}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <!-- Technical Conclusion Input -->
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="KẾT LUẬN KỸ THUẬT" Style="{StaticResource DetailFormLabel}"/>
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" Text="{Binding TechnicalConclusion, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Mô tả tình trạng lỗi kiểm tra thực tế và phương án giải quyết..."/>
                                </StackPanel>

                                <Separator Margin="0,0,0,20" Background="{StaticResource AppBorderBrush}"/>

                                <TextBlock Text="CÁC PHƯƠNG ÁN XỬ LÝ PHÙ HỢP" Style="{StaticResource TypographyLabelBold}" Margin="0,0,0,12" Foreground="{StaticResource AppPrimaryBrush}"/>

                                <!-- Option 1: Hoàn thành sửa chữa tại cửa hàng -->
                                <Border BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" CornerRadius="{StaticResource Radius.md}" Padding="12" Margin="0,0,0,12" Background="{StaticResource AppSurfaceBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="Tools" Foreground="#4CAF50" Width="18" Height="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="Xử lý / Sửa chữa tại cửa hàng" Style="{StaticResource TypographyLabelBold}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Sửa chữa/khắc phục lỗi thành công tại chỗ. Máy chuyển trạng thái Chờ trả khách hàng." Style="{StaticResource TypographyCaption}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <Button Command="{Binding CompleteRepairCommand}" Height="38" Background="#4CAF50" BorderBrush="#4CAF50">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckBold" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="HOÀN THÀNH SỬA CHỮA" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Option 2: Gửi hãng bảo hành -->
                                <Border BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" CornerRadius="{StaticResource Radius.md}" Padding="12" Margin="0,0,0,12" Background="{StaticResource AppSurfaceBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="Send" Foreground="#FF9800" Width="18" Height="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="Gửi bảo hành lên Hãng sản xuất" Style="{StaticResource TypographyLabelBold}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- Manufacturer details fields -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Manufacturer Name -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                                                <TextBlock Text="Tên Hãng Sản Xuất" Style="{StaticResource TypographySmall}" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource AppTextBoxStyle}" Height="36" Text="{Binding ManufacturerName, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            
                                            <!-- Tracking Code -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
                                                <TextBlock Text="Mã Vận Đơn Gửi" Style="{StaticResource TypographySmall}" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource AppTextBoxStyle}" Height="36" Text="{Binding ManufacturerTrackingCode, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>

                                            <!-- Expected Return Date -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                                <TextBlock Text="Hẹn Hãng Trả Máy Ngày" Style="{StaticResource TypographySmall}" Margin="0,0,0,4"/>
                                                <DatePicker Style="{StaticResource AppDatePickerStyle}" Height="36" SelectedDate="{Binding ManufacturerExpectedReturnDate}"/>
                                            </StackPanel>

                                            <!-- Manufacturer Note -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                                <TextBlock Text="Ghi chú gửi kèm / Kết quả hãng" Style="{StaticResource TypographySmall}" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource AppTextBoxStyle}" Height="36" Text="{Binding ManufacturerNote, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Command="{Binding SendManufacturerCommand}" Height="38" Background="#FF9800" BorderBrush="#FF9800">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Send" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="XÁC NHẬN GỬI HÃNG" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Option 3: Nhận máy trả từ hãng -->
                                <Border BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" CornerRadius="{StaticResource Radius.md}" Padding="12" Margin="0,0,0,12" Background="{StaticResource AppSurfaceBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="CallReceived" Foreground="#2196F3" Width="18" Height="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="Nhận sản phẩm từ Hãng trả về" Style="{StaticResource TypographyLabelBold}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Khi hãng bảo hành xong và gửi trả lại máy về cho cửa hàng tiếp nhận." Style="{StaticResource TypographyCaption}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        
                                        <!-- Case 3A: Hãng sửa xong, trả máy cũ -->
                                        <Button Command="{Binding ReceiveManufacturerRepairedCommand}" Height="38" Background="#2196F3" BorderBrush="#2196F3" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckBold" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="NHẬN MÁY ĐÃ SỬA XONG" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Separator Margin="0,0,0,12" Background="{StaticResource AppBorderBrush}"/>

                                        <!-- Case 3B: Hãng đổi mới thiết bị -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Số Serial Thiết Bị Mới từ Hãng" Style="{StaticResource TypographySmall}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="36" Text="{Binding NewManufacturerSerial, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Nhập số serial thiết bị mới được đổi..."/>
                                        </StackPanel>
                                        
                                        <Button Command="{Binding ReceiveManufacturerReplacedCommand}" Height="38" Style="{StaticResource SecondaryButton}" BorderBrush="#2196F3" Foreground="#2196F3">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Cached" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="NHẬN ĐỔI MỚI TỪ HÃNG" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Option 4: Đổi thiết bị mới từ kho của cửa hàng -->
                                <Border BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" CornerRadius="{StaticResource Radius.md}" Padding="12" Margin="0,0,0,12" Background="{StaticResource AppSurfaceBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Foreground="{StaticResource PrimaryPurpleBrush}" Width="18" Height="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="Đổi thiết bị mới từ Kho cửa hàng" Style="{StaticResource TypographyLabelBold}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Xuất ngay 1 sản phẩm mới có serial sẵn trong kho để đổi mới cho khách hàng." Style="{StaticResource TypographyCaption}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Mã Serial thay thế trong Kho" Style="{StaticResource TypographySmall}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="36" Text="{Binding ReplacementSerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Nhập serial thiết bị thay thế sẵn trong kho..."/>
                                        </StackPanel>
                                        
                                        <Button Command="{Binding ReplaceWarrantySerialCommand}" Height="38" Style="{StaticResource PrimaryButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Cached" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="XÁC NHẬN ĐỔI MỚI TỪ KHO" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Option 5: Từ chối bảo hành -->
                                <Border BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" CornerRadius="{StaticResource Radius.md}" Padding="12" Margin="0,0,0,12" Background="{StaticResource AppSurfaceBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="CloseCircle" Foreground="{StaticResource AppErrorBrush}" Width="18" Height="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="Từ chối yêu cầu bảo hành" Style="{StaticResource TypographyLabelBold}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Sản phẩm không đủ điều kiện bảo hành (rơi vỡ, ngập nước...). Trả lại máy cho khách hàng." Style="{StaticResource TypographyCaption}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Lý do từ chối bảo hành" Style="{StaticResource TypographySmall}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource AppTextBoxStyle}" Height="36" Text="{Binding RejectionReason, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Nhập lý do chi tiết từ chối bảo hành..."/>
                                        </StackPanel>
                                        
                                        <Button Command="{Binding RejectWarrantyCommand}" Height="38" Style="{StaticResource DangerButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="XÁC NHẬN TỪ CHỐI BẢO HÀNH" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
