<UserControl x:Class="QuanLyHangHoa.Views.WarrantyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tiep nhan bao hanh" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Ma phieu" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ClaimCode, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Serial" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Mo ta loi" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ProblemDescription, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <Button Grid.Column="3" Content="Tao phieu" Command="{Binding CreateWarrantyClaimCommand}" Background="#6366F1" Foreground="White" Padding="18,10" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Xu ly phieu bao hanh" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,14">
                    <TextBlock Text="ClaimId" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ClaimIdText, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,14">
                    <TextBlock Text="Ket luan ky thuat" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding TechnicalConclusion, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,14,14">
                    <TextBlock Text="Ghi chu gui hang" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManufacturerNote, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,14">
                    <TextBlock Text="Serial doi moi" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ReplacementSerialNumber, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,14,0">
                    <TextBlock Text="Ly do tu choi" Foreground="White" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding RejectionReason, UpdateSourceTrigger=PropertyChanged}" Background="#374151" Foreground="White" Padding="8"/>
                </StackPanel>

                <WrapPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Gui hang" Command="{Binding SendManufacturerCommand}" Background="#F59E0B" Foreground="White" Padding="14,9" BorderThickness="0" Margin="0,0,8,0"/>
                    <Button Content="Hoan tat sua" Command="{Binding CompleteRepairCommand}" Background="#10B981" Foreground="White" Padding="14,9" BorderThickness="0" Margin="0,0,8,0"/>
                    <Button Content="Doi serial" Command="{Binding ReplaceWarrantySerialCommand}" Background="#6366F1" Foreground="White" Padding="14,9" BorderThickness="0" Margin="0,0,8,0"/>
                    <Button Content="Tu choi" Command="{Binding RejectWarrantyCommand}" Background="#EF4444" Foreground="White" Padding="14,9" BorderThickness="0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
