<UserControl x:Class="QuanLyHangHoa.Views.WarrantyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="WrenchOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="QUẢN LÝ BẢO HÀNH" Style="{StaticResource TypographyH2}"/>
                        <TextBlock Text="Theo dõi tình trạng tiếp nhận, sửa chữa và trả máy" Style="{StaticResource TypographyCaption}"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CreateWarrantyCommand}" Style="{StaticResource AppPrimaryButton}" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="TẠO PHIẾU BẢO HÀNH" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Summary Stats -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,12,0" Padding="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewList" Foreground="{StaticResource AppPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="TỔNG TIẾP NHẬN" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalWarrantyCount}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="12,0" Padding="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tools" Foreground="{StaticResource AppWarningBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="ĐANG SỬA CHỮA" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RepairingCount}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppWarningBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="12,0" Padding="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckDecagram" Foreground="{StaticResource AppSuccessBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="CHỜ TRẢ KHÁCH" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CompletedCount}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppSuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Margin="12,0,0,0" Padding="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarAlert" Foreground="{StaticResource AppErrorBrush}" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="QUÁ HẠN HẸN" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OverdueCount}" Style="{DynamicResource TypographyH3}" Foreground="{StaticResource AppErrorBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Filter Section -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Margin="{StaticResource Margin.Bottom.md}" Padding="{StaticResource Spacing.md}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Primary Search -->
                        <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="TÌM KIẾM" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <Grid>
                                <TextBox materialDesign:HintAssist.Hint="Tìm mã phiếu, Serial/IMEI, khách hàng..." 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" VerticalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="{StaticResource TextDisabledBrush}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource AppSecondaryButton}" 
                                    Command="{Binding ToggleAdvancedFilterCommand}"
                                    Height="32" Padding="12,0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="BỘ LỌC NÂNG CAO" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource AppPrimaryButton}" 
                                    Command="{Binding LoadDataCommand}"
                                    Height="32" Padding="16,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="TÌM KIẾM" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Filter Row (Expandable) -->
                    <Grid Margin="0,16,0,0" Visibility="{Binding IsAdvancedFilterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>    <!-- Status -->
                            <ColumnDefinition Width="200"/>    <!-- From Date -->
                            <ColumnDefinition Width="200"/>    <!-- To Date -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Filter -->
                        <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="TRẠNG THÁI" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <ComboBox ItemsSource="{Binding StatusList}" 
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- From Date -->
                        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="TỪ NGÀY" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <DatePicker SelectedDate="{Binding SearchFromDate}"
                                       Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- To Date -->
                        <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                            <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                            <DatePicker SelectedDate="{Binding SearchToDate}"
                                       Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Row 3: Main Content -->
            <materialDesign:Card Grid.Row="3" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Padding="{StaticResource Spacing.md}" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ListBox" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                            <TextBlock Text="DANH SÁCH PHIẾU BẢO HÀNH" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.md}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Warranties}" SelectedItem="{Binding SelectedWarranty}"
                               AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                               BorderThickness="0" RowHeight="56" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="MÃ PHIẾU" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.md}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SẢN PHẨM / SERIAL" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductSerial.Product.DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ProductSerial.SerialNumber}" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding CustomerName}" Width="*"/>
                            
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Tiếp nhận">
                                                            <Setter Property="Background" Value="#1A2196F3"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Đang sửa">
                                                            <Setter Property="Background" Value="#1AFFC107"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Hoàn thành">
                                                            <Setter Property="Background" Value="#1A4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Đã trả">
                                                            <Setter Property="Background" Value="#1A9E9E9E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Tiếp nhận">
                                                                <Setter Property="Foreground" Value="#2196F3"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Đang sửa">
                                                                <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Hoàn thành">
                                                                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="NGÀY NHẬN" Binding="{Binding ReceiveDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                            <DataGridTextColumn Header="HẸN TRẢ" Binding="{Binding ReturnDate, StringFormat=dd/MM/yyyy}" Width="120"/>

                            <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                                    Command="{Binding DataContext.EditWarrantyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Edit" Width="18" Height="18" Foreground="{StaticResource AppSecondaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                                    Command="{Binding DataContext.PrintWarrantyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Foreground="{StaticResource AppTertiaryBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                                    Command="{Binding DataContext.DeleteWarrantyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Foreground="{StaticResource AppErrorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
