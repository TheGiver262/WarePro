<UserControl x:Class="QuanLyHangHoa.Views.WarrantyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section (Transparent) -->
            <Grid Grid.Row="0" Margin="{StaticResource Margin.Bottom.md}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldCheck" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <TextBlock Text="QUẢN LÝ BẢO HÀNH" Style="{StaticResource TypographyH2}" Margin="{StaticResource Margin.Left.md}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="TẠO PHIẾU MỚI" Command="{Binding CreateWarrantyCommand}" Style="{StaticResource AppPrimaryButton}"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row (Integrated Search) -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" Height="40" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="{StaticResource Padding.sm}" Foreground="{StaticResource AppSecondaryBrush}"/>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 materialDesign:HintAssist.Hint="Tìm kiếm theo mã phiếu, serial/IMEI..." 
                                 FontSize="14" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Content="TÌM KIẾM" Command="{Binding LoadDataCommand}" Style="{StaticResource AppSecondaryButton}" Margin="{StaticResource Margin.Left.sm}" Height="40"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Data Table -->
                <materialDesign:Card Grid.Column="0" Margin="{StaticResource Margin.Right.lg}" Style="{StaticResource AppCard}" Padding="0">
                    <DataGrid ItemsSource="{Binding Warranties}" SelectedItem="{Binding SelectedWarranty}"
                               AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                               BorderThickness="0" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ PHIẾU" Binding="{Binding Id}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                            <DataGridTextColumn Header="NGÀY NHẬN" Binding="{Binding ReceiveDate, StringFormat=dd/MM/yyyy}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                            <DataGridTextColumn Header="SERIAL / IMEI" Binding="{Binding ProductSerial.SerialNumber}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Đang sửa">
                                                <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Hoàn thành">
                                                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- Detail Panel -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.Bottom.lg}">
                            <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CHI TIẾT PHIẾU BẢO HÀNH" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Left.sm}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Lý do bảo hành" Margin="{StaticResource Margin.Bottom.md}" 
                                         Text="{Binding SelectedWarranty.IssueDescription}" TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalContentAlignment="Top"/>
                                
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Ghi chú kỹ thuật" Margin="{StaticResource Margin.Bottom.md}" 
                                         Text="{Binding SelectedWarranty.TechnicalNote}" TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalContentAlignment="Top"/>

                                <ComboBox ItemsSource="{Binding StatusList}" SelectedItem="{Binding SelectedWarranty.Status}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Trạng thái xử lý" Margin="{StaticResource Margin.Bottom.md}"/>
                                
                                <DatePicker SelectedDate="{Binding SelectedWarranty.ReturnDate}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" materialDesign:HintAssist.Hint="Hẹn ngày trả hàng"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="{StaticResource Margin.Top.lg}">
                            <Button Content="CẬP NHẬT PHIẾU" Command="{Binding SaveWarrantyCommand}" 
                                    Style="{StaticResource AppPrimaryButton}" Margin="{StaticResource Margin.Bottom.sm}"/>
                            <Button Content="XÓA PHIẾU" Command="{Binding DeleteWarrantyCommand}" 
                                    Style="{StaticResource AppDangerButton}"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
