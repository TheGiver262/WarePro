<UserControl x:Class="QuanLyHangHoa.Views.WarrantyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header / Toolbar -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,24" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheck" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                        <TextBlock Text="QUẢN LÝ BẢO HÀNH" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="250" materialDesign:HintAssist.Hint="Tìm theo Serial/IMEI..." 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,16,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="TẠO PHIẾU MỚI" Command="{Binding CreateWarrantyCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="8" Height="40"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Data Table -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,20,0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                    <DataGrid ItemsSource="{Binding Warranties}" SelectedItem="{Binding SelectedWarranty}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding Id}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                            <DataGridTextColumn Header="Ngày Nhận" Binding="{Binding ReceiveDate, StringFormat=dd/MM/yyyy}" Width="Auto" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="Serial / IMEI" Binding="{Binding ProductSerial.SerialNumber}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Đang sửa">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Hoàn thành">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- Detail Panel -->
                <materialDesign:Card Grid.Column="1" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource PrimaryIndigoBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CHI TIẾT PHIẾU BẢO HÀNH" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Lý do bảo hành" Margin="0,0,0,16" 
                                         Text="{Binding SelectedWarranty.IssueDescription}" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"/>
                                
                                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Ghi chú kỹ thuật" Margin="0,0,0,16" 
                                         Text="{Binding SelectedWarranty.TechnicalNote}" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"/>

                                <ComboBox ItemsSource="{Binding StatusList}" SelectedItem="{Binding SelectedWarranty.Status}"
                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}" materialDesign:HintAssist.Hint="Trạng thái xử lý" Margin="0,0,0,16"/>
                                
                                <DatePicker SelectedDate="{Binding SelectedWarranty.ReturnDate}" 
                                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}" materialDesign:HintAssist.Hint="Hẹn ngày trả"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,20,0,0">
                            <Button Content="CẬP NHẬT PHIẾU" Command="{Binding SaveWarrantyCommand}" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" Height="48" materialDesign:ButtonAssist.CornerRadius="12" Margin="0,0,0,12"/>
                            <Button Content="XÓA PHIẾU" Command="{Binding DeleteWarrantyCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#EF5350" BorderBrush="#EF5350" Height="40" materialDesign:ButtonAssist.CornerRadius="8"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
