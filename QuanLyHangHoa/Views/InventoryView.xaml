<UserControl x:Class="QuanLyHangHoa.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource Spacing.lg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <materialDesign:Card Grid.Row="0" Margin="{StaticResource Margin.Bottom.lg}" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Warehouse" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="BÁO CÁO TỒN KHO" Style="{StaticResource TypographyH2}" Margin="{StaticResource Margin.Left.md}" VerticalAlignment="Center" Foreground="{StaticResource AppPrimaryBrush}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.md}" Width="300" Height="40" Margin="{StaticResource Margin.Right.md}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="{StaticResource Spacing.sm}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" 
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                         materialDesign:HintAssist.Hint="Tìm kiếm..." FontSize="13" Background="Transparent"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                        <Button Content="TẢI LẠI DỮ LIỆU" Command="{Binding RefreshCommand}" 
                                Style="{StaticResource AppSecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Statistics Bar -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="{StaticResource Spacing.lg}" Margin="{StaticResource Margin.Bottom.lg}" Background="{StaticResource AppBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartPie" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Tổng hợp dữ liệu tồn kho thực tế từ tất cả các kho hàng." 
                                   Style="{StaticResource TypographyCaption}" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.md}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="TỔNG GIÁ TRỊ TỒN KHO:" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center" Margin="{StaticResource Margin.Right.md}"/>
                        <TextBlock Text="{Binding TotalInventoryValue, StringFormat='N0'}" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" VNĐ" Style="{StaticResource TypographyCaption}" VerticalAlignment="Bottom" Margin="{StaticResource Margin.Left.xs}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Main DataGrid -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Padding="{StaticResource Spacing.md}" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListNumbered" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                            <TextBlock Text="CHI TIẾT SỐ DƯ TỒN KHO" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center" Margin="{StaticResource Margin.Left.md}" Foreground="{StaticResource AppPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryItems}" AutoGenerateColumns="False" 
                               CanUserAddRows="False" IsReadOnly="True" RowHeight="28" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ SP" Binding="{Binding ProductCode}" Width="100" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="TÊN SẢN PHẨM" Binding="{Binding ProductName}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="PHÂN LOẠI" Binding="{Binding CategoryName}" Width="*"/>
                            <DataGridTextColumn Header="ĐƠN VỊ" Binding="{Binding UnitName}" Width="100"/>
                            
                            <DataGridTemplateColumn Header="SỐ LƯỢNG TỒN" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StockQuantity, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Bold" Margin="{StaticResource Margin.Right.sm}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="GIÁ VỐN TB" Binding="{Binding AverageCost, StringFormat=N0}" Width="140" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                            <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding TotalValue, StringFormat=N0}" Width="160" FontWeight="SemiBold" Foreground="{StaticResource AppTertiaryBrush}" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
