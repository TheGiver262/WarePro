<UserControl x:Class="QuanLyHangHoa.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             xmlns:converters="clr-namespace:QuanLyHangHoa.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:InventoryViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <!-- Row 0: Header Section -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Search & Filter Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Main Content Card -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartBar" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="BÁO CÁO TỒN KHO" Style="{StaticResource TypographyH1}" Foreground="{StaticResource AppTertiaryBrush}"/>
                        <TextBlock Text="Theo dõi số lượng và giá trị hàng hóa hiện có trong kho" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource AppSecondaryButton}" Height="40" Padding="20,0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExport" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="XUẤT BÁO CÁO" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource AppPrimaryButton}" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="TẢI LẠI" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search & Stats -->
            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Margin="{StaticResource SectionBottomMargin}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Bar -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="24" Height="48" Padding="16,0" Width="400">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Search" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Mã SP, tên SP hoặc vị trí..."
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         Style="{StaticResource InputText}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Summary Stats -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="20,10" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Margin="0,0,12,0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MẶT HÀNG SẮP HẾT" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppErrorBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="25" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppErrorBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="20,10" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG GIÁ TRỊ" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="1.250.000.000" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Main Content Card -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Table Action Bar -->
                    <Border Grid.Row="0" Padding="20,12" Background="{StaticResource AppSurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppBorderBrush}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                                <TextBlock Text="DANH SÁCH TỒN KHO CHI TIẾT" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Tổng giá trị kho: " Style="{StaticResource TypographyCaption}" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Text="1.25 tỷ VNĐ" Style="{StaticResource TypographyCaption}" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                               ItemsSource="{Binding InventoryItems}"
                               AutoGenerateColumns="False" CanUserAddRows="False"
                               BorderThickness="0" Background="Transparent"
                               SelectionMode="Single" RowHeight="54">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ SẢN PHẨM" Binding="{Binding ProductCode}" Width="150" ElementStyle="{StaticResource AppDataGridTextBold}"/>
                            <DataGridTextColumn Header="TÊN SẢN PHẨM" Binding="{Binding ProductName}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="DANH MỤC" Binding="{Binding CategoryName}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="ĐƠN VỊ" Binding="{Binding UnitName}" Width="100" ElementStyle="{StaticResource AppDataGridTextCenter}"/>
                            
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TỒN KHO" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StockQuantity, StringFormat='N0'}" Style="{StaticResource TypographyBody}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="GIÁ TRỊ" Binding="{Binding TotalValue, StringFormat='N0'}" Width="160" ElementStyle="{StaticResource AppDataGridTextRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
