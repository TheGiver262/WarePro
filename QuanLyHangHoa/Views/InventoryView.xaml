<UserControl x:Class="QuanLyHangHoa.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             xmlns:converters="clr-namespace:QuanLyHangHoa.Converters"
             xmlns:helpers="clr-namespace:QuanLyHangHoa.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:InventoryViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <!-- Row 0: Header Section -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Search & Filter Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Main Content Card -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartBar" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="BÁO CÁO TỒN KHO" Style="{StaticResource TypographyH1}"/>
                        <TextBlock Text="Theo dõi số lượng và giá trị hàng hóa hiện có trong kho" Style="{StaticResource TypographyCaption}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <!-- Summary Stats di chuyển lên Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="20,10" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Margin="0,0,12,0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MẶT HÀNG SẮP HẾT" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppErrorBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppErrorBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,10" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TỔNG GIÁ TRỊ" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalInventoryValue, StringFormat='N0'}" Style="{StaticResource TypographyH3}" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search Row (Standardized Pro Max - Single Row) -->
            <materialDesign:Card Grid.Row="1" Margin="{StaticResource SectionBottomMargin}" Padding="16" Style="{StaticResource AppCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>      <!-- Mã -->
                        <ColumnDefinition Width="*"/>        <!-- Tên -->
                        <ColumnDefinition Width="200"/>      <!-- Danh mục -->
                        <ColumnDefinition Width="180"/>      <!-- Trạng thái -->
                        <ColumnDefinition Width="Auto"/>     <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="MÃ SẢN PHẨM" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Mã sản phẩm..."
                                 Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="TÊN SẢN PHẨM" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Height="32" Margin="0" VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Tìm kiếm theo tên sản phẩm..."
                                 Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Grid.Column="2" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="DANH MỤC" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SelectedCategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName"
                                  Height="32" Margin="0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Stock Status -->
                    <StackPanel Grid.Column="3" Margin="{StaticResource Margin.Right.md}">
                        <TextBlock Text="TRẠNG THÁI TỒN KHO" Style="{StaticResource TypographyLabel}" Margin="{StaticResource Margin.Bottom.xs}"/>
                        <ComboBox Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding StatusOptions}" 
                                  SelectedItem="{Binding SearchStatus, UpdateSourceTrigger=PropertyChanged}"
                                  Height="32" Margin="0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource AppRefreshButton}" 
                                Command="{Binding RefreshCommand}"
                                ToolTip="Làm mới bộ lọc"
                                Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>

                        <Button Style="{StaticResource AppExcelButton}" 
                                Command="{Binding ExportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="XUẤT EXCEL" VerticalAlignment="Center" Style="{StaticResource TypographyButtonText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Row 2: Main Content Card -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- DataGrid -->
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding InventoryItems}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              BorderThickness="0"
                              SelectionMode="Single" RowHeight="56"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              helpers:DataGridHelper.LoadMoreCommand="{Binding LoadMoreCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ProductCode}" Width="150" ElementStyle="{DynamicResource AppDataGridTextBold}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="MÃ SẢN PHẨM" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding ProductName, Mode=OneWay}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TÊN SẢN PHẨM" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding CategoryName}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="DANH MỤC" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding UnitName}" Width="100" ElementStyle="{DynamicResource AppDataGridTextCenter}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="ĐƠN VỊ" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="TỒN KHO" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,16,0" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource ProMaxBadgeBorderStyle}">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StockQuantity, StringFormat='N0'}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ProMaxBadgeTextBlockStyle}">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Binding="{Binding TotalValue, StringFormat='N0'}" Width="160" ElementStyle="{DynamicResource AppDataGridTextRight}">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"/>
                                        <TextBlock Text="GIÁ TRỊ" Style="{StaticResource TypographyLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer -->
                    <Border Grid.Row="1" Padding="20,12" Background="{StaticResource AppFooterBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="13" Foreground="{StaticResource AppSecondaryBrush}" Style="{StaticResource TypographyCaption}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Run Text="Hiện có "/>
                            <Run Text="{Binding InventoryItems.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=" mặt hàng trong bộ lọc · "/>
                            <Run Text="{Binding LowStockCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}"/>
                            <Run Text=" dưới định mức tồn · Tổng giá trị tồn: "/>
                            <Run Text="{Binding TotalInventoryValue, StringFormat='N0', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource InfoTextBrush}"/>
                            <Run Text=" VNĐ"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
