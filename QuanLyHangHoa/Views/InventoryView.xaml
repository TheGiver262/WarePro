<UserControl x:Class="QuanLyHangHoa.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QuanLyHangHoa.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">
    
    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,24" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource PrimaryHueLightBrush}" Width="48" Height="48" CornerRadius="12">
                            <materialDesign:PackIcon Kind="Warehouse" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                        </Border>
                        <TextBlock Text="BÁO CÁO TỒN KHO" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox Width="280" materialDesign:HintAssist.Hint="Tìm kiếm theo mã hoặc tên..." 
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,16,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" VerticalContentAlignment="Center"/>
                        <Button Content="TẢI LẠI DỮ LIỆU" Command="{Binding RefreshCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="{StaticResource PrimaryIndigoBrush}" BorderBrush="{StaticResource PrimaryIndigoBrush}"
                                materialDesign:ButtonAssist.CornerRadius="8" Height="40"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Statistics / Info Summary Bar -->
            <materialDesign:Card Grid.Row="1" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp1" Padding="20" Margin="0,0,0,24" Background="#F0F9FF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartPie" Foreground="#0369A1" VerticalAlignment="Center"/>
                        <TextBlock Text="Tổng hợp dữ liệu tồn kho thực tế từ tất cả các kho hàng hiện có." 
                                   Foreground="#0C4A6E" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="TỔNG GIÁ TRỊ TỒN KHO:" Foreground="#0369A1" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding TotalInventoryValue, StringFormat='N0'}" Foreground="#166534" FontSize="22" FontWeight="Black" VerticalAlignment="Center"/>
                        <TextBlock Text=" VNĐ" Foreground="#0369A1" FontSize="13" VerticalAlignment="Bottom" Margin="4,0,4,4" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Main Inventory DataGrid -->
            <materialDesign:Card Grid.Row="2" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Padding="20,16" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListNumbered" VerticalAlignment="Center" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                            <TextBlock Text="CHI TIẾT SỐ DƯ TỒN KHO" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryItems}" AutoGenerateColumns="False" CanUserAddRows="False" 
                              IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0" Margin="0">
                        <DataGrid.Columns>
                            <materialDesign:DataGridTextColumn Header="Mã SP" Binding="{Binding ProductCode}" Width="100" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <materialDesign:DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding ProductName}" Width="2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <materialDesign:DataGridTextColumn Header="Phân Loại" Binding="{Binding CategoryName}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <materialDesign:DataGridTextColumn Header="Đơn Vị" Binding="{Binding UnitName}" Width="100" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            
                            <DataGridTemplateColumn Header="Số Lượng Tồn" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StockQuantity, StringFormat='N0'}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <materialDesign:DataGridTextColumn Header="Giá Vốn TB" Binding="{Binding AverageCost, StringFormat=N0}" Width="140" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                            <materialDesign:DataGridTextColumn Header="Thành Tiền" Binding="{Binding TotalValue, StringFormat=N0}" Width="160" FontWeight="SemiBold" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
