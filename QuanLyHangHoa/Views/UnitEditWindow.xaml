<Window x:Class="QuanLyHangHoa.Views.UnitEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}" Height="400" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="{StaticResource AppSurfaceBrush}" CornerRadius="{StaticResource Radius.lg}" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="CubeOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource TypographyH1}"/>
                    <TextBlock Text="Cập nhật thông tin đơn vị đo lường" Style="{StaticResource TypographyCaption}"/>
                </StackPanel>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Mã đơn vị" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource AppTextBoxStyle}" 
                         materialDesign:HintAssist.Hint="Nhập mã (ví dụ: KG, CAI)"
                         materialDesign:HintAssist.IsFloating="False"
                         Text="{Binding UnitCode, UpdateSourceTrigger=PropertyChanged}"
                         Height="50" Margin="0,0,0,20"
                         IsReadOnly="{Binding IsEditMode}"/>

                <TextBlock Text="Tên đơn vị" Style="{StaticResource TypographyCaption}" Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource AppTextBoxStyle}" 
                         materialDesign:HintAssist.Hint="Nhập tên hiển thị"
                         materialDesign:HintAssist.IsFloating="False"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Height="50" Margin="0,0,0,20"/>

                <CheckBox Content="Hoạt động" 
                          IsChecked="{Binding IsActive}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,0,0,10"/>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" 
                        Margin="0,0,8,0" Click="Cancel_Click" Height="32">
                    <TextBlock Text="HUỶ BỎ" Style="{StaticResource TypographyButtonText}"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" 
                        Margin="8,0,0,0" Click="Confirm_Click" Height="32">
                    <TextBlock Text="XÁC NHẬN" Style="{StaticResource TypographyButtonText}"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
