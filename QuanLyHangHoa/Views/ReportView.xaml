<UserControl x:Class="QuanLyHangHoa.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource BodyBgBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="16,8" Margin="0,0,0,24">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ChartBar" Width="28" Height="28" Foreground="{StaticResource PrimaryIndigoBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="BÁO CÁO DOANH THU &amp; LỢI NHUẬN" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <DatePicker Width="150" materialDesign:HintAssist.Hint="Từ ngày" SelectedDate="{Binding FromDate}" 
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,16,0"/>
                        <DatePicker Width="150" materialDesign:HintAssist.Hint="Đến ngày" SelectedDate="{Binding ToDate}" 
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,16,0"/>
                        <Button Content="XUẤT BÁO CÁO" Command="{Binding RefreshCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="8" Height="36"/>
                    </StackPanel>
                </DockPanel>
            </materialDesign:Card>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,24">
                <materialDesign:Card Margin="0,0,12,0" UniformCornerRadius="12" Padding="20" Background="#EEF2FF">
                    <StackPanel>
                        <TextBlock Text="TỔNG DOANH THU" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat=N0}" FontSize="24" FontWeight="Bold" Foreground="#1E1B4B" Margin="0,8,0,0"/>
                        <TextBlock Text="VNĐ" FontSize="10" Foreground="#4F46E5" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="12,0,12,0" UniformCornerRadius="12" Padding="20" Background="#F0FDF4">
                    <StackPanel>
                        <TextBlock Text="TỔNG LỢI NHUẬN" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                        <TextBlock Text="{Binding TotalProfit, StringFormat=N0}" FontSize="24" FontWeight="Bold" Foreground="#052E16" Margin="0,8,0,0"/>
                        <TextBlock Text="VNĐ" FontSize="10" Foreground="#15803D" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="12,0,0,0" UniformCornerRadius="12" Padding="20" Background="#FFF1F2">
                    <StackPanel>
                        <TextBlock Text="TỔNG CHI PHÍ" FontSize="12" FontWeight="SemiBold" Foreground="#BE123C"/>
                        <TextBlock Text="{Binding TotalCost, StringFormat=N0}" FontSize="24" FontWeight="Bold" Foreground="#4C0519" Margin="0,8,0,0"/>
                        <TextBlock Text="VNĐ" FontSize="10" Foreground="#BE123C" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <materialDesign:Card Grid.Row="2" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Padding="0">
                <DataGrid ItemsSource="{Binding DailyReports}" AutoGenerateColumns="False" CanUserAddRows="False" 
                          IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        <DataGridTextColumn Header="Doanh Thu" Binding="{Binding Revenue, StringFormat=N0}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                        <DataGridTextColumn Header="Chi Phí" Binding="{Binding Cost, StringFormat=N0}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                        <DataGridTextColumn Header="Lợi Nhuận" Binding="{Binding Profit, StringFormat=N0}" Width="*" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}">
                                    <Setter Property="Foreground" Value="#10B981"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
