<UserControl x:Class="QuanLyHangHoa.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Stats/Filter -->
                <RowDefinition Height="*"/>    <!-- Data -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="{StaticResource SectionBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartBoxOutline" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="BÁO CÁO DOANH THU &amp; LỢI NHUẬN" Style="{StaticResource TypographyH2}"/>
                        <TextBlock Text="Phân tích hiệu quả kinh doanh theo thời gian" Style="{StaticResource TypographyCaption}"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker Width="160" materialDesign:HintAssist.Hint="Từ ngày" SelectedDate="{Binding FromDate}" 
                                Style="{StaticResource AppDatePickerStyle}" Height="40" Margin="0,0,12,0"/>
                    <DatePicker Width="160" materialDesign:HintAssist.Hint="Đến ngày" SelectedDate="{Binding ToDate}" 
                                Style="{StaticResource AppDatePickerStyle}" Height="40" Margin="0,0,12,0"/>
                    <Button Content="XEM BÁO CÁO" Command="{Binding RefreshCommand}" 
                            Style="{StaticResource AppPrimaryButton}" Height="40" Padding="20,0"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Summary Stats -->
            <Grid Grid.Row="1" Margin="{StaticResource Margin.Bottom.lg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource AppCard}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="TỔNG DOANH THU" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat=N0}" FontSize="28" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock Text="VNĐ" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSecondaryBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Margin="12,0,12,0" Style="{StaticResource AppCard}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="TỔNG LỢI NHUẬN" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalProfit, StringFormat=N0}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" Margin="0,12,0,0"/>
                        <TextBlock Text="VNĐ" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource AppSuccessBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource AppCard}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="TỔNG CHI PHÍ" Style="{StaticResource TypographyLabel}" Foreground="{StaticResource AppSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalCost, StringFormat=N0}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}" Margin="0,12,0,0"/>
                        <TextBlock Text="VNĐ" Style="{StaticResource TypographyCaption}" Foreground="{StaticResource DangerTextBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Row 2: Data Table -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TableLarge" VerticalAlignment="Center" Foreground="{StaticResource AppTertiaryBrush}"/>
                            <TextBlock Text="CHI TIẾT DOANH THU THEO NGÀY" VerticalAlignment="Center" Style="{StaticResource TypographyLabel}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DailyReports}" AutoGenerateColumns="False" CanUserAddRows="False" 
                              IsReadOnly="True" BorderThickness="0" RowHeight="48" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NGÀY" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                            <DataGridTextColumn Header="DOANH THU" Binding="{Binding Revenue, StringFormat=N0}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                            <DataGridTextColumn Header="CHI PHÍ" Binding="{Binding Cost, StringFormat=N0}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                            <DataGridTextColumn Header="LỢI NHUẬN" Binding="{Binding Profit, StringFormat=N0}" Width="*" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}">
                                        <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
