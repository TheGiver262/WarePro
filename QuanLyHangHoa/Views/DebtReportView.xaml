<UserControl x:Class="QuanLyHangHoa.Views.DebtReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Style="{StaticResource AppCard}" Padding="16,8" Margin="0,0,0,24">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountClock" Width="28" Height="28" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ReportTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppTertiaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="KHÁCH HÀNG" Command="{Binding ShowCustomersCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource AppTertiaryBrush}" Margin="0,0,8,0"/>
                        <Button Content="NHÀ CUNG CẤP" Command="{Binding ShowSuppliersCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource AppTertiaryBrush}" Margin="0,0,8,0"/>
                        <Button Content="TẢI LẠI" Command="{Binding RefreshCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="8" Height="36"/>
                    </StackPanel>
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Style="{StaticResource AppCard}" Padding="20" Margin="0,0,0,20" Background="#F0F9FF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Foreground="#0369A1" VerticalAlignment="Center"/>
                        <TextBlock Text="Báo cáo chỉ hiển thị các đối tác hiện đang còn dư nợ chưa thanh toán hết." 
                                   Foreground="#0C4A6E" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="TỔNG DƯ NỢ:" Foreground="#0369A1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding TotalDebt, StringFormat='N0'}" Foreground="#C2410C" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" VNĐ" Foreground="#0369A1" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
                <DataGrid ItemsSource="{Binding Summaries}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}" 
                          BorderThickness="0" RowHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding PartyId}" Width="100" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnCenterElementStyle}"/>
                        <DataGridTextColumn Header="Tên Đối Tác" Binding="{Binding PartyName}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnElementStyle}"/>
                        <DataGridTextColumn Header="Tổng Giao Dịch" Binding="{Binding TotalAmount, StringFormat=N0}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                        <DataGridTextColumn Header="Đã Thanh Toán" Binding="{Binding PaidAmount, StringFormat=N0}" Width="150" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}"/>
                        <DataGridTextColumn Header="Còn Nợ" Binding="{Binding DebtAmount, StringFormat=N0}" Width="150" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnRightElementStyle}">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="3" Margin="0,20,0,0" UniformCornerRadius="8" Padding="12" Background="{StaticResource PrimaryHueLightBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource AppTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppTertiaryBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
