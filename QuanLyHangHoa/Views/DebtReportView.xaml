<UserControl x:Class="QuanLyHangHoa.Views.DebtReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding ReportTitle}" FontSize="24" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Khach hang" Command="{Binding ShowCustomersCommand}" Background="#2563EB" Foreground="White" Padding="14,8" Margin="0,0,8,0" BorderThickness="0"/>
                <Button Content="Nha cung cap" Command="{Binding ShowSuppliersCommand}" Background="#7C3AED" Foreground="White" Padding="14,8" Margin="0,0,8,0" BorderThickness="0"/>
                <Button Content="Tai lai" Command="{Binding RefreshCommand}" Background="#10B981" Foreground="White" Padding="14,8" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Chi hien cac doi tac con phat sinh cong no chua thanh toan." Foreground="#D1D5DB" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalDebt, StringFormat='Tong no: {0:N0}'}" Foreground="#FCA5A5" FontSize="18" FontWeight="Bold"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Summaries}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="#1F2937"
                  Foreground="Black"
                  RowBackground="#374151"
                  AlternatingRowBackground="#1F2937">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ma" Binding="{Binding PartyId}" Width="0.5*"/>
                <DataGridTextColumn Header="Doi tac" Binding="{Binding PartyName}" Width="2*"/>
                <DataGridTextColumn Header="Tong tien" Binding="{Binding TotalAmount, StringFormat=N0}" Width="1*"/>
                <DataGridTextColumn Header="Da tra" Binding="{Binding PaidAmount, StringFormat=N0}" Width="1*"/>
                <DataGridTextColumn Header="Con no" Binding="{Binding DebtAmount, StringFormat=N0}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock Text="{Binding ReportTitle}" Foreground="White" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding TotalDebt, StringFormat='Tong cong no: {0:N0}'}" Foreground="#A7F3D0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
