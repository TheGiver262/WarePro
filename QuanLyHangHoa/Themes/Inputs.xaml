<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Global TextBox Style Override -->
    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="{StaticResource Radius.sm}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AppTertiaryBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Global ComboBox Style Override -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="{StaticResource Radius.sm}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Global PasswordBox Style Override -->
    <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="{StaticResource Radius.sm}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

</ResourceDictionary>
