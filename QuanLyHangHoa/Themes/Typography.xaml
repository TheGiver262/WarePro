<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WarePro UI Design Guideline - Typography section 5 -->

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="DataMonoFontFamily">Consolas, monospace</FontFamily>

    <!-- Display (rarely used) -->
    <Style x:Key="TypographyDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- H1 - Dashboard/Page Title §5: 22px Bold -->
    <Style x:Key="TypographyH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- H2 - Page titles §5: 20-22px Bold -->
    <Style x:Key="TypographyH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- H3 - Section titles or stat values -->
    <Style x:Key="TypographyH3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- H4 - Smaller section titles -->
    <Style x:Key="TypographyH4" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Body text §5: 13px Regular (Standard for data and content) -->
    <Style x:Key="TypographyBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Label §5: 12px SemiBold (For structural labels/headers) -->
    <Style x:Key="TypographyLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Label Bold §5: 12px SemiBold -->
    <Style x:Key="TypographyLabelBold" TargetType="TextBlock" BasedOn="{StaticResource TypographyLabel}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Body Bold §5: 13px SemiBold -->
    <Style x:Key="TypographyBodyBold" TargetType="TextBlock" BasedOn="{StaticResource TypographyBody}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Caption / Subtitle §5: 13-14px Regular TextSecondary -->
    <Style x:Key="TypographyCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Small text §5: 11px Regular -->
    <Style x:Key="TypographySmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Stat number §5: 24px Bold -->
    <Style x:Key="TypographyStatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="StatNumberInputStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Button Text style - No foreground to inherit from Button -->
    <Style x:Key="TypographyButtonText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Monospace data -->
    <Style x:Key="TypographyDataMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DataMonoFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Control Body §5: 13px Regular (For Inputs/Controls) -->
    <Style x:Key="TypographyControlBody" TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Aliases for easier use in views -->
    <Style x:Key="TitleText" BasedOn="{StaticResource TypographyH2}" TargetType="TextBlock"/>
    <Style x:Key="SubtitleText" BasedOn="{StaticResource TypographyCaption}" TargetType="TextBlock"/>
    <Style x:Key="LabelText" BasedOn="{StaticResource TypographyLabel}" TargetType="TextBlock"/>
    <Style x:Key="BodyText" BasedOn="{StaticResource TypographyBody}" TargetType="TextBlock"/>
    
    <!-- Input Aliases -->
    <Style x:Key="InputText" BasedOn="{StaticResource TypographyControlBody}" TargetType="Control"/>

    <!-- Detail Form Label — For field labels in detail/create forms (unified spacing) -->
    <Style x:Key="DetailFormLabel" TargetType="TextBlock" BasedOn="{StaticResource TypographyLabel}">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

</ResourceDictionary>
