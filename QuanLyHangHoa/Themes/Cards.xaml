<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- WarePro UI Design Guideline — Cards §9.1 + §10.1 -->

    <Style x:Key="AppCard" TargetType="materialDesign:Card">
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/>
        <Setter Property="UniformCornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
    </Style>

    <!-- Global Card Override -->
    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource AppCard}"/>

</ResourceDictionary>
