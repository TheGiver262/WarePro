<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- WarePro UI Design Guideline — Sidebar Navigation §6 -->

    <!-- Sidebar Container Style -->
    <Style x:Key="SidebarContainer" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SidebarBgBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Sidebar Item Style (RadioButton) §6.2 + §6.3 -->
    <Style x:Key="SidebarItemStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="GroupName" Value="SidebarMenu"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.md}" Padding="12,0">
                        <StackPanel x:Name="stackPanel" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SafePackIconKindConverter}}" 
                                                     Width="20" Height="20" VerticalAlignment="Center" 
                                                     Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="content" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
                        </MultiTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="content" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="border" Property="Padding" Value="0"/>
                            <Setter TargetName="stackPanel" Property="HorizontalAlignment" Value="Center"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Section Header §6.3 -->
    <Style x:Key="SidebarSectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="16,20,0,8"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
