<Window x:Class="QuanLyHangHoa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Phần Mềm Quản Lý Hàng Hoá &amp; Bảo Hành" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="240"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="68"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Sidebar §6                                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo §6.1 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="ViewDashboard" Width="28" Height="28" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <TextBlock Text="WarePro" Foreground="{StaticResource TextOnPrimaryBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Navigation Menu §6.1 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="8,0">
                        <RadioButton Content="Dashboard" Tag="ViewDashboardOutline" Style="{StaticResource SidebarItemStyle}" IsChecked="True" Command="{Binding OpenDashboardCommand}"/>

                        <TextBlock Text="DANH MỤC" Style="{StaticResource SidebarSectionHeader}"/>
                        <RadioButton Content="Loại sản phẩm" Tag="TagOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenCategoryViewCommand}"/>
                        <RadioButton Content="Thương hiệu" Tag="Domain" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenBrandViewCommand}"/>
                        <RadioButton Content="Đơn vị tính" Tag="CubeOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenUnitViewCommand}"/>
                        <RadioButton Content="Nhà cung cấp" Tag="HandshakeOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenSupplierViewCommand}"/>
                        <RadioButton Content="Khách hàng" Tag="AccountGroupOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenCustomerViewCommand}"/>

                        <TextBlock Text="SẢN PHẨM" Style="{StaticResource SidebarSectionHeader}"/>
                        <RadioButton Content="Danh sách sản phẩm" Tag="PackageVariant" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenProductViewCommand}"/>
                        <RadioButton Content="Quản lý Serial" Tag="BarcodeScan" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenProductSerialViewCommand}"/>

                        <TextBlock Text="KHO" Style="{StaticResource SidebarSectionHeader}"/>
                        <RadioButton Content="Nhập kho" Tag="ArrowDownBold" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenStockInViewCommand}"/>
                        <RadioButton Content="Xuất kho" Tag="ArrowUpBold" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenStockOutViewCommand}"/>
                        <RadioButton Content="Chuyển kho" Tag="SwapHorizontal" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenStockTransferViewCommand}"/>
                        <RadioButton Content="Tồn kho" Tag="ChartBar" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenInventoryViewCommand}"/>
                        <RadioButton Content="Điều chỉnh kho" Tag="Tune" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenStockAdjustmentViewCommand}"/>
                        <RadioButton Content="Kiểm kê" Tag="ClipboardCheckOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenStockCountViewCommand}"/>

                        <TextBlock Text="HÓA ĐƠN" Style="{StaticResource SidebarSectionHeader}"/>
                        <RadioButton Content="Hóa đơn mua" Tag="CartOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenPurchaseInvoiceViewCommand}"/>
                        <RadioButton Content="Hóa đơn bán" Tag="FileDocumentOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenSalesInvoiceViewCommand}"/>

                        <TextBlock Text="BẢO HÀNH" Style="{StaticResource SidebarSectionHeader}"/>
                        <RadioButton Content="Quyền bảo hành" Tag="ShieldCheckOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenWarrantyCoverageViewCommand}"/>
                        <RadioButton Content="Yêu cầu bảo hành" Tag="WrenchOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenWarrantyViewCommand}"/>

                        <TextBlock Text="HỆ THỐNG" Style="{StaticResource SidebarSectionHeader}"/>
                        <RadioButton Content="Báo cáo" Tag="ChartBoxOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenReportViewCommand}"/>
                        <RadioButton Content="Người dùng" Tag="AccountMultipleOutline" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenAppUserViewCommand}"
                                     Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <RadioButton Content="Nhật ký hệ thống" Tag="ShieldCheck" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenAuditLogViewCommand}"
                                     Visibility="{Binding CanViewLogs, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <RadioButton Content="Đổi mật khẩu" Tag="KeyVariant" Style="{StaticResource SidebarItemStyle}" Command="{Binding OpenChangePasswordViewCommand}"/>

                        <Border Height="20"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- User Footer §6 -->
                <Border Grid.Row="2" Background="{StaticResource SidebarBgDarkerBrush}" Padding="16" BorderBrush="{StaticResource SidebarBgDarkerBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryPurpleBrush}">
                            <TextBlock Text="{Binding CurrentUser.FullName[0]}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="{StaticResource SidebarTextBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUser.RoleCode}" Foreground="{StaticResource SidebarMutedTextBrush}" FontWeight="Medium" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="30" Height="30" Foreground="{StaticResource SidebarTextBrush}" Command="{Binding LogoutCommand}" ToolTip="Đăng xuất">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Grid.Column" Value="0"/>
                                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Visibility" Value="Collapsed"/> <!-- Actually, let's keep avatar and hide logout, or hide avatar and keep logout? User usually wants avatar. -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Main Content Area                           -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar §7 -->
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource TopBarBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Width="40" Height="40" Margin="-8,0,16,0"
                                Foreground="{StaticResource PrimaryPurpleBrush}"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Thu gọn/Mở rộng menu">
                            <materialDesign:PackIcon Kind="Menu" Width="24" Height="24"/>
                        </Button>
                        
                        <TextBlock Text="Phần mềm Quản lý Hàng hóa &amp; Bảo hành" 
                                   Foreground="{StaticResource TopBarTextBrush}" 
                                   FontSize="14" FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content §2 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentView}"/>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
