@startuml Sequence_ImportTonDauKy_ExcelCsv
title Opening balance import sequence
actor User
participant UI
participant VM
participant ImportService
participant Parser
participant Posting
database DB
User -> UI : choose_excel_csv
UI -> VM : ImportCommand
VM -> ImportService : ImportFile
ImportService -> Parser : ParseRows
Parser --> ImportService : rows_or_errors
alt errors
  ImportService --> VM : ImportResult_errors
  VM --> UI : show_ImportResultWindow
else valid
  ImportService -> DB : create_StockIn_and_lines
  ImportService -> Posting : PostStockIn_OpeningBalance
  Posting -> DB : update_balance_serial_ledger_audit
  ImportService --> VM : ImportResult_success
  VM --> UI : refresh
end
@enduml
