@startuml ScreenFlow_GiaoDien
title Screen flow thuc te theo MainViewModel
[*] --> LoginView
LoginView --> MainWindow : dang nhap thanh cong
LoginView --> ChangePasswordView : doi mat khau
ChangePasswordView --> MainWindow : cap nhat thanh cong
state MainWindow {
  [*] --> DashboardView
  DashboardView --> ProductView : Kho hang / san pham
  DashboardView --> StockInView : Nhap kho
  DashboardView --> StockOutView : Xuat kho
  DashboardView --> StockTransferView : Chuyen kho
  DashboardView --> StockAdjustmentView : Dieu chinh
  DashboardView --> StockCountView : Kiem ke
  DashboardView --> PurchaseInvoiceView : Hoa don mua
  DashboardView --> SalesInvoiceView : Hoa don ban
  DashboardView --> WarrantyView : Bao hanh
  DashboardView --> CategoryView : Danh muc
  DashboardView --> BrandView : Thuong hieu
  DashboardView --> UnitView : Don vi tinh
  DashboardView --> SupplierView : Nha cung cap
  DashboardView --> CustomerView : Khach hang
  DashboardView --> InventoryView : Ton kho
  DashboardView --> ProductSerialView : Quan ly serial
  DashboardView --> OpeningBalanceImportView : Nhap ton dau ky
  DashboardView --> ReportView : Bao cao + truy vet
  DashboardView --> AppUserView : Nguoi dung
  DashboardView --> AuditLogView : Nhat ky he thong
  DashboardView --> ChangePasswordView : Doi mat khau
  ProductView --> ProductEditWindow
  ProductSerialView --> ProductSerialDetailView
  ProductSerialView --> ProductSerialEditView
  StockInView --> SerialInputWindow
  StockOutView --> SerialInputWindow
  StockTransferView --> SerialInputWindow
  StockCountView --> SerialInputWindow
  OpeningBalanceImportView --> ImportInstructionWindow
  OpeningBalanceImportView --> ImportResultWindow
  WarrantyView --> CreateWarrantyWindow
  WarrantyView --> WarrantyPrintWindow
}
MainWindow --> LoginView : dang xuat
MainWindow --> [*] : dong ung dung
@enduml
