@startuml Component_WPF_MVVM
title Real components of QuanLyHangHoa
package WPF_Client {
  [MainWindow] as MainWindow
  [Views_XAML] as Views
  [ViewModels_RelayCommand] as ViewModels
  [Styles_Converters_Dialogs] as UiHelpers
  MainWindow --> Views
  Views --> ViewModels
  Views --> UiHelpers
}
package Services {
  [AuthenticationService] as Auth
  [AuthorizationService] as Authz
  [CatalogServices] as Catalog
  [StockInService] as StockIn
  [StockOutService] as StockOut
  [StockTransferService] as Transfer
  [StockAdjustmentService] as Adjustment
  [StockCountService] as StockCount
  [InvoiceService] as Invoice
  [WarrantyClaimService] as WarrantyClaim
  [ProductSerialService] as SerialSvc
  [ReportTraceService] as Trace
  [DashboardService] as Dashboard
  [AuditLogService] as Audit
  [ImportServices] as Import
}
package Inventory_Core {
  [InventoryPostingService] as Posting
  [InventoryAdjustmentService] as AdjustPosting
  [EfInventoryUnitOfWork] as Uow
}
package Data_Libraries {
  [AppDbContext] as Db
  database SQLServer as Sql
  [ClosedXML] as ClosedXml
  [CSV_Parser] as Csv
}
ViewModels --> Auth
ViewModels --> Authz
ViewModels --> Catalog
ViewModels --> StockIn
ViewModels --> StockOut
ViewModels --> Transfer
ViewModels --> Adjustment
ViewModels --> StockCount
ViewModels --> Invoice
ViewModels --> WarrantyClaim
ViewModels --> SerialSvc
ViewModels --> Trace
ViewModels --> Dashboard
ViewModels --> Audit
ViewModels --> Import
StockIn --> Posting
StockOut --> Posting
Transfer --> Posting
Adjustment --> AdjustPosting
WarrantyClaim --> Posting
Import --> Posting
Posting --> Uow
AdjustPosting --> Uow
Uow --> Db
Auth --> Db
Catalog --> Db
Invoice --> Db
Trace --> Db
Audit --> Db
Db --> Sql
Import --> ClosedXml
Import --> Csv
@enduml
