@startuml Component_WPF_MVVM
title Sơ đồ Thành phần (Component Diagram) hệ thống WPF MVVM

package "Presentation Component (WPF App)" {
    [Views (XAML Windows/Pages)] as Views
    [ViewModels (Commands/DataBinding)] as ViewModels
    [Value Converters & Styles] as Styles
    
    Views .right.> ViewModels : Data Context & Binding
    ViewModels ..> Styles : Uses
}

package "Application Services Component" {
    interface "IAuthService" as IAuth
    interface "IStockService" as IStock
    interface "IWarrantyService" as IWarranty
    interface "ICatalogService" as ICat
    
    [Auth & Authorization Service] as AuthService
    [Inventory & Stock Service] as StockService
    [Warranty Claim Service] as WarrantyService
    [Catalog Service] as CatalogService
    [Inventory Posting Service] as PostingService
    
    AuthService -up- IAuth
    StockService -up- IStock
    WarrantyService -up- IWarranty
    CatalogService -up- ICat
    
    StockService .down.> PostingService : delegates
    WarrantyService .down.> PostingService : delegates
}

package "Infrastructure & Data Component" {
    interface "IUnitOfWork" as IUOW
    
    [EfUnitOfWork & Repositories] as UOW
    [EF Core 8 AppDbContext] as DbContext
    [Database Transaction Handler] as TxHandler
    
    UOW -up- IUOW
    UOW .down.> DbContext : manages
    DbContext .right.> TxHandler : transaction control
}

database "SQL Server" as DB {
    [Tables & Relationships] as Tables
}

package "External Integrations" {
    [Excel/CSV Helper (ClosedXML)] as ExcelHelper
    [Manufacturer API Connector] as MfgAPI
}

' Kết nối giữa các thành phần
ViewModels ..( IAuth : calls
ViewModels ..( IStock : calls
ViewModels ..( IWarranty : calls
ViewModels ..( ICat : calls

AuthService ..( IUOW : database access
StockService ..( IUOW : database access
WarrantyService ..( IUOW : database access
CatalogService ..( IUOW : database access
PostingService ..( IUOW : writes Ledger/Balances

DbContext ..> DB : ADO.NET SQL Provider

StockService ..> ExcelHelper : uses for Import
WarrantyService ..> MfgAPI : syncs Claims

@enduml
