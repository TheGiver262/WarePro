@startuml Deployment_HeThong
title Sơ đồ Triển khai (Deployment Diagram) hệ thống WareHousePro

node "Client PC (Máy tính Nhân viên)" as ClientPC {
    node "Hệ điều hành Windows 10/11" {
        node ".NET Runtime 8.0" {
            artifact "WareHousePro.exe\n(WPF Client Application)" as AppExe
        }
    }
}

node "Chi nhánh / Nhân viên làm việc từ xa" as RemoteUser {
    node "Client PC (Remote)" as RemotePC {
        artifact "WareHousePro.exe" as RemoteExe
    }
}

cloud "Mạng truyền thông" {
    queue "Mạng LAN nội bộ (Văn phòng chính)" as LAN
    queue "Kết nối VPN bảo mật" as VPN
}

node "Máy chủ Cơ sở dữ liệu (Main DB Server)" as DBServer {
    node "Hệ điều hành Windows Server 2022" {
        database "SQL Server 2022 Enterprise" as MSSQL {
            [Database: QuanLyHangHoa] as DBName
        }
    }
}

node "Máy chủ Backup (Cloud Backup Storage)" as BackupServer {
    node "Azure Blob Storage / AWS S3" {
        [Tệp sao lưu CSDL (.bak)] as BakFile
    }
}

cloud "Manufacturer Cloud Server" as MfgCloud {
    node "API Server (Hãng sản xuất)" {
        [Warranty Verification Service] as MfgService
    }
}

' Đường truyền kết nối vật lý
AppExe --> LAN : TCP/IP (Mạng LAN)
RemoteExe --> VPN : IPsec / SSL VPN
VPN --> LAN : Gateway

LAN --> MSSQL : Cổng 1433 (ADO.NET Connection)

MSSQL --> BackupServer : Đồng bộ backup hàng ngày (HTTPS)
AppExe --> MfgCloud : Gọi API bảo hành qua HTTPS (Cổng 443)
RemoteExe --> MfgCloud : Gọi API bảo hành qua HTTPS (Cổng 443)

@enduml
