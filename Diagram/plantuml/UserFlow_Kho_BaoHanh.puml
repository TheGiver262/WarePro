@startuml UserFlow_Kho_BaoHanh
title Sơ đồ User Flow - Hành trình tương tác qua các Màn hình

start
:Màn hình Đăng nhập (LoginScreen);
if (Nhập sai thông tin?) then (Đúng)
  :Hiển thị lỗi validation/cảnh báo khóa;
  stop
else (Đăng nhập thành công)
  :Màn hình chính & Dashboard (MainDashboardScreen);
  
  if (Vai trò người dùng?) then (Thủ kho)
    partition "User Flow - Thủ kho" {
      :Click Menu "Quản lý Kho";
      :Màn hình Danh sách Phiếu nhập (StockInListScreen);
      :Click nút "Lập phiếu nhập";
      :Màn hình Chi tiết Phiếu nhập (StockInDetailScreen);
      :Chọn Nhà cung cấp & Kho hàng;
      :Click "Thêm sản phẩm";
      :Nhập số lượng & đơn giá;
      if (Sản phẩm quản lý theo Serial?) then (Có)
        :Mở Pop-up "Quét/Nhập số Serial" (SerialInputPopup);
        :Quét/nhập danh sách mã Serial;
        :Bấm "Xác nhận Serial";
      else (Không)
      endif
      :Bấm nút "Lưu nháp";
      :Phiếu lưu ở trạng thái Draft;
      :Bấm nút "Ghi sổ" (Post);
      if (Hệ thống kiểm tra lỗi dữ liệu/trùng serial?) then (Có lỗi)
        :Hiển thị Pop-up thông báo lỗi;
        :Sửa thông tin trên màn hình chi tiết;
      else (Hợp lệ)
        :Hiển thị thông báo "Ghi sổ thành công";
        :Phiếu chuyển sang trạng thái Posted;
        :Quay lại Màn hình Danh sách Phiếu nhập;
      endif
    }
  else (Kỹ thuật viên bảo hành)
    partition "User Flow - Nhân viên Bảo hành" {
      :Click Menu "Quản lý Bảo hành";
      :Màn hình Danh sách Claim (WarrantyClaimListScreen);
      :Click nút "Tiếp nhận bảo hành";
      :Màn hình Tạo hồ sơ bảo hành (WarrantyClaimCreateScreen);
      :Nhập/quét số Serial của thiết bị;
      if (Hệ thống kiểm tra quyền bảo hành?) then (Hết hạn / Không có)
        :Hiển thị cảnh báo: "Không đủ điều kiện bảo hành";
        :Bấm "Hủy tiếp nhận";
        stop
      else (Hợp lệ)
        :Hệ thống tự động hiển thị thông tin Khách hàng & Sản phẩm;
        :Nhập mô tả lỗi của khách hàng;
        :Bấm nút "Tạo hồ sơ";
        :Hồ sơ chuyển sang trạng thái Checking;
        :Màn hình Chi tiết Hồ sơ bảo hành (WarrantyClaimDetailScreen);
        :Kỹ thuật viên nhập "Kết luận kỹ thuật";
        :Chọn phương án "Đổi mới thiết bị";
        :Mở Pop-up "Chọn sản phẩm thay thế" (ReplacementProductPopup);
        :Chọn Serial thay thế từ danh sách tồn kho;
        :Bấm "Xác nhận đổi mới";
        if (Hệ thống báo thiếu hàng thay thế?) then (Có)
          :Hiển thị cảnh báo lỗi;
          :Chuyển trạng thái hồ sơ sang "Chờ hàng thay thế";
        else (Thành công)
          :Hiển thị thông báo "Đổi mới thành công";
          :Hệ thống in "Phiếu đổi trả bảo hành" (PrintPreviewScreen);
          :Bàn giao máy mới cho khách;
          :Hồ sơ cập nhật trạng thái "Closed";
        endif
      endif
    }
  endif
  
endif
stop
@enduml
