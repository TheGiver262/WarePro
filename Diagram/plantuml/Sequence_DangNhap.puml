@startuml Sequence_DangNhap
title Login sequence
actor User
participant UI
participant VM
participant AuthService
participant AppDbContext
database DB
User -> UI : enter_credentials
UI -> VM : LoginCommand
VM -> AuthService : Login
AuthService -> AppDbContext : find_user
AppDbContext -> DB : SELECT_AppUser
DB --> AppDbContext : user_data
AppDbContext --> AuthService : AppUser
AuthService -> AuthService : verify_password_and_status
alt valid
  AuthService -> AppDbContext : update_last_login
  AuthService --> VM : success
  VM --> UI : open_MainWindow
else invalid
  AuthService --> VM : failed
  VM --> UI : show_error
end
@enduml
