@startuml Sequence_XuatKho_GhiSo
title Stock-out posting sequence
actor Staff
participant UI
participant VM
participant Authz
participant StockOutService
participant Posting
participant Uow
database DB
Staff -> UI : enter_stock_out
UI -> VM : Save_Post_Command
VM -> Authz : CanPerform_PostStockOut
Authz --> VM : OK
VM -> StockOutService : SaveDraft
StockOutService -> DB : upsert_StockOut_and_lines
VM -> StockOutService : Post
StockOutService -> DB : load_document
StockOutService -> StockOutService : validate_stock_and_serials
alt invalid
  StockOutService --> VM : validation_error
  VM --> UI : show_error
else valid
  StockOutService -> Posting : PostStockOut
  Posting -> Uow : apply_entries
  Uow -> DB : update_balance_serial_coverage_ledger_audit
  Uow -> DB : mark_document_posted
  StockOutService --> VM : success
  VM --> UI : refresh
end
@enduml
