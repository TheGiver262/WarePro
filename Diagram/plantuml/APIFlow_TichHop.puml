@startuml APIFlow_TichHop
title Real integration flow - Excel CSV EFCore SQLServer
actor User
participant UI
participant VM
participant ImportSvc
participant Parser
participant Posting
database DB
User -> UI : choose_file
UI -> VM : ImportCommand
VM -> ImportSvc : ImportFile
ImportSvc -> Parser : ParseRows
Parser --> ImportSvc : ImportResult
alt valid_data
  ImportSvc -> DB : create_catalog_product_serial_documents
  ImportSvc -> Posting : PostStockIn_or_PostStockOut
  Posting -> DB : update_balance_serial_ledger_audit
  ImportSvc --> VM : success_summary
else invalid_data
  ImportSvc --> VM : row_errors
  VM --> UI : show_errors
end
@enduml
