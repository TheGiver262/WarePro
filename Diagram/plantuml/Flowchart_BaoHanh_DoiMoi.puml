@startuml Flowchart_BaoHanh_DoiMoi
title Flowchart Quy trình Kiểm tra Bảo hành & Đổi mới

start
:Tiếp nhận thiết bị lỗi từ khách hàng;
:Quét số Serial của thiết bị;
if (Kiểm tra Serial có tồn tại trong hệ thống?) then (Không)
  :Thông báo: "Serial không hợp lệ hoặc không thuộc hệ thống";
  stop
else (Có)
  :Truy vấn Quyền bảo hành (WarrantyCoverage);
  if (Hạn bảo hành (EndDate) >= Ngày hiện tại?) then (Không)
    :Thông báo: "Sản phẩm đã hết hạn bảo hành";
    :Từ chối bảo hành;
    stop
  else (Có)
    :Kiểm tra xem có hồ sơ bảo hành (WarrantyClaim) nào đang mở không;
    if (Đã có claim đang ở trạng thái Checking/Repairing/SentToManufacturer?) then (Có)
      :Thông báo: "Sản phẩm đang nằm trong một quy trình bảo hành khác";
      stop
    else (Không)
      :Khởi tạo hồ sơ bảo hành mới (WarrantyClaim);
      :Chuyển trạng thái claim thành "Checking";
      :Chuyển trạng thái Serial thành "InWarrantyProcess";
      :Kỹ thuật viên kiểm tra lỗi thiết bị;
      if (Lỗi do người dùng (rơi vỡ, ngấm nước, tự ý sửa chữa)?) then (Có)
        :Cập nhật claim: Quyết định từ chối (Rejected);
        :Bàn giao lại thiết bị cũ cho khách hàng;
        :Chuyển trạng thái Serial về "Sold";
        :Cập nhật claim thành "Closed";
        stop
      else (Không - Lỗi do nhà sản xuất)
        if (Thiết bị có thể sửa chữa nội bộ?) then (Có)
          :Tiến hành sửa chữa nội bộ;
          :Cập nhật claim thành "Repairing" -> "Repaired";
          :Bàn giao thiết bị đã sửa cho khách hàng;
          :Chuyển trạng thái Serial về "Sold";
          :Cập nhật claim thành "Closed";
          stop
        else (Không - Hỏng nặng hoặc lỗi nhà sản xuất cần gửi hãng/đổi mới)
          if (Gửi hãng bảo hành?) then (Có)
            :Chuyển thiết bị về hãng;
            :Cập nhật claim: "SentToManufacturer" -> "WaitingManufacturerResult";
            if (Hãng phản hồi sửa chữa được?) then (Có)
              :Nhận lại máy đã sửa từ hãng;
              :Cập nhật claim thành "Repaired";
              :Bàn giao thiết bị cho khách;
              :Chuyển trạng thái Serial về "Sold";
              :Cập nhật claim thành "Closed";
              stop
            else (Không - Hãng quyết định đổi mới)
              :Duyệt phương án Đổi mới thiết bị;
            endif
          else (Không - Đổi mới ngay lập tức)
            :Duyệt phương án Đổi mới thiết bị;
          endif
          
          :Kiểm tra tồn kho thiết bị thay thế khả dụng;
          if (Có sẵn sản phẩm cùng model/serial thay thế trong kho?) then (Không)
            :Thông báo: "Thiếu hàng thay thế trong kho";
            :Chuyển trạng thái claim thành "WaitingDecision" (Chờ hàng nhập hoặc phương án khác);
            stop
          else (Có)
            :BEGIN TRANSACTION (Đảm bảo toàn vẹn dữ liệu);
            :Đóng quyền bảo hành cũ (WarrantyCoverage -> Inactive);
            :Tính số ngày bảo hành còn lại của máy cũ (RemainingDays);
            :Tạo phiếu xuất kho đổi mới bảo hành (StockOut - WarrantyReplacement);
            :Trực tiếp ghi sổ xuất kho (Posted):
            - Trừ tồn kho sản phẩm thay thế (StockBalance)
            - Chuyển trạng thái Serial mới sang "Replaced"
            - Ghi thẻ kho (StockLedger) và AuditLog;
            :Tạo quyền bảo hành mới (WarrantyCoverage -> Active)
            cho Serial mới kế thừa thời hạn bảo hành còn lại;
            :Cập nhật claim: gắn ReplacementSerialId và ReplacementStockOutId;
            :COMMIT TRANSACTION;
            
            :Bàn giao thiết bị mới thay thế cho khách hàng;
            :Cập nhật Serial mới sang "Sold";
            :Cập nhật Serial cũ sang "Replaced" (hoặc ReturnedToManufacturer);
            :Cập nhật claim thành "Closed";
            stop
          endif
        endif
      endif
    endif
  endif
endif
@enduml
