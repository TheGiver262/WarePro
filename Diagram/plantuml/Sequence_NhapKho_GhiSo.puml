@startuml Sequence_NhapKho_GhiSo
title Stock-in posting sequence
actor Storekeeper
participant UI
participant VM
participant Authz
participant StockInService
participant Posting
participant Uow
database DB
Storekeeper -> UI : enter_stock_in
UI -> VM : Save_Post_Command
VM -> Authz : CanPerform_PostStockIn
Authz --> VM : OK
VM -> StockInService : SaveDraft
StockInService -> DB : upsert_StockIn_and_lines
VM -> StockInService : Post
StockInService -> DB : load_document
StockInService -> StockInService : validate_status_serials
StockInService -> Posting : PostStockIn
Posting -> Uow : apply_entries
Uow -> DB : update_balance_serial_ledger_audit
Uow -> DB : mark_document_posted
StockInService --> VM : success
VM --> UI : refresh
@enduml
