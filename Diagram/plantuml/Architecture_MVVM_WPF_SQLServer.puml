@startuml Architecture_MVVM_WPF_SQLServer
title Real architecture WPF MVVM EFCore SQLServer
package Presentation_WPF {
  [Views_XAML] as Views
  [ViewModels_MVVM] as VMs
  [Themes_Converters] as UIInfra
}
package Application_Services {
  [AuthenticationService] as Auth
  [AuthorizationService] as Authz
  [CatalogServices] as Catalog
  [StockServices] as StockServices
  [InvoiceService] as Invoice
  [WarrantyClaimService] as Warranty
  [ReportTraceService_DashboardService] as Report
  [AuditLogService] as AuditSvc
  [DataImportServices] as ImportSvc
}
package Inventory_Domain {
  [InventoryPostingService] as Posting
  [InventoryAdjustmentService] as AdjustmentPosting
  [StockDocumentLifecycleService] as Lifecycle
  [EfInventoryUnitOfWork] as Uow
}
package Data_Model {
  [Product_ProductSerial_StockBalance] as CoreEntities
  [StockDocuments] as StockDocs
  [Invoices] as InvoiceEntities
  [WarrantyCoverage_Claim] as WarrantyEntities
  [AuditLog_StockLedger] as TraceEntities
}
package Infrastructure {
  [AppDbContext_EFCore8] as Db
  [ClosedXML_CSV] as FileLib
  database SQLServer as Sql
}
Views --> VMs
Views --> UIInfra
VMs --> Auth
VMs --> Authz
VMs --> Catalog
VMs --> StockServices
VMs --> Invoice
VMs --> Warranty
VMs --> Report
VMs --> AuditSvc
VMs --> ImportSvc
StockServices --> Posting
StockServices --> AdjustmentPosting
StockServices --> Lifecycle
Warranty --> Posting
ImportSvc --> Posting
Posting --> Uow
AdjustmentPosting --> Uow
Uow --> Db
Catalog --> Db
Invoice --> Db
Warranty --> Db
Report --> Db
AuditSvc --> Db
ImportSvc --> Db
Db --> CoreEntities
Db --> StockDocs
Db --> InvoiceEntities
Db --> WarrantyEntities
Db --> TraceEntities
Db --> Sql
ImportSvc --> FileLib
@enduml
