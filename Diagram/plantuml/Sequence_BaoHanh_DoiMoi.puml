@startuml Sequence_BaoHanh_DoiMoi
title Warranty and replacement sequence
actor Technician
participant UI
participant VM
participant WarrantyClaimService
participant Posting
database DB
Technician -> UI : enter_serial_claim_problem
UI -> VM : CreateWarrantyCommand
VM -> WarrantyClaimService : CreateClaim
WarrantyClaimService -> DB : find_serial_and_active_coverage
WarrantyClaimService -> DB : check_open_claim
alt invalid
  WarrantyClaimService --> VM : error
  VM --> UI : show_error
else valid
  WarrantyClaimService -> DB : insert_WarrantyClaim
  WarrantyClaimService -> DB : update_ProductSerial_InWarrantyProcess
  WarrantyClaimService -> DB : insert_AuditLog
  WarrantyClaimService --> VM : claimId
end
alt repaired
  VM -> WarrantyClaimService : CompleteRepair
  WarrantyClaimService -> DB : close_claim_and_restore_serial
else replace_from_stock
  VM -> WarrantyClaimService : ReplaceSerial
  WarrantyClaimService -> DB : create_StockOut_WarrantyReplacement
  WarrantyClaimService -> Posting : PostStockOut
  Posting -> DB : update_balance_ledger_audit
  WarrantyClaimService -> DB : close_old_coverage_create_new_coverage
else manufacturer_replaced
  VM -> WarrantyClaimService : ReceiveFromManufacturerReplaced
  WarrantyClaimService -> DB : create_StockIn_new_serial
  WarrantyClaimService -> Posting : PostStockIn
  WarrantyClaimService -> DB : create_StockOut_to_customer
  WarrantyClaimService -> Posting : PostStockOut
  WarrantyClaimService -> DB : close_claim_and_update_coverages
end
WarrantyClaimService --> VM : refresh
VM --> UI : show_result
@enduml
