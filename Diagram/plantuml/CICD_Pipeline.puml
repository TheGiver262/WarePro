@startuml CICD_Pipeline
title Sơ đồ Quy trình tự động hóa CI/CD (CI/CD Pipeline Diagram)

start
:Developer thực hiện git push code mới lên nhánh chính (main/master);
fork
  :GitHub Actions Workflow được kích hoạt;
  :Khởi tạo môi trường ảo (runner: windows-latest);
end fork

partition "Phase 1: Restore & Build" {
  :Khởi tạo .NET SDK 8.0;
  :Restore các gói NuGet dependencies;
  note right: rtk dotnet restore
  :Build dự án WPF ở cấu hình Release;
  note right: rtk dotnet build --configuration Release
  if (Build thành công?) then (Không)
    :Thông báo lỗi Build lên Slack/Discord/Email;
    stop
  else (Có)
  endif
}

partition "Phase 2: Automated Testing" {
  :Chạy toàn bộ Unit Tests & Integration Tests;
  note right: rtk dotnet test
  if (Tất cả test case Pass?) then (Không)
    :Thông báo lỗi Test thất bại (Test Failures Alert);
    stop
  else (Có)
  endif
}

partition "Phase 3: Code Quality & Security Scan" {
  :Chạy SonarCloud phân tích chất lượng mã nguồn;
  :Quét thư viện dependencies tìm lỗ hổng bảo mật (NuGet Scan);
}

partition "Phase 4: Packaging & Code Signing" {
  :Tạo gói cài đặt Windows App Package (MSIX / Setup.exe);
  :Ký số ứng dụng (Code Signing) bằng chứng chỉ doanh nghiệp (PFX Certificate);
}

partition "Phase 5: Release & Deployment" {
  :Upload bộ cài lên GitHub Releases / AWS S3;
  :Cập nhật file ClickOnce manifest (.application);
  :Gửi thông báo có phiên bản mới lên kênh thông báo kỹ thuật;
}

:Kết thúc quy trình CI/CD thành công;
stop
@enduml
