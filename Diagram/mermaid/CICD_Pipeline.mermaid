flowchart TD
    Start([Git Push / Commit Code]) --> Trigger[Kích hoạt GitHub Actions Runner]
    Trigger --> SetupEnv[Khởi tạo Runner Windows-Latest<br/>Setup .NET 8.0 SDK]
    
    %% Phase 1
    subgraph Phase1["Phase 1: Restore & Build"]
        Restore["NuGet Restore packages"]
        Build["Build Release: dotnet build -c Release"]
        Restore --> Build
    end
    SetupEnv --> Phase1
    
    Build --> CheckBuild{Build thành công?}
    CheckBuild -- Không --> AlertBuild[Gửi cảnh báo lỗi Build qua Slack/Email] --> EndFail([Kết thúc thất bại])
    
    %% Phase 2
    subgraph Phase2["Phase 2: Automated Testing"]
        Test["Chạy Test Suite: dotnet test"]
    end
    CheckBuild -- Có --> Phase2
    
    Phase2 --> CheckTest{Tất cả Test Cases Pass?}
    CheckTest -- Không --> AlertTest[Cảnh báo Test Failures] --> EndFail
    
    %% Phase 3
    subgraph Phase3["Phase 3: Quality & Security Scan"]
        Sonar["SonarCloud Code Quality Scan"]
        Vuln["NuGet Dependency Security Check"]
        Sonar & Vuln
    end
    CheckTest -- Có --> Phase3
    
    %% Phase 4
    subgraph Phase4["Phase 4: Packaging & Signing"]
        Pack["Đóng gói MSIX / Setup Installer"]
        Sign["Ký số Code Signing Certificate"]
        Pack --> Sign
    end
    Phase3 --> Phase4
    
    %% Phase 5
    subgraph Phase5["Phase 5: Release & Deploy"]
        Upload["Upload artifact lên GitHub Releases / AWS S3"]
        Manifest["Cập nhật ClickOnce Manifest (.application)"]
        Notify["Thông báo phát hành phiên bản mới"]
        Upload --> Manifest --> Notify
    end
    Phase4 --> Phase5
    
    Notify --> EndSuccess([CI/CD hoàn tất thành công])
    
    style Phase1 fill:#e6f3ff,stroke:#0066cc,stroke-width:1px
    style Phase2 fill:#fff0f5,stroke:#ff0077,stroke-width:1px
    style Phase3 fill:#fff9e6,stroke:#cc9900,stroke-width:1px
    style Phase4 fill:#f2f9f2,stroke:#00aa22,stroke-width:1px
    style Phase5 fill:#f5f5f5,stroke:#999,stroke-width:1px
    style EndFail fill:#fee2e2,stroke:#ef4444
    style EndSuccess fill:#dcfce7,stroke:#22c55e
