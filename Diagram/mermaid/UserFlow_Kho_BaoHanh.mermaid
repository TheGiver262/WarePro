flowchart TD
    Start([Bắt đầu]) --> LoginScreen[Màn hình Đăng nhập<br/>LoginScreen]
    
    LoginScreen --> CheckLogin{Đăng nhập<br/>thành công?}
    CheckLogin -- Không --> ShowError[Hiển thị thông báo lỗi<br/>mật khẩu/tài khoản] --> LoginScreen
    CheckLogin -- Có --> MainScreen[Màn hình chính & Menu<br/>MainDashboardScreen]
    
    MainScreen --> ChooseRole{Vai trò người dùng?}
    
    %% Nhánh Thủ kho
    ChooseRole -- Thủ kho --> ClickInventory[Click Menu 'Quản lý Kho']
    ClickInventory --> StockInList[Màn hình Danh sách Phiếu nhập<br/>StockInListScreen]
    StockInList --> ClickCreateStockIn[Click nút 'Lập phiếu nhập']
    ClickCreateStockIn --> StockInDetail[Màn hình Chi tiết Phiếu nhập<br/>StockInDetailScreen]
    
    StockInDetail --> InputHeader[Chọn Nhà cung cấp & Kho hàng]
    InputHeader --> InputLines[Thêm sản phẩm, số lượng, đơn giá]
    InputLines --> CheckSerialTracked{Sản phẩm quản lý<br/>theo Serial?}
    
    CheckSerialTracked -- Có --> OpenSerialPopup[Mở Pop-up Quét/Nhập Serial<br/>SerialInputPopup]
    OpenSerialPopup --> InputSerials[Nhập/quét danh sách mã Serial]
    InputSerials --> ConfirmSerial[Bấm 'Xác nhận Serial'] --> SaveDraftStockIn
    CheckSerialTracked -- Không --> SaveDraftStockIn[Bấm 'Lưu nháp']
    
    SaveDraftStockIn --> DraftState[Phiếu ở trạng thái Draft]
    DraftState --> ClickPost[Bấm nút 'Ghi sổ']
    
    ClickPost --> ValidateStockIn{Hệ thống kiểm tra<br/>lỗi dữ liệu / trùng serial?}
    ValidateStockIn -- Có lỗi --> ShowPostError[Hiển thị Pop-up thông báo lỗi] --> StockInDetail
    ValidateStockIn -- Không lỗi --> PostSuccess[Hiển thị thông báo 'Ghi sổ thành công'<br/>Phiếu chuyển sang Posted]
    PostSuccess --> StockInList
    
    %% Nhánh Nhân viên bảo hành
    ChooseRole -- Nhân viên Bảo hành --> ClickWarranty[Click Menu 'Quản lý Bảo hành']
    ClickWarranty --> WarrantyList[Màn hình Danh sách Claim<br/>WarrantyClaimListScreen]
    WarrantyList --> ClickCreateClaim[Click nút 'Tiếp nhận bảo hành']
    ClickCreateClaim --> WarrantyCreate[Màn hình Tạo hồ sơ bảo hành<br/>WarrantyClaimCreateScreen]
    
    WarrantyCreate --> ScanSerial[Nhập/quét số Serial thiết bị lỗi]
    ScanSerial --> CheckEligibility{Hệ thống kiểm tra<br/>quyền bảo hành?}
    
    CheckEligibility -- Không hợp lệ --> ShowEligError[Hiển thị cảnh báo: Không đủ điều kiện]
    ShowEligError --> CancelClaim[Bấm 'Hủy tiếp nhận'] --> WarrantyList
    
    CheckEligibility -- Hợp lệ --> AutoFill[Tự động hiển thị Khách hàng & Sản phẩm]
    AutoFill --> InputProblem[Nhập mô tả lỗi của khách hàng]
    InputProblem --> ClickSubmitClaim[Bấm nút 'Tạo hồ sơ']
    
    ClickSubmitClaim --> ClaimDetail[Màn hình Chi tiết Hồ sơ bảo hành<br/>WarrantyClaimDetailScreen]
    ClaimDetail --> TechInput[Kỹ thuật viên nhập 'Kết luận kỹ thuật']
    TechInput --> ChooseReplace[Chọn phương án 'Đổi mới thiết bị']
    
    ChooseReplace --> OpenReplacePopup[Mở Pop-up Chọn sản phẩm thay thế<br/>ReplacementProductPopup]
    OpenReplacePopup --> SelectNewSerial[Chọn Serial máy mới từ danh sách tồn kho]
    SelectNewSerial --> ClickConfirmReplace[Bấm 'Xác nhận đổi mới']
    
    ClickConfirmReplace --> ValidateReplace{Hệ thống kiểm tra<br/>tồn kho thay thế?}
    ValidateReplace -- Thiếu hàng --> ShowReplaceError[Hiển thị lỗi: Thiếu hàng thay thế<br/>Hồ sơ đổi sang Chờ hàng thay thế] --> ClaimDetail
    ValidateReplace -- Đủ hàng --> ReplaceSuccess[Hiển thị thông báo 'Đổi mới thành công'<br/>In Phiếu đổi trả bảo hành]
    ReplaceSuccess --> DeliverNew[Bàn giao máy mới cho khách<br/>Đóng hồ sơ Closed] --> WarrantyList
