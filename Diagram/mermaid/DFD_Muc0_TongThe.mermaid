flowchart LR
    %% Định nghĩa các node thực thể ngoài và hệ thống
    Customer([Khách hàng])
    Supplier([Nhà cung cấp])
    Manufacturer([Hãng sản xuất])
    User([Người dùng<br/>Admin/Nhân viên])
    
    System((Hệ thống Quản lý<br/>Hàng hóa & Bảo hành<br/><b>WarePro</b>))
    
    %% Thiết lập style nổi bật cho hệ thống
    style System fill:#d4ebf2,stroke:#0088cc,stroke-width:2px
    style Customer fill:#fff,stroke:#333,stroke-width:1px
    style Supplier fill:#fff,stroke:#333,stroke-width:1px
    style Manufacturer fill:#fff,stroke:#333,stroke-width:1px
    style User fill:#fff,stroke:#333,stroke-width:1px
    
    %% Luồng dữ liệu Khách hàng
    Customer -->|Yêu cầu mua hàng<br/>Thiết bị lỗi cần bảo hành| System
    System -->|Hóa đơn bán lẻ SalesInvoice<br/>Máy bảo hành trả khách Sửa/Đổi| Customer
    
    %% Luồng dữ liệu Nhà cung cấp
    Supplier -->|Giao hàng & Thông tin sản phẩm<br/>Hóa đơn mua PurchaseInvoice| System
    System -->|Yêu cầu mua/Trả lại hàng lỗi| Supplier
    
    %% Luồng dữ liệu Hãng sản xuất
    System -->|Thiết bị lỗi cần hãng xử lý<br/>Yêu cầu claim bảo hành| Manufacturer
    Manufacturer -->|Kết quả bảo hành của hãng<br/>Trả lại thiết bị Sửa/Đổi mới| Manufacturer
    Manufacturer -->|Nhận máy đã sửa / đổi mới| System
    
    %% Luồng dữ liệu Người dùng
    User -->|Thông tin đăng nhập<br/>Lệnh kho, hóa đơn, điều chỉnh<br/>Yêu cầu xuất báo cáo| System
    System -->|Kết quả thao tác Thành công/Lỗi<br/>Dữ liệu tồn kho & Thẻ kho<br/>Báo cáo thống kê & Audit Log| User
