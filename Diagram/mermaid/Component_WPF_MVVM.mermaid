flowchart TD
    subgraph WPF[WPF Client]
        MainWindow[MainWindow]
        Views[Views XAML]
        VMs[ViewModels / RelayCommand]
        Styles[Themes + Converters]
        MainWindow --> Views
        Views --> VMs
        Views --> Styles
    end
    subgraph Services[Application Services]
        Auth[AuthenticationService]
        Authz[AuthorizationService]
        Catalog[Catalog services]
        Stock[StockIn/Out/Transfer/Adjustment/Count]
        Invoice[InvoiceService]
        Warranty[WarrantyClaimService / WarrantyService]
        Trace[ReportTraceService / DashboardService]
        Audit[AuditLogService]
        Import[OpeningBalanceImport / DynamicImport]
    end
    subgraph Core[Inventory Core]
        Posting[InventoryPostingService]
        Adjust[InventoryAdjustmentService]
        Uow[EfInventoryUnitOfWork]
    end
    Db[AppDbContext]
    Sql[(SQL Server)]
    File[Excel/CSV via ClosedXML]
    VMs --> Auth
    VMs --> Authz
    VMs --> Catalog
    VMs --> Stock
    VMs --> Invoice
    VMs --> Warranty
    VMs --> Trace
    VMs --> Audit
    VMs --> Import
    Stock --> Posting
    Stock --> Adjust
    Warranty --> Posting
    Import --> Posting
    Posting --> Uow --> Db --> Sql
    Adjust --> Uow
    Catalog --> Db
    Invoice --> Db
    Trace --> Db
    Audit --> Db
    Import --> File
