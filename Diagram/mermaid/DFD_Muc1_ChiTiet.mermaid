flowchart TB
    User([Nguoi dung])
    Customer([Khach hang])
    Supplier([Nha cung cap])

    subgraph Processes["Tien trinh he thong"]
        P1((1.0 Quan tri tai khoan va phan quyen))
        P2((2.0 Quan ly danh muc))
        P3((3.0 Nhap xuat va dieu chinh kho))
        P4((4.0 Hoa don mua ban))
        P5((5.0 Bao hanh va doi moi))
        P6((6.0 Bao cao va truy vet san pham))
    end

    subgraph DataStores["Kho du lieu SQL Server"]
        D1[(D1 AppUser, Permission, AuditLog)]
        D2[(D2 Product, Category, Brand, Unit, Warehouse)]
        D3[(D3 ProductSerial)]
        D4[(D4 StockBalance, StockLedger)]
        D5[(D5 StockIn, StockOut, Transfer, Adjustment, Count)]
        D6[(D6 PurchaseInvoice, SalesInvoice)]
        D7[(D7 WarrantyCoverage, WarrantyClaim)]
    end

    User -->|Dang nhap, doi mat khau| P1
    P1 <--> D1
    P1 -->|Quyen theo man hinh| User

    User -->|Them sua danh muc| P2
    P2 <--> D2
    P2 -->|Danh sach san pham, kho, doi tac| User

    Supplier -->|Giao hang va hoa don mua| P3
    User -->|Lap phieu nhap, xuat, chuyen, kiem ke| P3
    P3 -->|Doc danh muc| D2
    P3 -->|Tao/cap nhat serial| D3
    P3 -->|Luu chung tu kho| D5
    P3 -->|Ghi so ton kho| D4
    P3 -->|Ket qua ghi so| User

    User -->|Lap hoa don mua ban| P4
    Customer -->|Thong tin mua hang| P4
    Supplier -->|Thong tin nha cung cap| P4
    P4 -->|Tham chieu chung tu kho| D5
    P4 -->|Doc serial/san pham| D3
    P4 -->|Luu hoa don| D6
    P4 -->|Hoa don va cong no| User

    Customer -->|Yeu cau bao hanh| P5
    User -->|Tiep nhan, sua, doi moi| P5
    P5 -->|Doi chieu serial| D3
    P5 -->|Doi chieu hoa don ban| D6
    P5 -->|Luu bao hanh| D7
    P5 -->|Neu doi moi thi yeu cau xuat kho| P3
    P5 -->|Trang thai bao hanh| Customer
    P5 -->|Ket qua xu ly| User

    User -->|Loc theo san pham, serial, ngay, doi tac, chung tu| P6
    P6 -->|Doc danh muc| D2
    P6 -->|Doc serial| D3
    P6 -->|Doc ledger va ton kho| D4
    P6 -->|Doc chung tu kho| D5
    P6 -->|Doc hoa don| D6
    P6 -->|Doc bao hanh| D7
    P6 -->|Bao cao ton kho, mua ban, lich su serial, luong nhap xuat| User
