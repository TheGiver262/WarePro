{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "YOUR_API_KEY"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        },
        "headroom": {
            "command": "C:\\Users\\player\\AppData\\Local\\Python\\pythoncore-3.14-64\\Scripts\\headroom.exe",
            "args": [
                "mcp",
                "serve"
            ]
        }
    }
}

