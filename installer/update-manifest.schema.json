{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warepro.local/schemas/update-manifest.schema.json",
  "title": "WarePro stable update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "minimumClientVersion",
    "minimumSchemaVersion",
    "maximumSchemaVersion",
    "installerAssetName",
    "installerSize",
    "sha256",
    "mandatory",
    "backupRequired",
    "publishedAtUtc",
    "releaseNotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "minimumClientVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "minimumSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "maximumSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "installerAssetName": {
      "const": "WarePro-Setup.exe"
    },
    "installerSize": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mandatory": {
      "type": "boolean"
    },
    "backupRequired": {
      "type": "boolean"
    },
    "publishedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "releaseNotes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  }
}
